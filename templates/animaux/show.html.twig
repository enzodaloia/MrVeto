{# Modal : Modifier la fiche animal #}
<div class="modal fade" id="editAnimalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h2 class="h5 fw-bold mb-0">Modifier la fiche de {{ animal.nom }}</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body p-4 pt-3">
                <form method="POST" action="{{ path('app_animaux_animal_edit', {'slug': animal.slug}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('edit_animal_' ~ animal.id) }}">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Espèce</label>
                            <input type="text" name="espece" class="form-control" value="{{ animal.espece|default('') }}" placeholder="Chat, Chien, Lapin…">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Race</label>
                            <input type="text" name="race" class="form-control" value="{{ animal.race|default('') }}" placeholder="Labrador, Persan…">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Âge</label>
                            <input type="text" name="age" class="form-control" value="{{ animal.age|default('') }}" placeholder="3 ans, 6 mois…">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Poids (kg)</label>
                            <input type="number" step="0.01" min="0" name="poids" class="form-control" value="{{ animal.poids|default('') }}" placeholder="4.5">
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button class="btn btn-primary rounded-pill px-4" type="submit">Enregistrer</button>
                        <button class="btn btn-light rounded-pill px-4" type="button" data-bs-dismiss="modal">Annuler</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    // ── Recherche + filtres historique ─────────────────────────────
    const searchInput  = document.getElementById('rdv-search');
    const filterVet    = document.getElementById('rdv-filter-vet');
    const filterYear   = document.getElementById('rdv-filter-year');
    const resetBtn     = document.getElementById('rdv-filter-reset');
    const noResult     = document.getElementById('rdv-no-result');
    const paginationEl = document.getElementById('rdv-pagination');
    const countLabel   = document.getElementById('rdv-count-label');
    const allItems     = Array.from(document.querySelectorAll('.rdv-item'));

    let visibleItems = [...allItems];

    function applyFilters() {
        const q    = searchInput  ? searchInput.value.trim().toLowerCase()  : '';
        const vet  = filterVet  ? filterVet.dataset.selected  : '';
        const year = filterYear ? filterYear.dataset.selected : '';

        visibleItems = allItems.filter(item => {
            const matchQ    = !q    || item.dataset.search.includes(q);
            const matchVet  = !vet  || item.dataset.vetId  === vet;
            const matchYear = !year || item.dataset.year   === year;
            return matchQ && matchVet && matchYear;
        });

        const hasFilter = q || vet || year;
        if (resetBtn) resetBtn.classList.toggle('d-none', !hasFilter);
        if (noResult) noResult.classList.toggle('d-none', visibleItems.length > 0);

        currentPage = 0;
        renderPage(0);
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);

    // ── Dropdown vétérinaire ──────────────────────────────────────
    document.querySelectorAll('.rdv-vet-opt').forEach(btn => {
        btn.addEventListener('click', () => {
            if (!filterVet) return;
            filterVet.dataset.selected = btn.dataset.value;
            document.getElementById('rdv-vet-label').textContent = btn.dataset.label;
            document.querySelectorAll('.rdv-vet-check').forEach(i => i.style.opacity = '0');
            btn.querySelector('.rdv-vet-check').style.opacity = '1';
            bootstrap.Dropdown.getOrCreateInstance(filterVet).hide();
            applyFilters();
        });
    });

    // ── Dropdown année ────────────────────────────────────────────
    document.querySelectorAll('.rdv-year-opt').forEach(btn => {
        btn.addEventListener('click', () => {
            if (!filterYear) return;
            filterYear.dataset.selected = btn.dataset.value;
            document.getElementById('rdv-year-label').textContent = btn.dataset.label;
            document.querySelectorAll('.rdv-year-check').forEach(i => i.style.opacity = '0');
            btn.querySelector('.rdv-year-check').style.opacity = '1';
            bootstrap.Dropdown.getOrCreateInstance(filterYear).hide();
            applyFilters();
        });
    });

    if (resetBtn) {
        resetBtn.addEventListener('click', () => {
            if (searchInput) searchInput.value = '';
            if (filterVet) {
                filterVet.dataset.selected = '';
                document.getElementById('rdv-vet-label').textContent = 'Tous les vétérinaires';
                document.querySelectorAll('.rdv-vet-check').forEach((i, idx) => i.style.opacity = idx === 0 ? '1' : '0');
            }
            if (filterYear) {
                filterYear.dataset.selected = '';
                document.getElementById('rdv-year-label').textContent = 'Toutes années';
                document.querySelectorAll('.rdv-year-check').forEach((i, idx) => i.style.opacity = idx === 0 ? '1' : '0');
            }
            applyFilters();
        });
    }

    // ── Pagination (5 par page) ────────────────────────────────────
    const PER_PAGE = 5;
    let currentPage = 0;

    function renderPage(page) {
        currentPage = page;

        // Masquer tous les items, puis afficher la page courante
        allItems.forEach(item => item.style.display = 'none');
        const start = page * PER_PAGE;
        visibleItems.slice(start, start + PER_PAGE).forEach(item => item.style.display = '');

        const total = visibleItems.length;
        const totalPages = Math.ceil(total / PER_PAGE);

        if (countLabel) {
            const from = total > 0 ? start + 1 : 0;
            const to   = Math.min(start + PER_PAGE, total);
            countLabel.textContent = total > 0
                ? `${from}–${to} sur ${total} consultation${total > 1 ? 's' : ''}`
                : '0 consultation';
        }

        if (!paginationEl) return;
        paginationEl.innerHTML = '';

        if (totalPages <= 1) {
            document.getElementById('rdv-pagination-footer')?.classList.add('d-none');
            return;
        }
        document.getElementById('rdv-pagination-footer')?.classList.remove('d-none');

        // Précédent
        const prev = document.createElement('li');
        prev.className = 'page-item' + (page === 0 ? ' disabled' : '');
        prev.innerHTML = '<button class="page-link rounded-3 border-0 bg-transparent" aria-label="Précédent"><i class="bi bi-chevron-left"></i></button>';
        if (page > 0) prev.querySelector('button').addEventListener('click', () => renderPage(page - 1));
        paginationEl.appendChild(prev);

        for (let p = 0; p < totalPages; p++) {
            const li  = document.createElement('li');
            li.className = 'page-item' + (p === page ? ' active' : '');
            const btn = document.createElement('button');
            btn.className = 'page-link rounded-3 border-0' + (p === page ? ' bg-primary text-white' : ' bg-transparent text-muted');
            btn.textContent = p + 1;
            btn.addEventListener('click', () => renderPage(p));
            li.appendChild(btn);
            paginationEl.appendChild(li);
        }

        // Suivant
        const next = document.createElement('li');
        next.className = 'page-item' + (page === totalPages - 1 ? ' disabled' : '');
        next.innerHTML = '<button class="page-link rounded-3 border-0 bg-transparent" aria-label="Suivant"><i class="bi bi-chevron-right"></i></button>';
        if (page < totalPages - 1) next.querySelector('button').addEventListener('click', () => renderPage(page + 1));
        paginationEl.appendChild(next);
    }

    renderPage(0);
})();
</script>
