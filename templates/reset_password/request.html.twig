{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
<div class="bg-secondary-bg d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="container">
        <div class="mx-auto w-100" style="max-width: 800px;">

            {% for flash_error in app.flashes('reset_password_error') %}
                <div class="alert alert-danger text-center">
                    {{ flash_error }}
                </div>
            {% endfor %}

            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary mb-3">
                    Réinitialiser le mot de passe
                </h2>

                <div class="mb-3">
                    <i class="bi bi-lock fs-1 text-primary"></i>
                </div>

                <p class="text-neutral-70">
                    Entrez votre adresse email pour réinitialiser votre mot de passe
                </p>
            </div>

            {{ form_start(requestForm, {'attr': {'class': 'mt-4'}}) }}

                <div class="mb-4">
                    {{ form_label(requestForm.email, 'Adresse email', {
                        'label_attr': {'class': 'form-label text-neutral-80'}
                    }) }}

                    {{ form_widget(requestForm.email, {
                        'attr': {
                            'class': 'form-control form-control-lg',
                            'placeholder': 'john.doe@gmail.com'
                        }
                    }) }}

                    {{ form_errors(requestForm.email) }}
                </div>

                <div class="d-grid mb-3">
                    <button class="btn btn-primary btn-lg rounded-pill">
                        Envoyer
                    </button>
                </div>

            {{ form_end(requestForm) }}

            <div class="text-center mt-3">
                <a href="{{ path('app_login') }}" class="text-warning text-decoration-none">
                    Retour à la connexion
                </a>
            </div>

            <div class="text-center mt-4">
                <small class="text-neutral-60">
                    Nouveau sur Mr Veto ?
                    Créer un compte
                    <a href="{{ path('app_register', {'type': 'utilisateur'}) }}">personnel</a>
                    ou
                    <a href="{{ path('app_register', {'type': 'veterinaire'}) }}">professionnel</a>
                </small>
            </div>

        </div>
    </div>
</div>
{% endblock %}
