{% extends 'base.html.twig' %}

{% block title %}MrVeto - Trouver un vétérinaire
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
{% endblock %}

{% block body %}
    <html lang="fr">
    {# Main Container #}
    <div
        class="container-xxl min-vh-100 d-flex flex-column gap-4 py-4">

        {# Sticky Search Bar #}
        <div
            class="sticky-top pt-2 pb-3" style="top: 0; z-index: 1030;">
            {# Increased z-index to ensure dropdown is above content #}
            <div class="d-flex justify-content-center">
                <form action="{{ path('app_search_vet') }}" method="get" class="bg-secondary-bg p-2 ps-4 pe-2 rounded-pill shadow d-flex align-items-center gap-3 w-100" style="max-width: 900px;" data-controller="autocomplete-address" data-action="submit->autocomplete-address#onSubmit">

                    <input type="hidden" name="lat" data-autocomplete-address-target="lat" value="{{ lat }}">
                    <input
                        type="hidden" name="lon" data-autocomplete-address-target="lon" value="{{ lon }}">

                    {# Location Input #}
                    <div class="d-flex align-items-center flex-grow-1 bg-white rounded-pill px-3 py-2 shadow-sm position-relative">
                        <twig:ux:icon class="text-secondary fs-5 me-2" name="lucide:map-pin"/>
                        <input
                            type="text" name="location" placeholder="Ville ou Code postal" aria-label="Ville ou code postal" value="{{ location }}" class="form-control bg-transparent border-0 text-dark shadow-none p-0 focus-ring-none" style="outline: none;" data-autocomplete-address-target="input" data-action="input->autocomplete-address#search" autocomplete="off">
                        {# Autocomplete Results Container #}
                        <div data-autocomplete-address-target="results" class="position-absolute start-0 end-0 top-100 z-3"></div>
                    </div>

                    {# Distance Dropdown (Custom Design) #}
                    <div class="d-none d-md-block position-relative">
                        <div class="dropdown">
                            <button class="btn bg-white rounded-pill px-3 py-2 d-flex align-items-center justify-content-between gap-2 shadow-sm border-0 dropdown-toggle remove-caret limit-dropdown-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-display="static" style="min-width: 11rem;">
                                <div class="d-flex align-items-center gap-2">
                                    <twig:ux:icon class="text-secondary fs-5" name="lucide:radar"/>
                                    <div
                                        class="position-relative d-inline-block">
                                        <!-- Invisible spacer to force width to the maximum possible value "100 km" -->
                                        <span class="fw-medium text-dark invisible" aria-hidden="true">100 km</span>
                                        <!-- Actual absolute positioned label that updates -->
                                        <span class="text-dark fw-medium text-truncate position-absolute start-0 top-0 w-100" id="distanceLabel">{{ distance }}
											km</span>
                                    </div>
                                </div>
                                <twig:ux:icon class="text-muted fs-5" name="lucide:chevron-down"/>
                            </button>
                            <ul class="dropdown-menu border-0 shadow-sm rounded-bottom-4 mt-0 p-0 w-100 limit-dropdown-menu">
                                <li>
                                    <a class="dropdown-item limit-dropdown-item py-2 fw-medium" href="#" onclick="updateDistance('5', '5 km', event)">5 km</a>
                                </li>
                                <li>
                                    <a class="dropdown-item limit-dropdown-item py-2 fw-medium" href="#" onclick="updateDistance('10', '10 km', event)">10 km</a>
                                </li>
                                <li>
                                    <a class="dropdown-item limit-dropdown-item py-2 fw-medium" href="#" onclick="updateDistance('20', '20 km', event)">20 km</a>
                                </li>
                                <li>
                                    <a class="dropdown-item limit-dropdown-item py-2 fw-medium" href="#" onclick="updateDistance('50', '50 km', event)">50 km</a>
                                </li>
                                <li>
                                    <a class="dropdown-item limit-dropdown-item rounded-bottom-4 py-2 fw-medium" href="#" onclick="updateDistance('100', '100 km', event)">100 km</a>
                                </li>
                            </ul>
                            <input type="hidden" name="distance" id="distanceInput" value="{{ distance }}">
                        </div>
                    </div>

                    {# Submit Button #}
                    <button type="submit" class="btn btn-secondary rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0 shadow shadow-hover text-dark" style="width: 48px; height: 48px;" title="Rechercher">
                        <twig:ux:icon class="fs-5 text-light" name="lucide:search"/>
                    </button>
                </form>
            </div>
        </div>

        {# Content Grid #}
        <div
            class="row g-4 justify-content-center">

            {# Left Column: Filters #}
            <div class="col-lg-3 col-xl-2">
                <div class="sticky-top" style="top: 100px; max-height: calc(100vh - 120px); overflow-y: auto;">
                    <div
                        class="card border-0 shadow-sm p-4 h-100">
                        {# Emergency #}
                        <div class="mb-4">
                            <h4 class="h6 fw-bold mb-3 text-secondary">Urgence</h4>
                            <div class="form-check">
                                <input class="form-check-input border-secondary" type="checkbox" name="emergency" id="emergency">
                                <label class="form-check-label small" for="emergency">Urgences 24/7</label>
                            </div>
                        </div>

                        {# Specialities #}
                        <div class="mb-4">
                            <h4 class="h6 fw-bold mb-3 text-secondary">Spécialités</h4>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check">
                                    <input class="form-check-input border-secondary" type="checkbox" name="spec[]" value="general" id="spec_gen">
                                    <label class="form-check-label small" for="spec_gen">Généraliste</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input border-secondary" type="checkbox" name="spec[]" value="surgery" id="spec_surg">
                                    <label class="form-check-label small" for="spec_surg">Chirurgie</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input border-secondary" type="checkbox" name="spec[]" value="derma" id="spec_derma">
                                    <label class="form-check-label small" for="spec_derma">Dermatologie</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input border-secondary" type="checkbox" name="spec[]" value="nac" id="spec_nac">
                                    <label class="form-check-label small" for="spec_nac">NAC</label>
                                </div>
                            </div>
                        </div>

                        {# Availability #}
                        <div>
                            <h4 class="h6 fw-bold mb-3 text-secondary">Disponibilité</h4>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check">
                                    <input class="form-check-input border-secondary" type="checkbox" name="avail" id="avail_today">
                                    <label class="form-check-label small" for="avail_today">Rendez-vous aujourd'hui</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input border-secondary" type="checkbox" name="video" id="avail_video">
                                    <label class="form-check-label small" for="avail_video">Téléconsultation</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Center Column: Results #}
            <div class="col-lg-6 col-xl-7">
                <div class="d-flex flex-column gap-4">
                    {% for vet in pagination %}
                        <div class="card border-0 shadow-sm p-4 transition-hover cursor-pointer" onclick="window.location.href='{{ path('app_vet_info', {slug: vet.slug}) }}'">
                            <div
                                class="d-flex flex-column flex-sm-row gap-4 align-items-start align-items-sm-center">
                                {# Avatar #}
                                <img
                                    src="https://ui-avatars.com/api/?name={{ vet.prenom }}+{{ vet.nom }}&background=random" alt="Avatar" class="rounded-circle flex-shrink-0 bg-light shadow-sm" style="width: 80px; height: 80px; object-fit: cover;">

                                {# Info #}
                                <div class="flex-grow-1">
                                    {% set availability = vetAvailability[vet.id]|default({'isOpen': false, 'label': 'Ferme', 'detail': 'Aucun horaire renseigne'}) %}
                                    <h3 class="h5 text-primary fw-bold mb-2">Dr.
                                        {{ vet.prenom }}
                                        {{ vet.nom }}</h3>
                                    <div class="d-flex flex-column gap-1 text-muted small">
										<span class="d-flex align-items-center gap-2">
											<twig:ux:icon class="fs-6 text-primary" name="lucide:map-pin"/>
											{{ vet.adressecabinet }}
										</span>
                                        <span class="d-flex align-items-center gap-2">
											<twig:ux:icon class="fs-6 text-primary" name="lucide:clock"/>
											<span class="fw-medium {{ availability.isOpen ? 'text-primary' : 'text-danger' }}">{{ availability.label }}</span>
											<span class="">{{ availability.detail }}</span>
										</span>
                                    </div>
                                </div>

                                {# Actions #}
                                <div class="mt-3 mt-sm-0 ms-sm-auto align-self-sm-center" onclick="event.stopPropagation();">
                                    <a href="{{ path('app_vet_info', {slug: vet.slug}) }}" class="btn btn-primary rounded-pill hover-bg-secondary px-4 py-2 fw-medium shadow-sm custom-hover-lift text-light">
                                        Voir / Prendre RDV
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-info border-0 shadow-sm text-center p-4">
                            <twig:ux:icon class="fs-1 text-primary mb-3" name="lucide:info"/>
                            <p class="mb-0">Aucun vétérinaire trouvé pour cette recherche.</p>
                        </div>
                    {% endfor %}
                    <div class="mt-4 d-flex justify-content-center">
                        {{ knp_pagination_render(pagination) }}
                    </div>
                </div>
            </div>

            {# Right Column: Map #}
            <div class="col-lg-3 d-none d-lg-block">
                <div class="sticky-top" style="top: 100px;">
                    <div class="bg-light rounded-4 d-flex align-items-center justify-content-center text-muted fw-bold shadow-sm position-relative overflow-hidden" style="aspect-ratio: 1/1;">
                        Carte Interactive
                        <button class="btn btn-white position-absolute top-0 end-0 m-2 rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center hover-scale" style="width: 32px; height: 32px;" title="Agrandir la carte">
                            <twig:ux:icon class="fs-5 text-primary" name="lucide:expand"/>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
    </html>

    <script>
        function updateDistance(value, label, event) {
            event.preventDefault();
            document.getElementById('distanceInput').value = value;
            document.getElementById('distanceLabel').textContent = label;
        }
    </script>

    <style>
        /* Limit Dropdown Component Styles */
        .limit-dropdown-btn[aria-expanded="true"] {
            border-radius: 1rem 1rem 0 0 !important;
            border-bottom-color: transparent !important;
        }
        .limit-dropdown-menu {
            margin-top: -1px !important; /* overlap the border */
            border-top-left-radius: 0 !important;
            border-top-right-radius: 0 !important;
            border-top: none !important;
            transition: none !important;
            transform: none !important;
        }
        .limit-dropdown-item:active,
        .limit-dropdown-item:focus {
            background-color: #f8f9fa !important;
            color: #212529 !important;
        }

        /* Minimal Custom Styles for interactions that Bootstrap doesn't fully cover smoothly */
        .transition-hover {
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
        }
        .transition-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1) !important;
        }

        .custom-hover-lift {
            transition: transform 0.2s;
        }
        .custom-hover-lift:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
        }

        .hover-scale {
            transition: transform 0.2s;
        }
        .hover-scale:hover {
            transform: scale(1.1);
        }

        /* Remove Dropdown Caret for cleaner look */
        .remove-caret::after {
            display: none !important;
        }

        /* Smooth Dropdown Animation */
        .dropdown-menu {
            display: block;
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: all 0.2s ease;
            z-index: 1000;
        }
        .dropdown-menu.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .interactive-map {
            z-index: -1;
        }

        .zindex-moins1 {
            z-index: -1;
        }
    </style>
{% endblock %}
