{% extends 'base.html.twig' %}

{% block title %}MrVeto - Trouver un vétérinaire
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
{% endblock %}

{% block body %}
	{# Main Container #}
	<div
		class="container-xxl min-vh-100 d-flex flex-column gap-4 py-4">

		{# Sticky Search Bar #}
		<div
			class="sticky-top pt-2 pb-3" style="top: 0; z-index: 1020;">
			{# Increased z-index to ensure dropdown is above content #}
			<div class="d-flex justify-content-center">
				<form
					action="{{ path('app_search_vet') }}" method="get" class="bg-secondary-bg p-2 ps-4 pe-2 rounded-pill shadow d-flex align-items-center gap-3 w-100" style="max-width: 900px;">

					{# Location Input #}
					<div class="d-flex align-items-center flex-grow-1 bg-white rounded-pill px-3 py-2 shadow-sm">
						<span class="material-icons text-secondary me-2">location_on</span>
						<input type="text" name="location" placeholder="Ville ou Code postal" class="form-control bg-transparent border-0 text-dark shadow-none p-0 focus-ring-none" style="outline: none;">
					</div>

					{# Distance Dropdown (Custom Design) #}
					<div class="d-none d-md-block position-relative">
						<div class="dropdown">
							<button
								class="btn bg-white rounded-pill px-3 py-2 d-flex align-items-center justify-content-between gap-2 shadow-sm border-0 dropdown-toggle remove-caret" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="min-width: 11rem;">
								{# Fixed width to accommodate 'Autour de moi' #}
								<div class="d-flex align-items-center gap-2">
									<span class="material-icons text-secondary">radar</span>
									<span class="text-dark fw-medium text-truncate" id="distanceLabel">Autour de moi</span>
								</div>
								<span class="material-icons text-muted fs-6">expand_more</span>
							</button>
							<ul class="dropdown-menu border-0 shadow-lg rounded-4 mt-2 p-2 w-100 animate slide-in">
								<li>
									<a class="dropdown-item rounded-3 mb-1 py-2 fw-medium d-flex align-items-center gap-2" href="#" onclick="updateDistance('user_loc', 'Autour de moi', event)">
										<span class="material-icons fs-6 text-primary">my_location</span>
										Autour de moi
									</a>
								</li>
								<li><hr class="dropdown-divider my-1"></li>
								<li>
									<a class="dropdown-item rounded-3 mb-1 py-2 fw-medium" href="#" onclick="updateDistance('5', '5 km', event)">5 km</a>
								</li>
								<li>
									<a class="dropdown-item rounded-3 mb-1 py-2 fw-medium" href="#" onclick="updateDistance('10', '10 km', event)">10 km</a>
								</li>
								<li>
									<a class="dropdown-item rounded-3 mb-1 py-2 fw-medium" href="#" onclick="updateDistance('20', '20 km', event)">20 km</a>
								</li>
							</ul>
							<input type="hidden" name="distance" id="distanceInput" value="user_loc">
						</div>
					</div>

					{# Submit Button #}
					<button type="submit" class="btn btn-secondary rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0 shadow shadow-hover text-dark" style="width: 48px; height: 48px;" title="Rechercher">
						<span class="material-icons">search</span>
					</button>
				</form>
			</div>
		</div>

		{# Content Grid #}
		<div
			class="row g-4 justify-content-center">

			{# Left Column: Filters #}
			<div class="col-lg-3 col-xl-2">
				<div class="sticky-top" style="top: 100px; max-height: calc(100vh - 120px); overflow-y: auto;">
					<div
						class="card border-0 shadow-sm p-4 h-100">
						{# Emergency #}
						<div class="mb-4">
							<h4 class="h6 fw-bold mb-3 text-secondary">Urgence</h4>
							<div class="form-check">
								<input class="form-check-input border-secondary" type="checkbox" name="emergency" id="emergency">
								<label class="form-check-label small" for="emergency">Urgences 24/7</label>
							</div>
						</div>

						{# Specialities #}
						<div class="mb-4">
							<h4 class="h6 fw-bold mb-3 text-secondary">Spécialités</h4>
							<div class="d-flex flex-column gap-2">
								<div class="form-check">
									<input class="form-check-input border-secondary" type="checkbox" name="spec[]" value="general" id="spec_gen">
									<label class="form-check-label small" for="spec_gen">Généraliste</label>
								</div>
								<div class="form-check">
									<input class="form-check-input border-secondary" type="checkbox" name="spec[]" value="surgery" id="spec_surg">
									<label class="form-check-label small" for="spec_surg">Chirurgie</label>
								</div>
								<div class="form-check">
									<input class="form-check-input border-secondary" type="checkbox" name="spec[]" value="derma" id="spec_derma">
									<label class="form-check-label small" for="spec_derma">Dermatologie</label>
								</div>
								<div class="form-check">
									<input class="form-check-input border-secondary" type="checkbox" name="spec[]" value="nac" id="spec_nac">
									<label class="form-check-label small" for="spec_nac">NAC</label>
								</div>
							</div>
						</div>

						{# Availability #}
						<div>
							<h4 class="h6 fw-bold mb-3 text-secondary">Disponibilité</h4>
							<div class="d-flex flex-column gap-2">
								<div class="form-check">
									<input class="form-check-input border-secondary" type="checkbox" name="avail" id="avail_today">
									<label class="form-check-label small" for="avail_today">Rendez-vous aujourd'hui</label>
								</div>
								<div class="form-check">
									<input class="form-check-input border-secondary" type="checkbox" name="video" id="avail_video">
									<label class="form-check-label small" for="avail_video">Téléconsultation</label>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			{# Center Column: Results #}
			<div class="col-lg-6 col-xl-7">
				<div class="d-flex flex-column gap-4">
					{% for i in 1..10 %}
						<div class="card border-0 shadow-sm p-4 transition-hover cursor-pointer" onclick="window.location.href='#'">
							<div
								class="d-flex flex-column flex-sm-row gap-4 align-items-start align-items-sm-center">
								{# Avatar #}
								<img
								src="https://ui-avatars.com/api/?name=Dr+Veto+{{ i }}&background=random" alt="Avatar" class="rounded-circle flex-shrink-0 bg-light shadow-sm" style="width: 80px; height: 80px; object-fit: cover;">

								{# Info #}
								<div class="flex-grow-1">
									<h3 class="h5 text-primary fw-bold mb-2">Dr. Exemple Veto
										{{ i }}</h3>
									<div class="d-flex flex-column gap-1 text-muted small">
										<span class="d-flex align-items-center gap-2">
											<i class="material-icons fs-6 text-primary">medical_services</i>
											Clinique Vétérinaire des Lilas
										</span>
										<span class="d-flex align-items-center gap-2">
											<i class="material-icons fs-6 text-primary">place</i>
											12 Rue des Animaux, 75000 Paris
										</span>
										<span class="d-flex align-items-center gap-2">
											<i class="material-icons fs-6 text-primary">schedule</i>
											<span class="text-primary fw-medium">Ouvert</span>
											• Ferme à 19:00
										</span>
									</div>
								</div>

								{# Actions #}
								<div class="mt-3 mt-sm-0 ms-sm-auto align-self-sm-center">
									<a href="#" class="btn btn-primary rounded-pill px-4 py-2 fw-medium shadow-sm custom-hover-lift text-dark">
										Voir / Prendre RDV
									</a>
								</div>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>

			{# Right Column: Map #}
			<div class="col-lg-3 d-none d-lg-block">
				<div class="sticky-top" style="top: 100px;">
					<div class="bg-light rounded-4 d-flex align-items-center justify-content-center text-muted fw-bold shadow-sm position-relative overflow-hidden" style="aspect-ratio: 1/1;">
						Carte Interactive
						<button class="btn btn-white position-absolute top-0 end-0 m-2 rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center hover-scale" style="width: 32px; height: 32px;" title="Agrandir la carte">
							<span class="material-icons fs-6 text-primary">open_in_full</span>
						</button>
					</div>
				</div>
			</div>

		</div>
	</div>

	<script>
		function updateDistance(value, label, event) {
event.preventDefault();
document.getElementById('distanceInput').value = value;
document.getElementById('distanceLabel').textContent = label;
}
	</script>

	<style>
		/* Minimal Custom Styles for interactions that Bootstrap doesn't fully cover smoothly */
		.transition-hover {
			transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
		}
		.transition-hover:hover {
			transform: translateY(-4px);
			box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1) !important;
		}

		.custom-hover-lift {
			transition: transform 0.2s;
		}
		.custom-hover-lift:hover {
			transform: translateY(-2px);
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
		}

		.hover-scale {
			transition: transform 0.2s;
		}
		.hover-scale:hover {
			transform: scale(1.1);
		}

		/* Remove Dropdown Caret for cleaner look */
		.remove-caret::after {
			display: none !important;
		}

		/* Smooth Dropdown Animation */
		.dropdown-menu {
			display: block;
			opacity: 0;
			visibility: hidden;
			transform: translateY(10px);
			transition: all 0.2s ease;
		}
		.dropdown-menu.show {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}
	</style>
{% endblock %}
