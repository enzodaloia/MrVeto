    <!-- Cancel Modal -->
    <div class="modal fade" tabindex="-1" aria-hidden="true" data-rendezvous-target="cancelModal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-body p-4 p-md-5 text-center">
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-danger text-white rounded-circle mb-3" style="width: 80px; height: 80px; background-color: #dc3545 !important;">
                            <i class="bi bi-x-circle" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                    <h4 class="text-info fw-bold text-dark mb-3">Annuler le rendez-vous</h4>
                    <p class="text-info text-muted mb-4">Êtes-vous sûr(e) de vouloir annuler ce rendez-vous ? L'annulation libérera le créneau :</p>
                    
                    <div class="bg-light rounded-3 p-3 mb-4 d-flex justify-content-center gap-4 align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-calendar-event text-primary fs-5"></i>
                            <span class="text-info fw-bold text-dark" data-rendezvous-target="modalDate"></span>
                        </div>
                        <div class="border-start border-2 border-secondary" style="height: 30px; opacity: 0.2;"></div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-clock text-primary fs-5"></i>
                            <span class="text-info fw-bold text-dark" data-rendezvous-target="modalTime"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <button type="button" class="btn btn-info text-white border-0 rounded-3 fw-bold w-50 py-3" data-bs-dismiss="modal">
                            Conserver
                        </button>
                        <button type="button" class="btn btn-danger text-white border-0 rounded-3 fw-bold w-50 py-3" data-action="click->rendezvous#confirmCancel" data-rendezvous-target="confirmCancelBtn">
                            Annuler
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" tabindex="-1" aria-hidden="true" data-rendezvous-target="editModal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-body p-4 p-md-5 text-center">
                    <h3 class="fw-black text-info mb-2" style="font-weight: 800;">Modifier le Rendez-vous</h3>
                    <p class="text-info opacity-75 mb-4">Votre vétérinaire sera notifié de votre demande de modification</p>
                    
                    <div class="d-flex align-items-center justify-content-center gap-4 mb-4 text-start">
                        <div class="rounded-circle overflow-hidden bg-light" style="width: 80px; height: 80px; flex-shrink: 0;">
                            <img src="" data-rendezvous-target="editModalVetImg" class="w-100 h-100 object-fit-cover" alt="Vétérinaire">
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-1" data-rendezvous-target="editModalVetName">Nom Vétérinaire</h5>
                            <p class="text-muted mb-1" style="font-size: 0.9rem;" data-rendezvous-target="editModalVetSubtitle">Vétérinaire</p>
                            <div class="d-flex align-items-center gap-2 mt-2">
                                <span class="text-info text-decoration-none" style="font-size: 0.85rem;" data-rendezvous-target="editModalMotif">Consultation</span>
                                <span class="text-muted">•</span>
                                <span class="badge bg-warning text-white rounded-pill px-2 py-1 fw-bold" style="font-size: 0.75rem;" data-rendezvous-target="editModalBadge">En attente</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-4 mb-5">
                        <div class="position-relative d-flex align-items-center border-bottom border-info pb-1" style="width: 250px;">
                            <i class="bi bi-calendar-event text-info fs-5 me-2"></i>
                            <select class="form-select border-0 bg-transparent text-info fw-bold p-0 shadow-none form-select-sm cursor-pointer" data-rendezvous-target="editModalDateSelect" data-action="change->rendezvous#onEditDateChange">
                                <option value="">Chargement...</option>
                            </select>
                        </div>
                        <div class="position-relative d-flex align-items-center border-bottom border-info pb-1" style="width: 250px;">
                            <i class="bi bi-clock text-info fs-5 me-2"></i>
                            <select class="form-select border-0 bg-transparent text-info fw-bold p-0 shadow-none form-select-sm cursor-pointer" data-rendezvous-target="editModalTimeSelect">
                                <option value="">--:--</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="button" class="btn btn-danger text-white border-0 rounded-3 fw-bold w-50 py-3" data-bs-dismiss="modal">
                            Retour
                        </button>
                        <button type="button" class="btn btn-info text-white border-0 rounded-3 fw-bold w-50 py-3" data-action="click->rendezvous#confirmEdit" data-rendezvous-target="confirmEditBtn">
                            Modifier mon rendez-vous
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
