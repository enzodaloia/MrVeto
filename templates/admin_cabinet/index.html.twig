{% extends 'base.html.twig' %}

{% block title %}Administration des cabinets{% endblock %}

{% block body %}
    <div class="container-fluid py-4 px-4 min-vh-100 admin-cabinet-index">
        <div class="mx-auto" style="max-width: 1200px;">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
                <h1 class="h3 mb-0 text-center text-md-start w-100">Cabinets</h1>
                <a class="btn btn-primary px-4 w-auto mx-auto mx-md-0" style="border-radius: 30px;" href="{{ path('app_admin_cabinet_new') }}">Nouveau cabinet</a>
            </div>
            <div class="bg-white rounded-4 shadow-sm overflow-hidden">
                <div class="table-responsive">
                    <table class="table mb-0 align-middle cabinets-table" style="--bs-table-bg: transparent;">
                        <thead class="border-bottom">
                            <tr class="text-primary fw-bold small">
                                <th class="py-3">Nom</th>
                                <th class="d-none d-md-table-cell py-3">Ville</th>
                                <th class="d-none d-lg-table-cell py-3">Téléphone</th>
                                <th class="d-none d-lg-table-cell py-3">Créé le</th>
                                <th class="text-md-end py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for cabinet in cabinets %}
                            <tr class="border-bottom">
                                <td>
                                    <div class="fw-semibold">{{ cabinet.nom }}</div>
                                    <div class="d-md-none small text-muted">Ville: {{ cabinet.ville ?: '—' }}</div>
                                    <div class="d-lg-none small text-muted">Téléphone: {{ cabinet.telephone ?: '—' }}</div>
                                    <div class="d-lg-none small text-muted">Créé le: {{ cabinet.createdAt ? cabinet.createdAt|date('d/m/Y H:i') : '—' }}</div>
                                </td>
                                <td class="d-none d-md-table-cell">{{ cabinet.ville ?: '—' }}</td>
                                <td class="d-none d-lg-table-cell">{{ cabinet.telephone ?: '—' }}</td>
                                <td class="d-none d-lg-table-cell">{{ cabinet.createdAt ? cabinet.createdAt|date('d/m/Y H:i') : '—' }}</td>
                                <td class="text-md-end">
                                    <div class="d-flex flex-column flex-sm-row justify-content-md-end gap-2">
                                        <a class="btn btn-sm btn-outline-secondary w-100 w-sm-auto" href="{{ path('app_admin_cabinet_show', {'slug': cabinet.slug}) }}">Voir</a>
                                        <a class="btn btn-sm btn-outline-primary w-100 w-sm-auto" href="{{ path('app_admin_cabinet_edit', {'slug': cabinet.slug}) }}">Modifier</a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">Aucun cabinet</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
