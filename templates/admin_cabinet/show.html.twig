{% extends 'base.html.twig' %}

{% block title %}Cabinet {{ cabinet.nom }}{% endblock %}

{% block body %}
<div class="container py-4 admin-cabinet-show">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">{{ cabinet.nom }}</h1>
            <p class="text-muted mb-0">{{ cabinet.adresse ?: 'Adresse non renseignée' }}{% if cabinet.ville %}, {{ cabinet.ville }}{% endif %}</p>
        </div>
        <div class="d-flex flex-column flex-sm-row flex-wrap gap-2 w-100 w-md-auto cabinet-actions">
            <a class="btn btn-outline-primary w-100 w-sm-auto" href="{{ path('app_admin_cabinet_edit', {'id': cabinet.id}) }}">Modifier</a>
            <a class="btn btn-outline-secondary w-100 w-sm-auto" href="{{ path('app_admin_cabinet_index') }}">Retour</a>
            <form class="w-100 w-sm-auto" method="post" action="{{ path('app_admin_cabinet_delete', {'id': cabinet.id}) }}" onsubmit="return confirm('Supprimer ce cabinet ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_cabinet_' ~ cabinet.id) }}">
                <button class="btn btn-danger w-100 w-sm-auto">Supprimer</button>
            </form>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-3"
                 data-controller="user-autocomplete"
                 data-user-autocomplete-search-url-value="{{ path('app_admin_cabinet_user_search', {'id': cabinet.id}) }}">
                <h2 class="h5 mb-2">Ajouter un membre</h2>
                <p class="text-muted small mb-3">
                    Recherchez par email. Aucun résultat n'est affiché tant que vous ne recherchez pas.
                </p>

                <form method="post" action="{{ path('app_admin_cabinet_assign', {'id': cabinet.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_cabinet_assign_' ~ cabinet.id) }}">
                    <input type="hidden" name="user_id" data-user-autocomplete-target="userId">

                    <div class="mb-3 position-relative">
                        <div class="form-floating">
                            <input type="text"
                                   class="form-control ps-4 pe-4"
                                   id="assign_email_query_admin"
                                   placeholder="Rechercher un email"
                                   autocomplete="off"
                                   data-user-autocomplete-target="input"
                                   data-action="input->user-autocomplete#search">
                            <label for="assign_email_query_admin">Recherche email</label>
                        </div>
                        <div data-user-autocomplete-target="results" class="position-absolute start-0 end-0 top-100 z-3"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Rôle dans le cabinet</label>
                        <select class="form-select" name="role_in_cabinet" disabled data-user-autocomplete-target="role">
                            <option value="">Sélectionnez d'abord un utilisateur</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted" data-user-autocomplete-target="selectedLabel">Aucun utilisateur sélectionné.</small>
                    </div>

                    <button class="btn btn-primary" type="submit">Ajouter</button>
                </form>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table mb-0 align-middle assignments-table">
                        <thead>
                            <tr>
                                <th>Utilisateur</th>
                                <th>Rôle cabinet</th>
                                <th class="text-sm-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for assignment in assignments %}
                            <tr>
                                <td>{{ assignment.user.prenom }} {{ assignment.user.nom }} <small class="text-muted d-block d-sm-inline ms-sm-1">({{ assignment.user.email }})</small></td>
                                <td>{{ assignment.roleInCabinet }}</td>
                                <td class="text-sm-end">
                                    {% if not (assignment.user and app.user and assignment.user.id == app.user.id) %}
                                        <form method="post" action="{{ path('app_admin_cabinet_assignment_delete', {'id': assignment.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_assignment_' ~ assignment.id) }}">
                                            <button class="btn btn-sm btn-outline-danger w-100 w-sm-auto">Retirer</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">Aucune affectation</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
