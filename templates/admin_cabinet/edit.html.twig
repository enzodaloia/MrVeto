{% extends 'base.html.twig' %}

{% block title %}Modifier cabinet - MrVeto{% endblock %}

{% block body %}
    <style>
        .cabinet-title {
            display: inline-block;
            max-width: 360px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: bottom;
        }
        .cabinet-user-name {
            display: block;
            max-width: 260px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: bottom;
        }
        .cabinet-user-email {
            display: block;
        }
    </style>
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <span class="cabinet-title" title="Modifier le cabinet">Modifier le cabinet</span>
        </h1>
        <a class="btn btn-primary text-white" href="{{ path('app_admin_cabinet_index') }}">Retour</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                {{ include('admin_cabinet/_form.html.twig', {form: form, button_label: 'Mettre à jour'}) }}
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-3"
                 data-controller="user-autocomplete"
                 data-user-autocomplete-search-url-value="{{ path('app_admin_cabinet_user_search', {'slug': cabinet.slug}) }}">
                <h2 class="h5 mb-2">Ajouter un membre</h2>
                <p class="text-muted small mb-3">
                    Recherchez par email. Aucun résultat n'est affiché tant que vous ne recherchez pas.
                </p>

                <form method="post" action="{{ path('app_admin_cabinet_assign', {'slug': cabinet.slug}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_cabinet_assign_' ~ cabinet.id) }}">
                    <input type="hidden" name="user_id" data-user-autocomplete-target="userId">

                    <div class="mb-3 position-relative">
                        <div class="form-floating">
                            <input type="text"
                                   class="form-control ps-4 pe-4"
                                   id="assign_email_query_admin"
                                   placeholder="Rechercher un email"
                                   autocomplete="off"
                                   data-user-autocomplete-target="input"
                                   data-action="input->user-autocomplete#search">
                            <label for="assign_email_query_admin">Recherche email</label>
                        </div>
                        <div data-user-autocomplete-target="results" class="position-absolute start-0 end-0 top-100 z-3"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Rôle dans le cabinet</label>
                        <select class="form-select" name="role_in_cabinet" disabled data-user-autocomplete-target="role">
                            <option value="">Sélectionnez d'abord un utilisateur</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted" data-user-autocomplete-target="selectedLabel">Aucun utilisateur sélectionné.</small>
                    </div>

                    <button class="btn btn-primary text-white px-4" style="border-radius: 30px;" type="submit">Ajouter</button>
                </form>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body border-bottom">
                    <h2 class="h5 mb-1">
                        <span class="cabinet-title" title="{{ cabinet.nom }}">{{ cabinet.nom }}</span>
                    </h2>
                    <p class="text-muted mb-0">
                        {{ cabinet.adresse ?: 'Adresse non renseignée' }}
                        {% if cabinet.ville %} - {{ cabinet.ville }}{% endif %}
                        {% if cabinet.codePostal %} ({{ cabinet.codePostal }}){% endif %}
                    </p>
                </div>

                <div class="table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Membre</th>
                                <th>Rôle</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for assignment in assignments %}
                            <tr>
                                <td>
                                    <span class="cabinet-user-name" title="{{ assignment.user.prenom }} {{ assignment.user.nom }}">
                                        {{ assignment.user.prenom }} {{ assignment.user.nom }}
                                    </span>
                                    <small class="text-muted cabinet-user-email">({{ assignment.user.email }})</small>
                                </td>
                                <td>{{ assignment.roleInCabinet }}</td>
                                <td class="text-end">
                                    {% if not (assignment.user and app.user and assignment.user.id == app.user.id) %}
                                        <form method="post" action="{{ path('app_admin_cabinet_assignment_delete', {'slug': assignment.slug}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_assignment_' ~ assignment.id) }}">
                                            <button class="btn btn-sm btn-danger text-white">Retirer</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">Aucun membre affecté.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
