{% extends 'base.html.twig' %}

{% block title %}Prendre RDV pour {{ animal.nom }}{% endblock %}

{% block body %}
    <div class="container my-5 px-3 rounded-4 py-4" data-controller="book">
        <h2 class="h4 fw-bold mb-4 text-dark text-center">Créer un RDV pour {{ animal.nom }}</h2>

        <!-- VET SELECTOR -->
        <div class="card border border-secondary shadow-sm rounded-4 mb-4 bg-white mx-auto" style="max-width: 600px;">
            <div class="card-body p-4 text-center">
                <form method="GET" action="{{ path('app_vet_patients_book', {slug: animal.slug}) }}" id="vetSelectForm">
                    {% if app.request.query.get('month') %}
                        <input type="hidden" name="month" value="{{ app.request.query.get('month') }}">
                    {% endif %}
                    <label class="form-label fw-bold">Sélectionner le vétérinaire :</label>
                    <select name="vet_id" class="form-select form-select-lg w-auto mx-auto" onchange="document.getElementById('vetSelectForm').submit();">
                        {% for v in vets %}
                            <option value="{{ v.id }}" {% if selectedVet and selectedVet.id == v.id %}selected{% endif %}>
                                Dr. {{ v.prenom }} {{ v.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </form>
            </div>
        </div>

        {% if selectedVet %}
            <!-- CHOISIR UNE DATE — REAL CALENDAR -->
            <div id="calendar" class="card border-0 shadow-sm rounded-4 mb-4 p-4 p-md-5 bg-white text-center mx-auto" style="max-width: 800px;">
                <h3 class="h5 fw-bold mb-4 text-dark">Choisir une date</h3>

                <!-- Month navigation -->
                <div class="d-flex justify-content-center align-items-center mb-4">
                    <a href="{{ path('app_vet_patients_book', {slug: animal.slug, month: prevMonth|date('Y-m'), vet_id: selectedVet.id}) }}#calendar" class="btn btn-outline-secondary rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center me-3 border text-decoration-none border-neutral-30 text-neutral-60" style="width: 36px; height: 36px;">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    <span class="fw-semibold mx-3 text-dark">{{ currentMonth|date('F Y') }}</span>
                    <a href="{{ path('app_vet_patients_book', {slug: animal.slug, month: nextMonth|date('Y-m'), vet_id: selectedVet.id}) }}#calendar" class="btn btn-primary rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center ms-3 text-white border-0 text-decoration-none" style="width: 36px; height: 36px;">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>

                <!-- Calendar grid -->
                <div class="table-responsive">
                    <table class="table table-borderless mx-auto w-auto">
                        <thead>
                            <tr class="text-neutral-60 small font-weight-bold">
                                <th class="px-2 py-1">Lu.</th>
                                <th class="px-2 py-1">Ma.</th>
                                <th class="px-2 py-1">Me.</th>
                                <th class="px-2 py-1">Je.</th>
                                <th class="px-2 py-1">Ve.</th>
                                <th class="px-2 py-1">Sa.</th>
                                <th class="px-2 py-1">Di.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for week in weeks %}
                                <tr>
                                    {% for day in week %}
                                        <td class="px-1 py-1 text-center">
                                            {% if day is null %}
                                                {# empty cell #}
                                            {% elseif day.isPast or not day.isWorking %}
                                                <span class="d-inline-flex align-items-center justify-content-center rounded-circle text-neutral-40 fw-normal" style="width:36px;height:36px;">
                                                    {{ day.number }}
                                                </span>
                                            {% elseif selectedDate is not null and day.date == selectedDate %}
                                                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary text-dark fw-bold shadow-sm" style="width:36px;height:36px;">
                                                    {{ day.number }}
                                                </span>
                                            {% else %}
                                                <a href="{{ path('app_vet_patients_book', {slug: animal.slug, date: day.date, month: currentMonth|date('Y-m'), vet_id: selectedVet.id}) }}#horaires" class="d-inline-flex align-items-center justify-content-center rounded-circle bg-neutral-10 text-dark fw-bold shadow-sm text-decoration-none {{ day.isToday ? 'border border-primary border-2' : '' }}" style="width:36px;height:36px;">
                                                    {{ day.number }}
                                                </a>
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- CHOISIR UN HORAIRE CARD -->
            {% if selectedDate is not null %}
                <div id="horaires" class="card border-0 shadow-sm rounded-4 mb-4 p-4 p-md-5 bg-white text-center mx-auto" style="max-width: 800px;">
                    <h3 class="h5 fw-bold mb-4 text-dark">Choisir un horaire</h3>
                    <input type="hidden" id="selectedSlotInput" value="">

                    {% if morningSlots is empty and afternoonSlots is empty %}
                        <div class="alert alert-info">Aucun créneau disponible pour cette date.</div>
                    {% else %}
                        <div class="row w-100 mt-2">
                            {% if morningSlots is not empty %}
                                <div class="col-md-6 {{ afternoonSlots is not empty ? 'border-end' : '' }}">
                                    <h4 class="h6 fw-bold mb-3 text-start ps-3">Matin</h4>
                                    <div class="d-flex flex-wrap gap-2 justify-content-start ps-3">
                                        {% for slot in morningSlots %}
                                            {% set isPast = (selectedDate == "now"|date("Y-m-d", "Europe/Paris") and slot.time < "now"|date("H:i", "Europe/Paris")) %}
                                            {% if not isPast %}
                                                {% if slot.available %}
                                                    <button type="button" class="btn bg-white border-neutral-40 text-dark px-3 py-1 rounded-3 slot-btn" data-slot="{{ slot.time }}">
                                                        {{ slot.time }}
                                                    </button>
                                                {% else %}
                                                    <button type="button" class="btn bg-white border-neutral-40 text-neutral-40 px-3 py-1 rounded-3" disabled style="opacity: 0.5; text-decoration: line-through;">
                                                        {{ slot.time }}
                                                    </button>
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                            {% if afternoonSlots is not empty %}
                                <div class="col-md-6 {{ morningSlots is not empty ? 'mt-4 mt-md-0' : '' }}">
                                    <h4 class="h6 fw-bold mb-3 text-start ps-3">Après-midi</h4>
                                    <div class="d-flex flex-wrap gap-2 justify-content-start ps-3">
                                        {% for slot in afternoonSlots %}
                                            {% set isPast = (selectedDate == "now"|date("Y-m-d", "Europe/Paris") and slot.time < "now"|date("H:i", "Europe/Paris")) %}
                                            {% if not isPast %}
                                                {% if slot.available %}
                                                    <button type="button" class="btn bg-white border-neutral-40 text-dark px-3 py-1 rounded-3 slot-btn" data-slot="{{ slot.time }}">
                                                        {{ slot.time }}
                                                    </button>
                                                {% else %}
                                                    <button type="button" class="btn bg-white border-neutral-40 text-neutral-40 px-3 py-1 rounded-3" disabled style="opacity: 0.5; text-decoration: line-through;">
                                                        {{ slot.time }}
                                                    </button>
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>

                <!-- MAIN BOOKING FORM -->
                <form method="POST" action="{{ path('app_vet_patients_new_rdv', {slug: animal.slug}) }}" id="confirmBookingForm" data-turbo="false">
                    <input type="hidden" name="_token" value="{{ csrf_token('new_rdv_' ~ animal.id) }}">
                    <input type="hidden" name="vet_id" value="{{ selectedVet.id }}">
                    <input type="hidden" name="selectedDate" value="{{ selectedDate ?? '' }}">
                    <input type="hidden" name="selectedSlot" id="confirmSlotInput" value="">

                    <div class="text-center mt-5 mb-5">
                        <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 p-md-5 bg-white text-start mx-auto" style="max-width: 800px;">
                            <h3 class="h5 fw-bold mb-4 text-info-pressed">Détails de la consultation</h3>
                            <div class="row g-4">
                                <div class="col-12">
                                    <label class="form-label fw-medium text-primary">Motif de consultation
                                        <span class="text-danger">*</span>
                                    </label>
                                    <textarea id="rdvMotif" name="rdvMotif" class="form-control rounded-4 border-light-subtle shadow-sm p-3" rows="2" style="resize: none;" placeholder="Saisir le motif de consultation" required></textarea>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-medium text-primary">Remarque</label>
                                    <textarea id="rdvRemarque" name="rdvRemarque" class="form-control rounded-4 border-light-subtle shadow-sm p-3" rows="3" style="resize: none;" placeholder="Saisir vos remarques"></textarea>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary text-white rounded-pill px-5 py-3 fw-bold shadow-sm fs-6 border-0">
                            Créer le Rendez-vous
                        </button>
                    </div>
                </form>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
