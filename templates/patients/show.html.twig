{% extends 'base.html.twig' %}

{% block title %}{{ animal.nom }} — Carnet de santé — MrVeto{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('carnet_sante') }}
{% endblock %}

{% block body %}
<div class="carnet-sante-page p-3 p-lg-4" data-controller="rendezvous">
    <div class="container-fluid p-0">

        <!-- Breadcrumb -->
        <nav class="mb-4" aria-label="Fil d'Ariane">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item">
                    <a href="{{ path('app_vet_patients') }}" class="text-primary text-decoration-none">
                        <i class="bi bi-people me-1"></i>Mes Patients
                    </a>
                </li>
                <li class="breadcrumb-item active text-muted">{{ animal.nom }}</li>
            </ol>
        </nav>

        {% if isReadOnly %}
            <div class="mb-3">
                <span class="badge bg-neutral-20 text-neutral-80 rounded-pill">Lecture seule</span>
            </div>
        {% endif %}

        <div class="row g-4 align-items-start">

            <!-- COLONNE PRINCIPALE -->
            <div class="col-12 col-xl-9">

                <!-- Fiche animal -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-3 p-lg-4">
                        <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <img
                                    src="https://ui-avatars.com/api/?name={{ animal.nom|url_encode }}&background=EBF4FC&color=36BDAF&bold=true&size=128"
                                    alt="{{ animal.nom }}"
                                    class="rounded-circle border border-2 border-white shadow-sm"
                                    width="84"
                                    height="84"
                                >
                                <div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <h1 class="h4 fw-bold mb-0 text-neutral-100">{{ animal.nom }}</h1>
                                        <span class="badge rounded-pill text-bg-primary bg-primary-bg text-primary fw-medium">
                                            {{ animal.race|default(animal.espece|default('Animal'))|upper }}
                                        </span>
                                        {% if animal.vaccinAJour %}
                                            <span class="badge bg-success-bg text-success rounded-pill fw-medium">
                                                <i class="bi bi-shield-check me-1"></i>Vaccins à jour
                                            </span>
                                        {% else %}
                                            <span class="badge bg-danger-bg text-danger rounded-pill fw-medium">
                                                <i class="bi bi-shield-exclamation me-1"></i>Vaccins expirés
                                            </span>
                                        {% endif %}
                                    </div>
                                    <div class="mt-2 d-flex flex-wrap gap-3 text-muted small">
                                        <span class="d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-calendar text-primary"></i>
                                            {{ animal.age|default('Age inconnu') }}
                                        </span>
                                        {% if animal.poids %}
                                            <span class="d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-speedometer2 text-primary"></i>
                                                {{ animal.poids }} kg
                                            </span>
                                        {% endif %}
                                        <span class="d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-person text-primary"></i>
                                            {{ animal.proprietaire ? (animal.proprietaire.prenom ~ ' ' ~ animal.proprietaire.nom) : 'Propriétaire inconnu' }}
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-2 flex-shrink-0">
                                <div class="text-center px-4 py-2 rounded-3 bg-neutral-20">
                                    <div class="text-muted fw-bold mb-1" style="font-size: 0.65rem; letter-spacing: 0.06em; text-transform: uppercase;">Dernière visite</div>
                                    {% if lastVisit %}
                                        <div class="fw-semibold text-neutral-90 small">{{ lastVisit.dateHeure|date('d M Y') }}</div>
                                    {% else %}
                                        <div class="fw-semibold text-neutral-90 small">Aucune</div>
                                    {% endif %}
                                </div>
                                {% if not isReadOnly %}
                                    <button
                                        class="btn btn-outline-primary rounded-3 d-flex align-items-center justify-content-center gap-2 w-100"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editAnimalModal"
                                        type="button"
                                    >
                                        <i class="bi bi-pencil-square"></i>
                                        Modifier la fiche
                                    </button>
                                {% endif %}
                                <a
                                    class="btn btn-primary text-white rounded-3 d-flex align-items-center justify-content-center gap-2 w-100 {% if not isReadOnly %}mt-2{% endif %}"
                                    href="{{ path('app_vet_patients_book', {'slug': animal.slug}) }}"
                                >
                                    <i class="bi bi-calendar-plus"></i>
                                    Créer un RDV
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Traitements en cours -->
                <div class="mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="h5 fw-bold d-flex align-items-center gap-2 mb-0 text-neutral-100">
                            <i class="bi bi-clipboard-pulse text-primary"></i>
                            Traitements
                        </h2>
                        {% if not isReadOnly %}
                            <button
                                class="btn btn-sm btn-primary rounded-pill px-3"
                                data-bs-toggle="modal"
                                data-bs-target="#addTraitementModal"
                                type="button"
                            >
                                <i class="bi bi-plus-lg me-1"></i>Ajouter
                            </button>
                        {% endif %}
                    </div>

                    {% if traitements is empty %}
                        <div class="card border-0 shadow-sm">
                            <div class="card-body py-4 text-center text-muted">
                                <i class="bi bi-clipboard-x display-6 d-block mb-2"></i>
                                Aucun traitement enregistré pour cet animal.
                            </div>
                        </div>
                    {% else %}
                        <div class="card border-0 shadow-sm overflow-hidden">
                            <div class="table-responsive">
                                <table class="table table-borderless align-middle mb-0 cs-history-table">
                                    <thead>
                                        <tr class="border-bottom border-light-subtle">
                                            <th class="text-muted cs-fs-7 fw-bold pb-2">TRAITEMENT</th>
                                            <th class="text-muted cs-fs-7 fw-bold pb-2">POSOLOGIE</th>
                                            <th class="text-muted cs-fs-7 fw-bold pb-2">PÉRIODE</th>
                                            <th class="text-muted cs-fs-7 fw-bold pb-2">PRESCRIT PAR</th>
                                            <th class="text-muted cs-fs-7 fw-bold pb-2 text-end">STATUT</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for traitement in traitements %}
                                            <tr class="border-bottom border-light-subtle">
                                                <td>
                                                    <div class="fw-bold text-neutral-100">{{ traitement.libelle }}</div>
                                                </td>
                                                <td class="text-muted">{{ traitement.posologie|default('—') }}</td>
                                                <td class="text-muted small">
                                                    {{ traitement.dateDebut|date('d/m/Y') }}
                                                    {% if traitement.dateFin %}
                                                        → {{ traitement.dateFin|date('d/m/Y') }}
                                                    {% else %}
                                                        → <span class="text-success fw-medium">En cours</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if traitement.veterinaire %}
                                                        <span class="small text-muted">Dr. {{ traitement.veterinaire.nom }}</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-center">
                                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                                        {% if traitement.isEnCours %}
                                                            <span class="badge bg-success-bg text-success rounded-pill" style="font-size: 0.7rem;">Actif</span>
                                                        {% else %}
                                                            <span class="badge bg-neutral-20 text-neutral-70 rounded-pill" style="font-size: 0.7rem;">Terminé</span>
                                                        {% endif %}
                                                        {% if not isReadOnly and traitement.veterinaire == vet %}
                                                            <button
                                                                type="button"
                                                                class="btn btn-sm btn-light rounded p-1 text-danger cs-icon-btn d-flex align-items-center justify-content-center"
                                                                title="Supprimer"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#deleteTraitementModal"
                                                                data-traitement-id="{{ traitement.id }}"
                                                                data-traitement-libelle="{{ traitement.libelle|e('html_attr') }}"
                                                                data-delete-url="{{ path('app_vet_patients_traitement_delete', {'slug': traitement.slug}) }}"
                                                                data-csrf-token="{{ csrf_token('delete_traitement_' ~ traitement.id) }}"
                                                            >
                                                                <i class="bi bi-trash3"></i>
                                                            </button>
                                                        {% endif %}
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% endif %}
                </div>

                <!-- Historique médical -->
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="h5 fw-bold d-flex align-items-center gap-2 mb-0 text-neutral-100">
                            <i class="bi bi-clock-history text-primary"></i>
                            Historique médical
                        </h2>
                        {% set rdvNonAnnulesCount = rdvHistory|filter(r => r.statut != 'annule')|length %}
                        <span class="small text-muted">{{ rdvNonAnnulesCount }} consultation{{ rdvNonAnnulesCount > 1 ? 's' : '' }}</span>
                    </div>

                    {% set rdvNonAnnules = rdvHistory|filter(r => r.statut != 'annule') %}
                    <div class="card border-0 shadow-sm overflow-hidden">
                        {% if rdvNonAnnules is empty %}
                            <div class="card-body py-4 text-center text-muted">
                                Aucune consultation enregistrée pour cet animal.
                            </div>
                        {% else %}
                            {% for rdv in rdvNonAnnules %}
                                {% set isOwnRdv = rdv.veterinaire == vet %}
                                <div class="border-bottom border-light-subtle p-3 p-lg-4 rdv-item" data-rdv-index="{{ loop.index0 }}">
                                    <div class="d-flex flex-column flex-lg-row gap-3">

                                        <!-- Date + statut -->
                                        <div style="min-width: 130px;">
                                            <div class="fw-bold text-neutral-100">{{ rdv.dateHeure|date('d M Y') }}</div>
                                            <div class="small text-muted">{{ rdv.dateHeure|date('H:i') }}</div>
                                            {% set isFinished = rdv.statut == 'termine' or rdv.dateHeure < date() %}
                                            {% if isFinished %}
                                                <span class="badge bg-success-bg text-success rounded-pill mt-1" style="font-size: 0.7rem;">Terminé</span>
                                            {% else %}
                                                <span class="badge bg-info-bg text-info rounded-pill mt-1" style="font-size: 0.7rem;">À venir</span>
                                            {% endif %}
                                        </div>

                                        <!-- Vet + motif -->
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                {% if rdv.veterinaire %}
                                                    <div class="cs-vet-avatar rounded-circle overflow-hidden bg-light flex-shrink-0">
                                                        <img
                                                            src="https://ui-avatars.com/api/?name={{ (rdv.veterinaire.prenom|default(''))|url_encode }}+{{ (rdv.veterinaire.nom|default(''))|url_encode }}&background=random"
                                                            class="w-100 h-100 object-fit-cover"
                                                            alt="Dr. {{ rdv.veterinaire.nom }}"
                                                        >
                                                    </div>
                                                    <span class="fw-semibold text-neutral-100">Dr. {{ rdv.veterinaire.nom }}</span>
                                                    {% if isOwnRdv %}
                                                        <span class="badge bg-primary-bg text-primary rounded-pill" style="font-size: 0.68rem;">Vous</span>
                                                    {% endif %}
                                                {% else %}
                                                    <span class="text-muted small">Vétérinaire inconnu</span>
                                                {% endif %}
                                            </div>
                                            <div class="text-neutral-80 fw-medium">{{ rdv.motif|default('Consultation') }}</div>

                                            <!-- Compte-rendu / remarque -->
                                            {% if not isFinished %}
                                                <div class="d-flex gap-2 mt-3 mb-2">
                                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-medium"
                                                            data-action="click->rendezvous#openEditModal"
                                                            data-slug="{{ rdv.slug }}"
                                                            data-vet="{{ rdv.veterinaire.prenom|default('') }} {{ rdv.veterinaire.nom|default('') }}"
                                                            data-motif="{{ rdv.motif|default('Consultation générale') }}"
                                                            data-statut="{{ rdv.statut }}"
                                                            data-date="{{ rdv.dateHeure|date('Y-m-d') }}"
                                                            data-time="{{ rdv.dateHeure|date('H:i') }}">
                                                        Modifier
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-medium"
                                                            data-action="click->rendezvous#openCancelModal"
                                                            data-slug="{{ rdv.slug }}"
                                                            data-date="{{ rdv.dateHeure|date('Y-m-d') }}"
                                                            data-time="{{ rdv.dateHeure|date('H:i') }}">
                                                        Annuler
                                                    </button>
                                                </div>
                                            {% endif %}
                                            {% if isOwnRdv and not isReadOnly and not rdv.isCompteRenduValidated %}
                                                <div class="mt-2">
                                                    <button
                                                        id="toggle-compte-rendu-{{ rdv.id }}"
                                                        class="btn btn-sm btn-link p-0 text-primary text-decoration-none fw-medium"
                                                        type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#compte-rendu-form-{{ rdv.id }}"
                                                    >
                                                        <i class="bi bi-pencil me-1"></i>
                                                        {% if rdv.compteRendu %}Modifier le brouillon{% else %}Ajouter un compte-rendu{% endif %}
                                                    </button>
                                                    
                                                    {% if rdv.compteRendu %}
                                                    <div class="mt-1 p-2 bg-neutral-20 rounded small text-neutral-80">
                                                        <span class="badge bg-secondary mb-1">Brouillon</span><br>
                                                        {{ rdv.compteRendu|nl2br }}
                                                    </div>
                                                    {% endif %}

                                                    <div class="collapse mt-2" id="compte-rendu-form-{{ rdv.id }}">
                                                        <form
                                                            method="POST"
                                                            action="{{ path('app_vet_patients_update_compte_rendu', {'slug': rdv.slug}) }}"
                                                        >
                                                            <input type="hidden" name="_token" value="{{ csrf_token('compte_rendu_' ~ rdv.id) }}">
                                                            <textarea
                                                                name="compte_rendu"
                                                                class="form-control form-control-sm mb-2"
                                                                rows="3"
                                                                placeholder="Observations, diagnostic, prescription..."
                                                            >{{ rdv.compteRendu|default('') }}</textarea>
                                                            <div class="d-flex gap-2 flex-wrap">
                                                                <button class="btn btn-sm btn-light rounded-pill px-3" name="action" value="draft" type="submit">Sauvegarder Brouillon</button>
                                                                <button class="btn btn-sm btn-primary rounded-pill px-3" name="action" value="validate" type="submit">Valider définitivement</button>
                                                                <button
                                                                    class="btn btn-sm btn-link text-muted px-2"
                                                                    type="button"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#compte-rendu-form-{{ rdv.id }}"
                                                                >Annuler</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            {% elseif rdv.compteRendu %}
                                                <div class="mt-2 p-2 bg-neutral-20 rounded small text-neutral-80">
                                                    {{ rdv.compteRendu|nl2br }}
                                                    {% if rdv.compteRenduPdf %}
                                                        <div class="mt-2">
                                                            <a href="{{ path('app_rdv_download_pdf', {'slug': rdv.slug}) }}" target="_blank" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 py-1" style="font-size: 0.75rem;">
                                                                <i class="bi bi-file-earmark-pdf"></i> PDF
                                                            </a>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                            <!-- Pagination -->
                            <div class="d-flex align-items-center justify-content-between px-3 py-2 bg-neutral-20" id="rdv-pagination-footer">
                                <span class="small text-muted" id="rdv-count-label">{{ rdvNonAnnules|length }} consultation{{ rdvNonAnnules|length > 1 ? 's' : '' }} au total</span>
                                <nav aria-label="Pagination consultations">
                                    <ul class="pagination pagination-sm mb-0 gap-1" id="rdv-pagination"></ul>
                                </nav>
                            </div>
                        {% endif %}
                    </div>
                </div>

            </div>

            <!-- COLONNE LATÉRALE -->
            <div class="col-12 col-xl-3">
                <div class="d-flex flex-column gap-3">

                    <!-- Infos propriétaire -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-3 text-neutral-100">
                                <i class="bi bi-person-circle text-primary"></i>
                                Propriétaire
                            </h2>
                            {% if animal.proprietaire %}
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle overflow-hidden shadow-sm flex-shrink-0" style="width: 40px; height: 40px;">
                                        <img
                                            src="https://ui-avatars.com/api/?name={{ animal.proprietaire.prenom|url_encode }}+{{ animal.proprietaire.nom|url_encode }}&background=random"
                                            class="w-100 h-100 object-fit-cover"
                                            alt="{{ animal.proprietaire.prenom }} {{ animal.proprietaire.nom }}"
                                        >
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-neutral-100">{{ animal.proprietaire.prenom }} {{ animal.proprietaire.nom }}</div>
                                        {% if animal.proprietaire.telephone %}
                                            <div class="small text-muted">{{ animal.proprietaire.telephone|format_phone }}</div>
                                        {% endif %}
                                        <div class="small text-muted">{{ animal.proprietaire.email }}</div>
                                    </div>
                                </div>
                            {% else %}
                                <span class="text-muted small">Propriétaire inconnu</span>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Vaccins -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-3 text-neutral-100">
                                <i class="bi bi-shield-plus text-primary"></i>
                                Vaccinations
                            </h2>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Statut</span>
                                <span class="fw-bold {% if animal.vaccinAJour %}text-success{% else %}text-danger{% endif %}">
                                    {{ animal.vaccinAJour ? 'À jour' : 'Expiré' }}
                                </span>
                            </div>
                            {% if animal.prochainVaccin %}
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Prochain rappel</span>
                                    <span class="fw-medium small text-neutral-90">{{ animal.prochainVaccin|date('d/m/Y') }}</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Traitements actifs (résumé) -->
                    {% set traitementsActifs = traitements|filter(t => t.isEnCours) %}
                    {% if traitementsActifs|length > 0 %}
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-3 text-neutral-100">
                                    <i class="bi bi-clipboard-heart text-primary"></i>
                                    Traitements actifs
                                </h2>
                                <div class="d-flex flex-column gap-2">
                                    {% for t in traitementsActifs %}
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="bi bi-capsule text-primary mt-1 flex-shrink-0"></i>
                                            <div>
                                                <div class="fw-medium text-neutral-90 small">{{ t.libelle }}</div>
                                                {% if t.posologie %}
                                                    <div class="text-muted" style="font-size: 0.78rem;">{{ t.posologie }}</div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endif %}

                </div>
            </div>

        </div>
        
        {% include 'rendez_vous/_modals.html.twig' %}
    </div>
</div>

{% if not isReadOnly %}
    <!-- Modal : Supprimer un traitement (confirmation) -->
    <div class="modal fade" id="deleteTraitementModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h2 class="h5 fw-bold mb-0">Supprimer le traitement</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div class="d-flex align-items-start gap-3 p-3 bg-danger-bg rounded-3 mb-3">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5 mt-1 flex-shrink-0"></i>
                        <p class="mb-0 text-danger-emphasis">
                            Vous êtes sur le point de supprimer le traitement
                            <strong id="deleteTraitementName"></strong>.
                            Cette action est irréversible.
                        </p>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0 gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                    <form id="deleteTraitementForm" method="POST" action="">
                        <input type="hidden" name="_token" id="deleteTraitementToken" value="">
                        <button type="submit" class="btn btn-danger rounded-pill px-4">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal : Modifier la fiche animal -->
    <div class="modal fade" id="editAnimalModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h2 class="h5 fw-bold mb-0">Modifier la fiche de {{ animal.nom }}</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body p-4 pt-3">
                    <form method="POST" action="{{ path('app_vet_patients_update_animal', {'slug': animal.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('update_animal_' ~ animal.id) }}">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Espèce</label>
                                <input type="text" name="espece" class="form-control" value="{{ animal.espece|default('') }}" placeholder="Ex: Chat, Chien...">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Race</label>
                                <input type="text" name="race" class="form-control" value="{{ animal.race|default('') }}" placeholder="Ex: Labrador, Persan...">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Âge</label>
                                <input type="text" name="age" class="form-control" value="{{ animal.age|default('') }}" placeholder="Ex: 3 ans">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Poids (kg)</label>
                                <input type="number" step="0.01" name="poids" class="form-control" value="{{ animal.poids|default('') }}" placeholder="Ex: 4.5">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Vaccins à jour</label>
                                <select name="vaccinAJour" class="form-select">
                                    <option value="1" {{ animal.vaccinAJour ? 'selected' : '' }}>Oui</option>
                                    <option value="0" {{ not animal.vaccinAJour ? 'selected' : '' }}>Non</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Prochain vaccin</label>
                                <input
                                    type="date"
                                    name="prochainVaccin"
                                    class="form-control"
                                    value="{{ animal.prochainVaccin ? animal.prochainVaccin|date('Y-m-d') : '' }}"
                                >
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button class="btn btn-primary rounded-pill px-4" type="submit">Enregistrer</button>
                            <button class="btn btn-light rounded-pill px-4" type="button" data-bs-dismiss="modal">Annuler</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal : Ajouter un traitement -->
    <div class="modal fade" id="addTraitementModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h2 class="h5 fw-bold mb-0">Ajouter un traitement</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body p-4 pt-3">
                    <form method="POST" action="{{ path('app_vet_patients_traitement_new', {'slug': animal.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('traitement_new_' ~ animal.id) }}">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-medium">Médicament / Traitement <span class="text-danger">*</span></label>
                                <input type="text" name="libelle" class="form-control" placeholder="Ex: Vitamines B12, Antibiotiques..." required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-medium">Posologie</label>
                                <input type="text" name="posologie" class="form-control" placeholder="Ex: 1 comprimé par jour le matin">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Date de début <span class="text-danger">*</span></label>
                                <input type="date" name="dateDebut" class="form-control" value="{{ 'now'|date('Y-m-d') }}" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Date de fin <span class="text-muted fw-normal">(facultatif)</span></label>
                                <input type="date" name="dateFin" class="form-control">
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button class="btn btn-primary rounded-pill px-4" type="submit">Ajouter</button>
                            <button class="btn btn-light rounded-pill px-4" type="button" data-bs-dismiss="modal">Annuler</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endif %}



{% block javascripts %}
{{ parent() }}
<script>
(function () {
    // ── Masquer le bouton "modifier compte-rendu" quand le formulaire est ouvert ──
    document.querySelectorAll('[id^="compte-rendu-form-"]').forEach(function (collapseEl) {
        const id = collapseEl.id.replace('compte-rendu-form-', '');
        const btn = document.getElementById('toggle-compte-rendu-' + id);
        if (!btn) return;
        collapseEl.addEventListener('show.bs.collapse', function () { btn.classList.add('d-none'); });
        collapseEl.addEventListener('hide.bs.collapse', function () { btn.classList.remove('d-none'); });
    });

    // ── Modal suppression traitement ──────────────────────────────
    const deleteModal = document.getElementById('deleteTraitementModal');
    if (deleteModal) {
        deleteModal.addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('deleteTraitementName').textContent = btn.dataset.traitementLibelle;
            const form = document.getElementById('deleteTraitementForm');
            form.action = btn.dataset.deleteUrl;
            document.getElementById('deleteTraitementToken').value = btn.dataset.csrfToken;
        });
    }

    // ── Pagination historique (5 par page) ───────────────────────
    const PER_PAGE = 5;
    const items = Array.from(document.querySelectorAll('.rdv-item'));
    const paginationEl = document.getElementById('rdv-pagination');

    if (items.length <= PER_PAGE || !paginationEl) return;

    let currentPage = 0;
    const totalPages = Math.ceil(items.length / PER_PAGE);

    function renderPage(page) {
        items.forEach((item, i) => {
            item.style.display = (i >= page * PER_PAGE && i < (page + 1) * PER_PAGE) ? '' : 'none';
        });
        renderPagination(page);
    }

    function renderPagination(page) {
        paginationEl.innerHTML = '';

        // Précédent
        const prev = document.createElement('li');
        prev.className = 'page-item' + (page === 0 ? ' disabled' : '');
        prev.innerHTML = '<button class="page-link rounded-3 border-0 bg-transparent" aria-label="Précédent"><i class="bi bi-chevron-left"></i></button>';
        if (page > 0) prev.querySelector('button').addEventListener('click', () => renderPage(page - 1));
        paginationEl.appendChild(prev);

        // Numéros
        for (let p = 0; p < totalPages; p++) {
            const li = document.createElement('li');
            li.className = 'page-item' + (p === page ? ' active' : '');
            const btn = document.createElement('button');
            btn.className = 'page-link rounded-3 border-0' + (p === page ? ' bg-primary text-white' : ' bg-transparent text-muted');
            btn.textContent = p + 1;
            btn.addEventListener('click', () => renderPage(p));
            li.appendChild(btn);
            paginationEl.appendChild(li);
        }

        // Suivant
        const next = document.createElement('li');
        next.className = 'page-item' + (page === totalPages - 1 ? ' disabled' : '');
        next.innerHTML = '<button class="page-link rounded-3 border-0 bg-transparent" aria-label="Suivant"><i class="bi bi-chevron-right"></i></button>';
        if (page < totalPages - 1) next.querySelector('button').addEventListener('click', () => renderPage(page + 1));
        paginationEl.appendChild(next);
    }

    renderPage(0);
})();
</script>
{% endblock %}
{% endblock %}

