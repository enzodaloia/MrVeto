{% extends 'base.html.twig' %}

{% block title %}Prendre RDV - Dr. {{ vet.prenom }} {{ vet.nom }}{% endblock %}

{% block body %}
<div class="container my-5 px-3">

    <!-- STEPPER -->
    <div class="d-flex justify-content-center align-items-center mb-4 pt-3 gap-2">
        <div class="rounded-circle bg-success p-1"></div>
        <div class="bg-secondary-subtle rounded"></div>
        <div class="rounded-circle bg-secondary p-1"></div>
        <div class="bg-secondary-subtle rounded"></div>
        <div class="rounded-circle bg-secondary p-1"></div>
    </div>

    <!-- VET SUMMARY CARD -->
    <div class="card border border-warning shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4 d-flex align-items-center gap-4">
            <img src="https://ui-avatars.com/api/?name={{ vet.prenom }}+{{ vet.nom }}&background=random" alt="Dr. {{ vet.prenom }} {{ vet.nom }}" class="rounded-circle shadow-sm object-fit-cover" width="80" height="80">

            <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h2 class="h5 fw-bold mb-1 text-dark">Dr. {{ vet.prenom }} {{ vet.nom }}</h2>
                        <p class="text-muted mb-1 small">Vétérinaire Généraliste</p>
                        <p class="text-primary small mb-2"><a href="#" class="text-decoration-none">{{ vet.adressecabinet|default('123 Rue de la Santé, 75000 ville') }}</a> • A 1.2 km</p>
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="badge bg-light text-dark fw-normal border">Urgence</span>
                            <span class="badge bg-light text-dark fw-normal border">Parking</span>
                        </div>
                    </div>
                    <button class="btn btn-outline-success rounded-pill btn-sm d-flex align-items-center gap-2">
                        <twig:ux:icon name="lucide:heart" class="m-0" />
                        Ajouter aux favoris
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- CHOISIR UNE DATE — REAL CALENDAR -->
    <div id="calendar" class="card border-0 shadow-sm rounded-4 mb-4 p-4 p-md-5 bg-white text-center">
        <h3 class="h5 fw-bold mb-4 text-dark">Choisir une date</h3>

        {% if not hasWorkingDays %}
            <div class="alert alert-warning">Ce vétérinaire n'a pas encore configuré ses disponibilités.</div>
        {% else %}
            <!-- Month navigation -->
            <div class="d-flex justify-content-center align-items-center mb-4">
                <a href="{{ path('app_vet_book', {id: vet.id, month: prevMonth}) }}#calendar" class="btn btn-outline-secondary rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center me-3 border text-decoration-none">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <span class="fw-semibold mx-3 text-dark">{{ monthLabel }}</span>
                <a href="{{ path('app_vet_book', {id: vet.id, month: nextMonth}) }}#calendar" class="btn btn-success rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center ms-3 text-white border-0 text-decoration-none">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>

            <!-- Calendar grid -->
            <div class="table-responsive">
                <table class="table table-borderless mx-auto w-auto">
                    <thead>
                        <tr class="text-muted small">
                            <th class="px-2 py-1">Lun</th>
                            <th class="px-2 py-1">Mar</th>
                            <th class="px-2 py-1">Mer</th>
                            <th class="px-2 py-1">Jeu</th>
                            <th class="px-2 py-1">Ven</th>
                            <th class="px-2 py-1">Sam</th>
                            <th class="px-2 py-1">Dim</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for week in weeks %}
                            <tr>
                                {% for day in week %}
                                    <td class="px-1 py-1 text-center">
                                        {% if day is null %}
                                            {# empty cell #}
                                        {% elseif day.isPast or not day.isWorking %}
                                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle text-muted text-opacity-50 fw-normal" style="width:36px;height:36px;">
                                                {{ day.number }}
                                            </span>
                                        {% elseif selectedDate is not null and day.date == selectedDate %}
                                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning text-white fw-bold shadow-sm" style="width:36px;height:36px;">
                                                {{ day.number }}
                                            </span>
                                        {% else %}
                                            <a href="{{ path('app_vet_book', {id: vet.id, month: currentYear ~ '-' ~ ('%02d'|format(currentMonth)), date: day.date}) }}#horaires"
                                               class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-dark fw-bold shadow-sm text-decoration-none {{ day.isToday ? 'border border-success border-2' : '' }}" style="width:36px;height:36px;">
                                                {{ day.number }}
                                            </a>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <!-- CHOISIR UN HORAIRE CARD -->
    {% if selectedDate is not null %}
        <div id="horaires" class="card border-0 shadow-sm rounded-4 mb-4 p-4 p-md-5 bg-white text-center">
            <h3 class="h5 fw-bold mb-4 text-dark">Choisir un horaire</h3>
            <input type="hidden" id="selectedSlotInput" name="selectedSlot" value="">

            {% if morningSlots is empty and afternoonSlots is empty %}
                <div class="alert alert-info">Aucun créneau disponible pour cette date.</div>
            {% else %}
                <div class="row w-100 mt-2">
                    {% if morningSlots is not empty %}
                        <div class="col-md-6 {{ afternoonSlots is not empty ? 'border-end' : '' }}">
                            <h4 class="h6 fw-bold mb-3 text-start ps-3">Matin</h4>
                            <div class="d-flex flex-wrap gap-2 justify-content-start ps-3">
                                {% for slot in morningSlots %}
                                    <button type="button" class="btn btn-outline-secondary px-3 py-1 rounded-3 slot-btn" data-slot="{{ slot }}">
                                        {{ slot }}
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                    {% if afternoonSlots is not empty %}
                        <div class="col-md-6 {{ morningSlots is not empty ? 'mt-4 mt-md-0' : '' }}">
                            <h4 class="h6 fw-bold mb-3 text-start ps-3">Après-midi</h4>
                            <div class="d-flex flex-wrap gap-2 justify-content-start ps-3">
                                {% for slot in afternoonSlots %}
                                    <button type="button" class="btn btn-outline-secondary px-3 py-1 rounded-3 slot-btn" data-slot="{{ slot }}">
                                        {{ slot }}
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    {% endif %}

    <!-- ANIMAL SELECTOR -->
    {% if app.user %}
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 bg-white">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            {% for animal in animals %}
                <button type="button" class="btn rounded-pill px-3 py-2 d-flex align-items-center gap-2 animal-selector-btn btn-outline-secondary fw-medium" data-animal-id="{{ animal.id }}">
                    <span class="rounded-circle bg-success d-inline-block" style="width:10px;height:10px;"></span>
                    {{ animal.nom }} ({{ animal.espece|default('?') }})
                </button>
            {% endfor %}
            <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-medium" id="newAnimalBtn">
                <i class="bi bi-plus-lg"></i> Nouvel animal
            </button>
        </div>
    </div>
    {% endif %}

    <!-- FICHE ANIMAL FORM -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 p-md-5 bg-white">
        <h3 class="h5 fw-bold mb-4 text-dark">Compléter la fiche animal</h3>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        <form method="POST" action="{{ path('app_vet_book_save_animal', {id: vet.id}) }}">
            <input type="hidden" id="selectedAnimalId" name="animalId" value="">
            <input type="hidden" name="_month" value="{{ currentYear ~ '-' ~ ('%02d'|format(currentMonth)) }}">
            <input type="hidden" name="_date" value="{{ selectedDate ?? '' }}">
            <input type="hidden" name="_slot" value="">
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-medium text-success">Nom de l'animal</label>
                    <input type="text" id="animalNom" name="animalNom" class="form-control rounded-pill border-light-subtle shadow-sm px-3" placeholder="Saisir le nom de l'animal" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-medium text-success">Espèce</label>
                    <input type="text" id="animalEspece" name="animalEspece" class="form-control rounded-pill border-light-subtle shadow-sm px-3" placeholder="Saisir le nom de l'espèce">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-medium text-success">Date de naissance / Âge</label>
                    <input type="text" id="animalDateNaissance" name="animalDateNaissance" class="form-control rounded-pill border-light-subtle shadow-sm px-3" placeholder="Date ou âge estimé">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-medium text-success d-block">Vaccin à jour</label>
                    <div class="d-flex gap-4 mt-2">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="vaccin" value="oui" id="vaccinOui">
                            <label class="form-check-label" for="vaccinOui">Oui</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="vaccin" value="non" id="vaccinNon" checked>
                            <label class="form-check-label" for="vaccinNon">Non</label>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-medium text-success d-flex align-items-center gap-1">
                        Motif de consultation <i class="bi bi-chevron-down small"></i>
                    </label>
                </div>
                <div class="col-12">
                    <label class="form-label fw-medium text-success">Remarque</label>
                    <textarea id="animalRemarque" name="animalRemarque" class="form-control rounded-4 border-light-subtle shadow-sm p-3" rows="3" placeholder="Saisir vos remarques"></textarea>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-medium text-success">Race (optionnel)</label>
                    <input type="text" id="animalRace" name="animalRace" class="form-control rounded-pill border-light-subtle shadow-sm px-3" placeholder="Entrer race">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-medium text-success">Poids (optionnel)</label>
                    <input type="text" id="animalPoids" name="animalPoids" class="form-control rounded-pill border-light-subtle shadow-sm px-3" placeholder="Entrer poids">
                </div>
            </div>

            <hr class="my-4 text-light">

            <div class="d-flex align-items-center gap-4">
                <button type="submit" class="btn btn-dark rounded-pill px-4 py-2">Mettre à jour profil</button>
                <button type="button" class="btn btn-link text-muted text-decoration-none px-0 d-flex align-items-center gap-2" id="clearAnimalFormBtn">
                    <i class="bi bi-x"></i> Tout supprimer
                </button>
            </div>

        </form>
    </div>

    <!-- SUBMIT BUTTON -->
    <div class="text-center mt-5 mb-5">
        <button class="btn btn-success rounded-pill px-5 py-3 fw-bold shadow-sm fs-6">
            Confirmer mon Rendez-vous
        </button>
    </div>

</div>

<script>
    var animalsData = {{ animalsJson|raw }};

    function setupCalendarSlots() {
        var slotBtns = document.querySelectorAll('.slot-btn');
        var hiddenInput = document.getElementById('selectedSlotInput');

        // Restore previously selected slot from URL
        var params = new URLSearchParams(window.location.search);
        var savedSlot = params.get('slot');
        
        // Reset all buttons first to avoid duplicates
        slotBtns.forEach(function(b) {
            b.classList.remove('btn-warning', 'text-white');
            b.classList.add('btn-outline-secondary');
        });

        if (savedSlot) {
            slotBtns.forEach(function(b) {
                if (b.getAttribute('data-slot') === savedSlot) {
                    b.classList.remove('btn-outline-secondary');
                    b.classList.add('btn-warning', 'text-white');
                    if (hiddenInput) hiddenInput.value = savedSlot;
                }
            });
        }

        // Handle slot click
        slotBtns.forEach(function(btn) {
            btn.replaceWith(btn.cloneNode(true));
        });
        slotBtns = document.querySelectorAll('.slot-btn');
        
        slotBtns.forEach(function(btn) {
            btn.addEventListener('click', function() {
                slotBtns.forEach(function(b) {
                    b.classList.remove('btn-warning', 'text-white');
                    b.classList.add('btn-outline-secondary');
                });
                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('btn-warning', 'text-white');

                var slot = btn.getAttribute('data-slot');
                if (hiddenInput) hiddenInput.value = slot;

                var url = new URL(window.location);
                url.searchParams.set('slot', slot);
                url.hash = 'horaires';
                window.history.replaceState({}, '', url);
            });
        });
    }

    function setupAnimalSelector() {
        var selectorBtns = document.querySelectorAll('.animal-selector-btn');
        var newAnimalBtn = document.getElementById('newAnimalBtn');
        var clearBtn = document.getElementById('clearAnimalFormBtn');

        function fillForm(animal) {
            var el = function(id) { return document.getElementById(id); };
            el('selectedAnimalId').value = animal ? animal.id : '';
            el('animalNom').value = animal ? animal.nom : '';
            el('animalEspece').value = animal ? (animal.espece || '') : '';
            el('animalRace').value = animal ? (animal.race || '') : '';
            el('animalDateNaissance').value = animal ? (animal.dateNaissance || '') : '';
            el('animalPoids').value = animal ? (animal.poids || '') : '';
            el('animalRemarque').value = animal ? (animal.remarque || '') : '';
            if (animal && animal.vaccinAJour) {
                el('vaccinOui').checked = true;
            } else {
                el('vaccinNon').checked = true;
            }
        }

        function setActiveBtn(activeBtn) {
            selectorBtns.forEach(function(b) {
                b.classList.remove('btn-success', 'text-white');
                b.classList.add('btn-outline-secondary');
            });
            if (activeBtn) {
                activeBtn.classList.remove('btn-outline-secondary');
                activeBtn.classList.add('btn-success', 'text-white');
            }
        }

        selectorBtns.forEach(function(btn) {
            btn.replaceWith(btn.cloneNode(true));
        });
        selectorBtns = document.querySelectorAll('.animal-selector-btn');

        selectorBtns.forEach(function(btn) {
            btn.addEventListener('click', function() {
                var animalId = parseInt(btn.getAttribute('data-animal-id'));
                var animal = animalsData.find(function(a) { return a.id === animalId; });
                setActiveBtn(btn);
                fillForm(animal);
            });
        });

        if (newAnimalBtn) {
            newAnimalBtn.addEventListener('click', function() {
                setActiveBtn(null);
                fillForm(null);
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', function() {
                setActiveBtn(null);
                fillForm(null);
            });
        }
    }

    function setupAll() {
        setupCalendarSlots();
        setupAnimalSelector();

        // Sync selected slot into the form hidden field before submit
        var form = document.querySelector('form[action*="save-animal"]');
        if (form) {
            form.addEventListener('submit', function() {
                var slotInput = form.querySelector('input[name="_slot"]');
                var selectedSlotInput = document.getElementById('selectedSlotInput');
                if (slotInput && selectedSlotInput) {
                    slotInput.value = selectedSlotInput.value;
                }
            });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupAll);
    } else {
        setupAll();
    }
    document.addEventListener('turbo:load', setupAll);
</script>
{% endblock %}