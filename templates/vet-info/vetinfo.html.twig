{% extends 'base.html.twig' %}

{% block title %}MrVeto -
								Dr.
	{{ vet.prenom }}
	{{ vet.nom }}
{% endblock %}

{% block body %}
	<div
		class="container my-5">

		<!-- HEADER CARD -->
		<div class="row justify-content-center">
			<div class="col-lg-9">
				<div class="card border border-secondary shadow-sm mb-5 rounded-4 bg-white" style="border-width: 1.5px !important;">
					<div
						class="card-body p-4 p-md-5 d-flex flex-column flex-md-row gap-4">

						<!-- VET PHOTO -->
						<div class="flex-shrink-0 text-center text-md-start">
							<img src="https://ui-avatars.com/api/?name={{ vet.prenom }}+{{ vet.nom }}&background=random" alt="Dr. {{ vet.prenom }} {{ vet.nom }}" class="rounded-circle shadow-sm" style="width: 100px; height: 100px; object-fit: cover;">
						</div>

						<!-- VET INFO (Middle) -->
						<div class="flex-grow-1 d-flex flex-column justify-content-between text-center text-md-start gap-3">
							<div>
								<h1 class="h3 fw-medium mb-1 text-dark" style="letter-spacing: -0.5px;">Dr.
									{{ vet.prenom }}
									{{ vet.nom }}</h1>
								<div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 mb-3 mb-md-0">
									<a href="#" class="text-decoration-none fw-medium text-primary">
										{{ vet.adressecabinet }}
									</a>
								</div>
							</div>

							<!-- Badges -->
							<div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 mt-4 mt-md-0">
								{% if app.user is not null and app.user.id == vet.id %}
									<div class="d-flex align-items-center gap-2">
										<span class="small text-muted">Urgences 24h</span>
										<div class="form-check form-switch mb-0">
											<input class="form-check-input" type="checkbox" role="switch"
												id="urgentisteToggle"
												{{ vetProfile and vetProfile.isUrgentiste ? 'checked' : '' }}
												data-patch-url="{{ path('app_vet_profile_patch', {slug: vet.slug}) }}">
										</div>
									</div>
								{% elseif vetProfile and vetProfile.isUrgentiste %}
									<twig:Badge type="danger" text="Urgences"/>
								{% endif %}
							</div>
						</div>

						<!-- VET ACTIONS (Right) -->
						<div
							class="d-flex flex-column align-items-center align-items-md-end justify-content-center gap-3 flex-shrink-0 mt-3 mt-md-0">
							<!-- Fav Button -->
							<button class="btn btn-white btn-fav-hover rounded-pill border border-light fw-medium px-4 py-2 d-flex align-items-center gap-2 shadow-sm transition-hover hover-scale" style="color: #40A8A4;">
								<twig:ux:icon class="fs-5" name="lucide:heart"/>
								Ajouter aux favoris
							</button>

							<!-- Main Button -->
							<a href="{{ path('app_vet_book', {'slug': vet.slug}) }}" class="btn rounded-pill text-white fw-bold px-4 py-2 shadow-sm w-100 transition-hover hover-scale" style="background-color: #3ABBAC; border: none;">
								Prendre RDV
							</a>
						</div>

					</div>
				</div>
			</div>
		</div>

		<!-- MAIN CONTENT GRID -->
		<div
			class="row g-4">

		<!-- LEFT COLUMN (Main Info) -->
		<div class="col-lg-7">
			<div
				class="card border-0 shadow-sm p-4 p-md-5 h-100 rounded-4 bg-white"
				{% if app.user is not null and app.user.id == vet.id %}
					data-controller="vet-profile-edit"
					data-vet-profile-edit-patch-url-value="{{ path('app_vet_profile_patch', {slug: vet.slug}) }}"
				{% endif %}
			>

			{# ── Macros locales ──────────────────────────────────────────────── #}
			{% set isOwner = app.user is not null and app.user.id == vet.id %}
			{% set profile = vetProfile %}

			{# Options pour les SearchableSelect #}
			{% set optionsPaiement = [
				{value: 'cb',           label: 'Carte bancaire'},
				{value: 'especes',      label: 'Espèces'},
				{value: 'cheque',       label: 'Chèque'},
				{value: 'virement',     label: 'Virement bancaire'},
				{value: 'mutuelle',     label: 'Mutuelle animale'},
				{value: 'paypal',       label: 'PayPal'},
				{value: 'apple_pay',    label: 'Apple Pay'},
				{value: 'google_pay',   label: 'Google Pay'},
				{value: 'ticket_resto', label: 'Ticket restaurant'},
			] %}

			{% set optionsAnimaux = [
				{value: 'chien',      label: 'Chien',         category: 'Carnivores domestiques'},
				{value: 'chat',       label: 'Chat',           category: 'Carnivores domestiques'},
				{value: 'furet',      label: 'Furet',          category: 'Carnivores domestiques'},
				{value: 'lapin',      label: 'Lapin',          category: 'NAC – Petits mammifères / Rongeurs'},
				{value: 'cochon_inde',label: 'Cochon d\'Inde', category: 'NAC – Petits mammifères / Rongeurs'},
				{value: 'hamster',    label: 'Hamster',        category: 'NAC – Petits mammifères / Rongeurs'},
				{value: 'rat',        label: 'Rat',            category: 'NAC – Petits mammifères / Rongeurs'},
				{value: 'souris',     label: 'Souris',         category: 'NAC – Petits mammifères / Rongeurs'},
				{value: 'chinchilla', label: 'Chinchilla',     category: 'NAC – Petits mammifères / Rongeurs'},
				{value: 'perroquet',  label: 'Perroquet',      category: 'NAC – Oiseaux'},
				{value: 'perruche',   label: 'Perruche',       category: 'NAC – Oiseaux'},
				{value: 'poule',      label: 'Poule / Canard', category: 'NAC – Oiseaux'},
				{value: 'tortue',     label: 'Tortue',         category: 'NAC – Reptiles & Amphibiens'},
				{value: 'serpent',    label: 'Serpent',        category: 'NAC – Reptiles & Amphibiens'},
				{value: 'lezard',     label: 'Lézard',         category: 'NAC – Reptiles & Amphibiens'},
				{value: 'cheval',     label: 'Cheval',         category: 'Équidés'},
				{value: 'poney',      label: 'Poney',          category: 'Équidés'},
				{value: 'ane',        label: 'Âne',            category: 'Équidés'},
				{value: 'bovin',      label: 'Bovin',          category: 'Animaux ruraux'},
				{value: 'ovin',       label: 'Ovin',           category: 'Animaux ruraux'},
				{value: 'caprin',     label: 'Caprin',         category: 'Animaux ruraux'},
				{value: 'porcin',     label: 'Porcin',         category: 'Animaux ruraux'},
			] %}

			{% set optionsLangues = [
				{value: 'fr',  label: 'Français',    flag: '🇫🇷'},
				{value: 'en',  label: 'Anglais',     flag: '🇬🇧'},
				{value: 'es',  label: 'Espagnol',    flag: '🇪🇸'},
				{value: 'de',  label: 'Allemand',    flag: '🇩🇪'},
				{value: 'it',  label: 'Italien',     flag: '🇮🇹'},
				{value: 'pt',  label: 'Portugais',   flag: '🇵🇹'},
				{value: 'nl',  label: 'Néerlandais', flag: '🇳🇱'},
				{value: 'ar',  label: 'Arabe',       flag: '🇸🇦'},
				{value: 'zh',  label: 'Mandarin',    flag: '🇨🇳'},
				{value: 'ru',  label: 'Russe',       flag: '🇷🇺'},
				{value: 'pl',  label: 'Polonais',    flag: '🇵🇱'},
				{value: 'tr',  label: 'Turc',        flag: '🇹🇷'},
				{value: 'ro',  label: 'Roumain',     flag: '🇷🇴'},
				{value: 'uk',  label: 'Ukrainien',   flag: '🇺🇦'},
				{value: 'sv',  label: 'Suédois',     flag: '🇸🇪'},
				{value: 'da',  label: 'Danois',      flag: '🇩🇰'},
				{value: 'no',  label: 'Norvégien',   flag: '🇳🇴'},
				{value: 'fi',  label: 'Finnois',     flag: '🇫🇮'},
				{value: 'he',  label: 'Hébreu',      flag: '🇮🇱'},
				{value: 'fa',  label: 'Persan',      flag: '🇮🇷'},
				{value: 'ja',  label: 'Japonais',    flag: '🇯🇵'},
				{value: 'ko',  label: 'Coréen',      flag: '🇰🇷'},
				{value: 'hi',  label: 'Hindi',       flag: '🇮🇳'},
			] %}

			{% set optionsSpecialites = [
				{value: 'medecine_generale',         label: 'Médecine générale'},
				{value: 'vaccination_identif',       label: 'Vaccination et Identification'},
				{value: 'pediatrie',                 label: 'Pédiatrie vétérinaire'},
				{value: 'geriatrie',                 label: 'Gériatrie vétérinaire'},
				{value: 'chir_convenance',           label: 'Chirurgie de convenance'},
				{value: 'chir_tissus_mous',          label: 'Chirurgie des tissus mous'},
				{value: 'chir_orthopedique',         label: 'Chirurgie orthopédique et traumatologie'},
				{value: 'neurochirurgie',            label: 'Neurochirurgie'},
				{value: 'gastro_enterologie',        label: 'Gastro-entérologie'},
				{value: 'cardiologie',               label: 'Cardiologie'},
				{value: 'pneumologie',               label: 'Pneumologie'},
				{value: 'endocrinologie',            label: 'Endocrinologie'},
				{value: 'urologie_nephrologie',      label: 'Urologie et Néphrologie'},
				{value: 'oncologie',                 label: 'Oncologie / Cancérologie'},
				{value: 'hematologie_immunologie',   label: 'Hématologie et Immunologie'},
				{value: 'dermatologie',              label: 'Dermatologie'},
				{value: 'ophtalmologie',             label: 'Ophtalmologie'},
				{value: 'neurologie',                label: 'Neurologie'},
				{value: 'stomatologie_dentisterie',  label: 'Stomatologie et Dentisterie'},
				{value: 'imagerie_medicale',         label: 'Imagerie médicale'},
				{value: 'biologie_medicale',         label: 'Biologie médicale'},
				{value: 'medecine_comportement',     label: 'Médecine du comportement'},
				{value: 'physiotherapie',            label: 'Physiothérapie et Rééducation fonctionnelle'},
				{value: 'osteopathie',               label: 'Ostéopathie vétérinaire'},
				{value: 'nutrition',                 label: 'Nutrition et Diététique'},
				{value: 'nac',                       label: 'Médecine et chirurgie des NAC'},
				{value: 'equine',                    label: 'Médecine équine'},
				{value: 'theriogenologie',           label: 'Thériogénologie'},
			] %}

				{# ── À propos ─────────────────────────────────────────────── #}
				<div class="mb-5" data-vet-profile-edit-target="section" data-field="aPropos">

					<div class="d-flex align-items-center gap-2 mb-4">
						<h2 class="h4 fw-medium mb-0 text-dark" style="letter-spacing: -0.5px;">À propos</h2>
						{% if isOwner %}
							<button class="btn btn-sm btn-link text-muted p-0 ms-1 hover-scale" title="Modifier"
									data-action="click->vet-profile-edit#startEdit" data-field="aPropos">
								<twig:ux:icon name="lucide:pencil" class="fs-6"/>
							</button>
						{% endif %}
					</div>

					{# Affichage #}
					<div data-vet-profile-edit-target="display">
						<p class="text-dark lh-lg mb-0" style="font-size: 1.05rem;" data-display-content>
							{{ profile and profile.aPropos ? profile.aPropos : 'Aucune description renseignée.' }}
						</p>
					</div>

					{# Formulaire inline #}
					{% if isOwner %}
					<div data-vet-profile-edit-target="form" class="d-none">
						<textarea class="form-control mb-3" rows="5" data-edit-field
							placeholder="Décrivez votre pratique, votre expérience…">{{ profile and profile.aPropos ? profile.aPropos : '' }}</textarea>
						<div class="d-flex gap-2">
							<button class="btn btn-sm rounded-pill px-3 text-white" style="background-color: #36BDAF; border: none;" data-action="click->vet-profile-edit#save" data-field="aPropos">Enregistrer</button>
							<button class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-action="click->vet-profile-edit#cancel" data-field="aPropos">Annuler</button>
						</div>
					</div>
					{% endif %}
				</div>

				{# ── Spécialités ──────────────────────────────────────────── #}
				<div class="mb-5" data-vet-profile-edit-target="section" data-field="specialites">

					<div class="d-flex align-items-center gap-2 mb-4">
						<h2 class="h4 fw-medium mb-0 text-dark" style="letter-spacing: -0.5px;">Spécialités</h2>
						{% if isOwner %}
							<button class="btn btn-sm btn-link text-muted p-0 ms-1 hover-scale" title="Modifier"
									data-action="click->vet-profile-edit#startEdit" data-field="specialites">
								<twig:ux:icon name="lucide:pencil" class="fs-6"/>
							</button>
						{% endif %}
					</div>

					{# Affichage #}
					<div data-vet-profile-edit-target="display">
						<div class="d-flex flex-wrap gap-2" data-display-content data-display-type="tags">
							{% if profile and profile.specialites|length > 0 %}
								{% for s in profile.specialites %}
									<twig:Badge type="primary" text="{{ s.label }}"/>
								{% endfor %}
							{% else %}
								<span class="text-muted fst-italic">Non renseigné</span>
							{% endif %}
						</div>
					</div>

					{# Formulaire inline #}
					{% if isOwner %}
					<div data-vet-profile-edit-target="form" class="d-none">
						{% set selectedSlugs = [] %}
						{% if profile %}
							{% for s in profile.specialites %}
								{% set selectedSlugs = selectedSlugs|merge([s.slug]) %}
							{% endfor %}
						{% endif %}
						<twig:SearchableSelect
							name="specialites"
							:options="optionsSpecialites"
							:selected="selectedSlugs"
							:multiple="true"
							placeholder="Rechercher une spécialité…"
						/>
						<div class="d-flex gap-2 mt-3">
							<button class="btn btn-sm rounded-pill px-3 text-white" style="background-color: #36BDAF; border: none;" data-action="click->vet-profile-edit#save" data-field="specialites">Enregistrer</button>
							<button class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-action="click->vet-profile-edit#cancel" data-field="specialites">Annuler</button>
						</div>
					</div>
					{% endif %}
				</div>

				{# ── Détails ─────────────────────────────────────────────── #}
				<div class="vstack gap-4">

					{# Moyens de paiement #}
					<div data-vet-profile-edit-target="section" data-field="moyensPaiement">
						<div class="d-flex align-items-center gap-2 mb-2">
							<span class="h5 fw-medium mb-0 text-dark" style="letter-spacing: -0.3px;">Moyens de paiement</span>
							{% if isOwner %}
								<button class="btn btn-sm btn-link text-muted p-0 ms-1 hover-scale" title="Modifier"
										data-action="click->vet-profile-edit#startEdit" data-field="moyensPaiement">
									<twig:ux:icon name="lucide:pencil" class="fs-6"/>
								</button>
							{% endif %}
						</div>
						<div data-vet-profile-edit-target="display">
							<div class="d-flex flex-wrap gap-2" data-display-content data-display-type="tags">
								{% if profile and profile.moyensPaiement %}
									{% for val in profile.moyensPaiement %}
										{% set found = optionsPaiement|filter(o => o.value == val)|first %}
										<twig:Badge type="primary" text="{{ found ? found.label : val }}"/>
									{% endfor %}
								{% else %}
									<span class="text-muted fst-italic">Non renseigné</span>
								{% endif %}
							</div>
						</div>
						{% if isOwner %}
						<div data-vet-profile-edit-target="form" class="d-none mt-2">
							<twig:SearchableSelect
								name="moyensPaiement"
								:options="optionsPaiement"
								:selected="profile and profile.moyensPaiement ? profile.moyensPaiement : []"
								:multiple="true"
								placeholder="Sélectionner les moyens de paiement…"
							/>
							<div class="d-flex gap-2 mt-3">
								<button class="btn btn-sm rounded-pill px-3 text-white" style="background-color: #36BDAF; border: none;" data-action="click->vet-profile-edit#save" data-field="moyensPaiement">Enregistrer</button>
								<button class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-action="click->vet-profile-edit#cancel" data-field="moyensPaiement">Annuler</button>
							</div>
						</div>
						{% endif %}
					</div>

					{# Types d'animaux #}
					<div data-vet-profile-edit-target="section" data-field="animauxAcceptes">
						<div class="d-flex align-items-center gap-2 mb-2">
							<span class="h5 fw-medium mb-0 text-dark" style="letter-spacing: -0.3px;">Types d'animaux acceptés</span>
							{% if isOwner %}
								<button class="btn btn-sm btn-link text-muted p-0 ms-1 hover-scale" title="Modifier"
										data-action="click->vet-profile-edit#startEdit" data-field="animauxAcceptes">
									<twig:ux:icon name="lucide:pencil" class="fs-6"/>
								</button>
							{% endif %}
						</div>
						<div data-vet-profile-edit-target="display">
							<div class="d-flex flex-wrap gap-2" data-display-content data-display-type="tags">
								{% if profile and profile.animauxAcceptes %}
									{% for val in profile.animauxAcceptes %}
										{% set found = optionsAnimaux|filter(o => o.value == val)|first %}
										<twig:Badge type="primary" text="{{ found ? found.label : val }}"/>
									{% endfor %}
								{% else %}
									<span class="text-muted fst-italic">Non renseigné</span>
								{% endif %}
							</div>
						</div>
						{% if isOwner %}
						<div data-vet-profile-edit-target="form" class="d-none mt-2">
							<twig:SearchableSelect
								name="animauxAcceptes"
								:options="optionsAnimaux"
								:selected="profile and profile.animauxAcceptes ? profile.animauxAcceptes : []"
								:multiple="true"
								:allowCustom="true"
								placeholder="Rechercher ou ajouter une espèce…"
							/>
							<div class="d-flex gap-2 mt-3">
								<button class="btn btn-sm rounded-pill px-3 text-white" style="background-color: #36BDAF; border: none;" data-action="click->vet-profile-edit#save" data-field="animauxAcceptes">Enregistrer</button>
								<button class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-action="click->vet-profile-edit#cancel" data-field="animauxAcceptes">Annuler</button>
							</div>
						</div>
						{% endif %}
					</div>

					{# Durée moyenne #}
					<div data-vet-profile-edit-target="section" data-field="dureeConsultation">
						<div class="d-flex align-items-center gap-2 mb-2">
							<span class="h5 fw-medium mb-0 text-dark" style="letter-spacing: -0.3px;">Durée moyenne de consultation</span>
							{% if isOwner %}
								<button class="btn btn-sm btn-link text-muted p-0 ms-1 hover-scale" title="Modifier"
										data-action="click->vet-profile-edit#startEdit" data-field="dureeConsultation">
									<twig:ux:icon name="lucide:pencil" class="fs-6"/>
								</button>
							{% endif %}
						</div>
						<div data-vet-profile-edit-target="display">
							<span class="fw-normal" style="color: #40A8A4; font-size: 1.05rem;" data-display-content>
								{{ profile and profile.dureeConsultation ? profile.dureeConsultation : 'Non renseigné' }}
							</span>
						</div>
						{% if isOwner %}
						<div data-vet-profile-edit-target="form" class="d-none mt-2">
							<input type="text" class="form-control mb-3" data-edit-field
								placeholder="ex : 20 minutes"
								value="{{ profile and profile.dureeConsultation ? profile.dureeConsultation : '' }}">
							<div class="d-flex gap-2">
								<button class="btn btn-sm rounded-pill px-3 text-white" style="background-color: #36BDAF; border: none;" data-action="click->vet-profile-edit#save" data-field="dureeConsultation">Enregistrer</button>
								<button class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-action="click->vet-profile-edit#cancel" data-field="dureeConsultation">Annuler</button>
							</div>
						</div>
						{% endif %}
					</div>

					{# Langues parlées #}
					<div data-vet-profile-edit-target="section" data-field="langues">
						<div class="d-flex align-items-center gap-2 mb-2">
							<span class="h5 fw-medium mb-0 text-dark" style="letter-spacing: -0.3px;">Langues parlées</span>
							{% if isOwner %}
								<button class="btn btn-sm btn-link text-muted p-0 ms-1 hover-scale" title="Modifier"
										data-action="click->vet-profile-edit#startEdit" data-field="langues">
									<twig:ux:icon name="lucide:pencil" class="fs-6"/>
								</button>
							{% endif %}
						</div>
						<div data-vet-profile-edit-target="display">
							<div class="d-flex flex-wrap gap-2" data-display-content data-display-type="tags">
								{% if profile and profile.langues %}
									{% for val in profile.langues %}
										{% set found = optionsLangues|filter(o => o.value == val)|first %}
										{% if found %}
											<twig:Badge type="primary" text="{{ found.flag }} {{ found.label }}"/>
										{% else %}
											<twig:Badge type="primary" text="{{ val }}"/>
										{% endif %}
									{% endfor %}
								{% else %}
									<span class="text-muted fst-italic">Non renseigné</span>
								{% endif %}
							</div>
						</div>
						{% if isOwner %}
						<div data-vet-profile-edit-target="form" class="d-none mt-2">
							<twig:SearchableSelect
								name="langues"
								:options="optionsLangues"
								:selected="profile and profile.langues ? profile.langues : []"
								:multiple="true"
								placeholder="Rechercher une langue…"
							/>
							<div class="d-flex gap-2 mt-3">
								<button class="btn btn-sm rounded-pill px-3 text-white" style="background-color: #36BDAF; border: none;" data-action="click->vet-profile-edit#save" data-field="langues">Enregistrer</button>
								<button class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-action="click->vet-profile-edit#cancel" data-field="langues">Annuler</button>
							</div>
						</div>
						{% endif %}
					</div>

					</div>{# /vstack details #}

			</div>{# /card left column #}
		</div>{# /col-lg-7 #}

			<!-- RIGHT COLUMN (Widgets) -->
			<div class="col-lg-5">
				<div
					class="vstack gap-4">

					<!-- 1. CALENDAR CARD -->
					<div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
						<h2 class="h5 fw-medium mb-4 text-dark" style="letter-spacing: -0.3px;">Prochaines disponibilités</h2>
						<p class="small mb-3 {{ status.isOpen ? 'text-success' : 'text-danger' }}">
							{{ status.label }}
							•
							{{ status.detail }}
						</p>

						<div class="d-flex justify-content-between flex-grow-1 text-center gap-2">
							{% for day in weekAvailability %}
								{% if day.isAvailable %}
									<button
										type="button"
										data-day-offset="{{ day.dayOffset }}"
										class="day-availability-btn day-chip day-chip--available d-flex flex-column align-items-center rounded-3 px-2 py-2 border-0 text-decoration-none {{ day.isSelected ? 'day-chip--selected' : '' }}"
										style="min-width: 36px;"
									>
										<span class="day-chip__day fw-bold small mb-1" style="font-size: 0.8rem;">{{ day.shortDay }}</span>
										<span class="day-chip__number small fw-medium" style="font-size: 0.8rem;">{{ day.dayNumber }}</span>
									</button>
								{% else %}
									<button
										type="button"
										disabled
										class="day-chip day-chip--unavailable d-flex flex-column align-items-center rounded-3 px-2 py-2 border-0"
										style="min-width: 36px;"
									>
										<span class="day-chip__day fw-bold small mb-1" style="font-size: 0.8rem;">{{ day.shortDay }}</span>
										<span class="day-chip__number small fw-medium" style="font-size: 0.8rem;">{{ day.dayNumber }}</span>
									</button>
								{% endif %}
							{% endfor %}
						</div>
					</div>

					<!-- 2. HOURS CARD -->
					<div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
						<h2 id="hours-title" class="h5 fw-medium mb-4 text-dark" style="letter-spacing: -0.3px;">Horaires ({{ selectedDayDisplay|capitalize }})</h2>
						<div id="hours-slots" class="row row-cols-3 row-cols-sm-4 g-3">
							{% for slot in todaySlots %}
								<div class="col">
									<div class="hours-slot border rounded-3 text-center py-2 text-dark small fw-normal" style="border-color: #D1D5DB !important;">{{ slot.start }}</div>
								</div>
							{% else %}
								<div class="col-12">
									<div class="hours-slot border rounded-3 text-center py-2 text-muted small fw-normal" style="border-color: #D1D5DB !important;">Aucun creneau disponible aujourd'hui</div>
								</div>
							{% endfor %}
						</div>
					</div>

					<!-- 3. CONTACT CARD -->
					<div class="card border-0 shadow-sm p-4 rounded-4 position-relative bg-white">
						<div class="d-flex justify-content-between align-items-center mb-4">
							<h2 class="h5 fw-medium mb-0 text-dark" style="letter-spacing: -0.3px;">Contact</h2>
							<button class="btn btn-link text-muted p-0 text-decoration-none">
								<i class="bi bi-three-dots-vertical"></i>
							</button>
						</div>

						<div class="vstack gap-4">
							<div class="d-flex align-items-center gap-3">
								<div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; background-color: #EBF7F2;">
									<twig:ux:icon class="fs-6" name="lucide:phone" style="color: #40A8A4;"/>
								</div>
								<a href="tel:{{ vet.telephone }}" class="fw-normal text-decoration-none" style="color: #40A8A4;">{{ vet.telephone ? vet.telephone|format_phone : 'Non renseigné' }}</a>
							</div>

							<div class="d-flex align-items-center gap-3">
								<div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; background-color: #EBF7F2;">
									<twig:ux:icon class="fs-6" name="lucide:mail" style="color: #40A8A4;"/>
								</div>
								<a href="mailto:{{ vet.email }}" class="fw-normal text-decoration-none" style="color: #40A8A4;">{{ vet.email }}</a>
							</div>
						</div>
					</div>

				</div>
			</div>
		</div>
	</div>

	<style>
		/* Animations and Hover Effects from searchvet */
		.transition-hover {
			transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s, background-color 0.2s;
		}
		.transition-hover:hover {
			transform: translateY(-2px);
			box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1) !important;
		}

		/*.hover-scale {
			transition: transform 0.2s;
		}
		.hover-scale:hover {
			transform: scale(1.05);
		}*/

		.btn-fav-hover {
			transition: background-color 0.2s, color 0.2s, transform 0.2s, box-shadow 0.2s;
		}
		.btn-fav-hover:hover {
			background-color: var(--bs-primary) !important;
			color: white !important;
			border-color: var(--bs-primary) !important;
		}

		.day-chip {
			transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease, border-color 0.18s ease;
			border: 1px solid transparent;
		}

		.day-chip__day,
		.day-chip__number {
			transition: color 0.18s ease;
		}

		.day-chip--available {
			background-color: var(--bs-primary-bg);
			border-color: var(--bs-primary-border);
			cursor: pointer;
		}

		.day-chip--available .day-chip__day {
			color: var(--bs-primary-pressed);
		}

		.day-chip--available .day-chip__number {
			color: var(--bs-primary);
		}

		.day-chip--available:not(.day-chip--selected):hover {
			background-color: var(--bs-primary-focus);
			border-color: var(--bs-primary-hover);
			transform: translateY(-1px);
			box-shadow: 0 6px 16px rgba(var(--bs-primary-rgb), 0.2);
		}

		.day-chip--selected {
			background-color: var(--bs-primary);
			border-color: var(--bs-primary);
			box-shadow: 0 8px 18px rgba(var(--bs-primary-rgb), 0.32);
		}

		.day-chip--selected .day-chip__day,
		.day-chip--selected .day-chip__number {
			color: #FFFFFF;
		}

		.day-chip--unavailable {
			background-color: var(--bs-neutral-20);
			border-color: var(--bs-neutral-40);
			cursor: not-allowed;
			opacity: 0.65;
		}

		.day-chip--unavailable .day-chip__day,
		.day-chip--unavailable .day-chip__number {
			color: var(--bs-neutral-60);
		}

		.hours-slot {
			cursor: default;
			user-select: none;
			-webkit-user-select: none;
		}
	</style>

	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const slotsByOffset = {{ daySlotsByOffset|json_encode|raw }};
			const displaysByOffset = {{ dayDisplaysByOffset|json_encode|raw }};
			const dayButtons = Array.from(document.querySelectorAll('.day-availability-btn'));
			const slotsContainer = document.getElementById('hours-slots');
			const hoursTitle = document.getElementById('hours-title');

			if (!slotsContainer || !hoursTitle || dayButtons.length === 0) {
				return;
			}

			const renderSlots = (offset) => {
				const slots = slotsByOffset[offset] ?? [];
				const display = displaysByOffset[offset] ?? '';

				hoursTitle.textContent = `Horaires (${display.charAt(0).toUpperCase() + display.slice(1)})`;

				if (slots.length === 0) {
					slotsContainer.innerHTML = `
						<div class="col-12">
							<div class="hours-slot border rounded-3 text-center py-2 text-muted small fw-normal" style="border-color: #D1D5DB !important;">Aucun creneau disponible aujourd'hui</div>
						</div>
					`;
					return;
				}

				slotsContainer.innerHTML = slots.map((slot) => `
					<div class="col">
						<div class="hours-slot border rounded-3 text-center py-2 text-dark small fw-normal" style="border-color: #D1D5DB !important;">${slot.start}</div>
					</div>
				`).join('');
			};

			const setSelected = (selectedBtn) => {
				dayButtons.forEach((btn) => {
					btn.classList.remove('day-chip--selected');
				});
				selectedBtn.classList.add('day-chip--selected');
			};

			dayButtons.forEach((btn) => {
				btn.addEventListener('click', function () {
					const offset = this.dataset.dayOffset;
					setSelected(this);
					renderSlots(offset);
				});
			});
		});
	</script>

	<script>
		const urgentisteToggle = document.getElementById('urgentisteToggle');
		if (urgentisteToggle) {
			urgentisteToggle.addEventListener('change', function () {
				fetch(this.dataset.patchUrl, {
					method: 'PATCH',
					headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
					body: JSON.stringify({ field: 'isUrgentiste', value: this.checked }),
				}).then(() => location.reload());
			});
		}
	</script>
{% endblock %}
