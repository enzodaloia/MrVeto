{% extends 'base.html.twig' %}

{% block title %}MrVeto -
	{{ vet.name }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
	<style>:root
	{
		--primary-color: #6200ee;
		--secondary-color: #03dac6;
		--background-color: #f0f4f8; /* Light blueish gray from mock */
		--surface-color: #ffffff;
		--text-primary: #333;
		--text-secondary: #666;
		--accent-yellow: #ffeb3b;
		--border-radius: 20px; /* Reduced specific border radius */
		--shadow-soft: 0 4px 12px rgba(0, 0, 0, 0.05);
	}

	body {
		background-color: var(--background-color);
		font-family: 'Roboto', sans-serif;
		color: var(--text-primary);
	}

	.container {
		max-width: 1200px;
		margin: 2rem auto;
		padding: 0 1rem;
	}

	/* CARD STYLES */
	.card {
		background: var(--surface-color);
		border-radius: var(--border-radius);
		padding: 2rem;
		box-shadow: var(--shadow-soft);
		margin-bottom: 2rem;
	}

	/* HEADER CARD */
	.header-card {
		display: flex;
		align-items: center;
		gap: 2rem;
		position: relative;
		border: 1px solid #ffd700; /* Yellow border hint */
	}

	.vet-photo {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		object-fit: cover;
		border: 4px solid white;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
	}

	.vet-header-info {
		flex: 1;
	}

	.vet-header-info h1 {
		margin: 0;
		font-size: 1.8rem;
		font-weight: 700;
	}

	.vet-header-info p.title {
		margin: 0.5rem 0;
		color: var(--text-secondary);
		font-size: 1.1rem;
	}

	.vet-header-info .address {
		color: #2196f3; /* Blue address link color */
		font-size: 0.95rem;
		text-decoration: none;
	}

	.tags-row {
		display: flex;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.tag {
		background-color: #e3f2fd;
		color: var(--text-primary);
		padding: 0.4rem 1rem;
		border-radius: 20px;
		font-size: 0.85rem;
		font-weight: 500;
	}

	.tag.urgent {
		background-color: #e3f2fd; /* keeping same theme as mock */
	}

	/* Header Actions (Right side) */
	.header-actions {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: flex-end;
	}

	.btn-fav {
		background: white;
		border: 1px solid #e0e0e0;
		padding: 0.5rem 1rem;
		border-radius: 20px;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: #2196f3;
		cursor: pointer;
		font-weight: 500;
		text-decoration: none;
	}

	.btn-book-header {
		background-color: #26a69a; /* Teal color */
		color: white;
		border: none;
		padding: 0.8rem 2rem;
		border-radius: 25px;
		font-weight: 600;
		font-size: 1rem;
		cursor: pointer;
		box-shadow: 0 4px 6px rgba(38, 166, 154, 0.3);
		text-decoration: none;
	}

	/* LAYOUT GRID */
	.details-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 2rem;
	}

	/* LEFT COLUMN STYLES */
	.section-title {
		font-size: 1.4rem;
		font-weight: 600;
		margin-bottom: 1rem;
		color: var(--text-primary);
	}

	.text-content {
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 2rem;
	}

	.specialties-list {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
		margin-bottom: 2rem;
	}

	.specialty-tag {
		background-color: #fff9c4; /* Light yellow */
		padding: 0.5rem 1rem;
		border-radius: 15px;
		font-size: 0.9rem;
		color: #555;
	}

	.info-block {
		margin-bottom: 2rem;
	}

	.info-label {
		display: block;
		font-size: 1.2rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.info-value {
		color: #2196f3; /* Blue text */
		font-size: 1rem;
	}

	/* RIGHT COLUMN STYLES */
	.calendar-nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.5rem;
	}

	.calendar-days {
		display: flex;
		justify-content: space-between;
		text-align: center;
		margin-bottom: 1rem;
	}

	.day-col {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		align-items: center;
	}

	.day-name {
		font-weight: 700;
		font-size: 0.9rem;
	}
	.day-date {
		font-size: 0.9rem;
		color: var(--text-secondary);
	}

	.day-col.active .day-name,
	.day-col.active .day-date {
		color: #fbc02d; /* Yellow highlight */
	}

	.day-col.active .day-name {
		background-color: #fbc02d;
		color: black;
		border-radius: 5px;
		padding: 2px 5px;
	}

	.time-slots-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.time-slot {
		border: 1px solid #e0e0e0;
		border-radius: 10px;
		padding: 0.5rem;
		text-align: center;
		font-size: 0.9rem;
		cursor: pointer;
		background: white;
		transition: all 0.2s;
	}

	.time-slot:hover {
		border-color: #2196f3;
		color: #2196f3;
	}

	/* Contact Section */
	.contact-card {
		padding: 2rem;
	}

	.contact-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
		color: #2196f3;
	}

	.contact-icon {
		background-color: #e3f2fd;
		padding: 8px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.contact-dots {
		position: absolute;
		top: 2rem;
		right: 2rem;
		color: #999;
		cursor: pointer;
	}

	/* Responsive */
	@media(max-width: 900px) {
		.details-grid {
			grid-template-columns: 1fr;
		}
		.header-card {
			flex-direction: column;
			text-align: center;
			gap: 1.5rem;
		}
		.header-actions {
			width: 100%;
			align-items: stretch;
		}
		.tags-row {
			justify-content: center;
		}
	}
</style>{% endblock %}{% block body %}
<div
	class="container">

	<!-- HEADER -->
	<div class="card header-card">
		<img src="{{ vet.image }}" alt="{{ vet.name }}" class="vet-photo">

		<div class="vet-header-info">
			<h1>{{ vet.name }}</h1>
			<p class="title">{{ vet.title }}</p>
			<a href="#" class="address">{{ vet.address }}
				•
				{{ vet.distance }}</a>

			<div class="tags-row">
				<span class="tag">Prochain RDV : Demain à 14H30</span>
				<span class="tag urgent">Urgence</span>
				<span class="tag">Parking</span>
			</div>
		</div>

		<div class="header-actions">
			<button class="btn-fav">
				<span class="material-icons" style="font-size: 18px;">favorite_border</span>
				Ajouter aux favoris
			</button>
			<a href="#" class="btn-book-header">Voir / Prendre RDV</a>
		</div>
	</div>

	<!-- MAIN CONTENT GRID -->
	<div
		class="details-grid">

		<!-- LEFT COLUMN -->
		<div class="content-left">
			<div class="card">
				<h2 class="section-title">A propos</h2>
				<p class="text-content">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
				</p>

				<h2 class="section-title">Spécialités</h2>
				<div class="specialties-list">
					{% for spec in vet.specialties %}
						<span class="specialty-tag">{{ spec }}</span>
					{% endfor %}
					<span class="specialty-tag">Lorem</span>
				</div>

				<div class="info-block">
					<span class="info-label">Moyens de paiement</span>
					<span class="info-value">{{ vet.payment_methods }}</span>
				</div>

				<div class="info-block">
					<span class="info-label">Types d'animaux acceptés</span>
					<span class="info-value">{{ vet.animal_types }}</span>
				</div>

				<div class="info-block">
					<span class="info-label">Durée moyenne de consultation</span>
					<span class="info-value">{{ vet.consultation_duration }}</span>
				</div>

				<div class="info-block">
					<span class="info-label">Langues parlées</span>
					<span class="info-value">{{ vet.languages }}</span>
				</div>
			</div>
		</div>

		<!-- RIGHT COLUMN -->
		<div
			class="content-right">

			<!-- Availability Card -->
			<div class="card">
				<h2 class="section-title">Prochaines disponibilités</h2>

				<div class="calendar-nav">
					<span class="material-icons" style="color: #fbc02d; cursor: pointer;">chevron_left</span>

					<div class="calendar-days">
						<div class="day-col">
							<span class="day-name">Lun</span>
							<span class="day-date">1</span>
						</div>
						<div class="day-col">
							<span class="day-name">Mar</span>
							<span class="day-date">2</span>
						</div>
						<div class="day-col active">
							<span class="day-name">Mer</span>
							<span class="day-date">3</span>
						</div>
						<div class="day-col">
							<span class="day-name">Jeu</span>
							<span class="day-date">4</span>
						</div>
						<div class="day-col">
							<span class="day-name">Ven</span>
							<span class="day-date">5</span>
						</div>
						<!-- ... simplified -->
					</div>

					<span class="material-icons" style="color: #fbc02d; cursor: pointer;">chevron_right</span>
				</div>

				<!-- Fake Slots -->
				<h2 class="section-title" style="margin-top: 2rem;">Horaire</h2>
				<div class="time-slots-grid">
					<div class="time-slot">6:00</div>
					<div class="time-slot">13:00</div>
					<div class="time-slot">14:00</div>
					<div class="time-slot">15:30</div>
					<div class="time-slot">18:00</div>
					<div class="time-slot">19:00</div>
				</div>
			</div>

			<!-- Contact Card -->
			<div class="card contact-card" style="position: relative;">
				<h2 class="section-title">Contact</h2>
				<span class="material-icons contact-dots">more_vert</span>

				<div class="contact-row">
					<div class="contact-icon">
						<span class="material-icons" style="font-size: 18px; color: #2196f3;">call</span>
					</div>
					<span>{{ vet.phone }}</span>
				</div>

				<div class="contact-row">
					<div class="contact-icon">
						<span class="material-icons" style="font-size: 18px; color: #2196f3;">email</span>
					</div>
					<span>{{ vet.email }}</span>
				</div>
			</div>

		</div>
	</div>
</div>{% endblock %}
