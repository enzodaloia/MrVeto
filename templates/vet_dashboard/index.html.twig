{% extends 'base.html.twig' %}

{% block title %}Tableau de bord veterinaire - MrVeto{% endblock %}

{% block body %}
    <div class="p-3 p-lg-4">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
            <div>
                <h1 class="fw-black text-dark mb-1" style="font-weight: 900;">Tableau de bord veterinaire</h1>
                <p class="text-muted mb-0">Vos prochains rendez-vous et informations essentielles.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('app_gestion_rdv') }}" class="btn btn-primary text-white rounded-pill px-4">Gerer les RDV</a>
                <a href="{{ path('app_vet_patients') }}" class="btn btn-primary text-white rounded-pill px-4">Patients</a>
                <a href="{{ path('app_vet_cabinet_index') }}" class="btn btn-primary text-white rounded-pill px-4">Cabinets</a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-3 p-lg-4">
                        <h2 class="h5 fw-bold d-flex align-items-center gap-2 mb-3 text-neutral-100">
                            <i class="bi bi-calendar-event text-primary"></i>
                            Prochains rendez-vous
                        </h2>

                        {% if nextAppointments is empty %}
                            <div class="text-muted">Aucun rendez-vous à venir.</div>
                        {% else %}
                            <div class="d-flex flex-column gap-3">
                                {% for rdv in nextAppointments %}
                                    <div class="p-3 rounded-3 bg-neutral-20">
                                        <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                                            <div>
                                                <div class="fw-semibold text-neutral-100">{{ rdv.dateHeure|date('d M Y') }} à {{ rdv.dateHeure|date('H:i') }}</div>
                                                <div class="text-muted small">
                                                    {% if rdv.animal %}
                                                        {{ rdv.animal.nom }} ({{ rdv.animal.espece|default('Animal') }})
                                                    {% else %}
                                                        Animal non renseigne
                                                    {% endif %}
                                                </div>
                                                <div class="text-muted small">
                                                    {% if rdv.client %}
                                                        Client: {{ rdv.client.prenom|default('') }} {{ rdv.client.nom|default('') }}
                                                    {% else %}
                                                        Client non renseigne
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <div class="text-md-end">
                                                <span class="badge rounded-pill text-bg-warning bg-warning-bg text-warning">{{ rdv.statut|replace({'_': ' '})|upper }}</span>
                                                <div class="text-muted small mt-2">{{ rdv.motif|default('Consultation') }}</div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="h6 fw-bold d-flex align-items-center gap-2 mb-3 text-neutral-100">
                                    <i class="bi bi-clock-history text-primary"></i>
                                    RDV du jour
                                </h3>
                                {% if todayAppointments is empty %}
                                    <div class="text-muted">Aucun rendez-vous aujourd'hui.</div>
                                {% else %}
                                    <div class="d-flex flex-column gap-2">
                                        {% for rdv in todayAppointments %}
                                            <div class="d-flex justify-content-between">
                                                <span class="text-muted">{{ rdv.dateHeure|date('H:i') }}</span>
                                                <span class="fw-semibold text-neutral-100">
                                                    {% if rdv.animal %}
                                                        {{ rdv.animal.nom }}
                                                    {% else %}
                                                        Animal
                                                    {% endif %}
                                                </span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="h6 fw-bold d-flex align-items-center gap-2 mb-3 text-neutral-100">
                                    <i class="bi bi-person-check text-primary"></i>
                                    Patients à suivre
                                </h3>
                                {% if followUpVisits is empty %}
                                    <div class="text-muted">Aucun patient à suivre.</div>
                                {% else %}
                                    <div class="d-flex flex-column gap-2">
                                        {% for rdv in followUpVisits|slice(0, 2) %}
                                            <div>
                                                <div class="fw-semibold text-neutral-100">
                                                    {% if rdv.animal %}
                                                        {{ rdv.animal.nom }}
                                                    {% else %}
                                                        Animal non renseigne
                                                    {% endif %}
                                                </div>
                                                <div class="text-muted small">{{ rdv.remarque|default('Suivi recommande')|slice(0, 60) }}</div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="h6 fw-bold d-flex align-items-center gap-2 mb-3 text-neutral-100">
                                    <i class="bi bi-file-earmark-text text-primary"></i>
                                    Derniers comptes-rendus
                                </h3>
                                {% if recentVisits is empty %}
                                    <div class="text-muted">Aucun compte-rendu recent.</div>
                                {% else %}
                                    <div class="d-flex flex-column gap-2">
                                        {% for rdv in recentVisits %}
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div>
                                                    <div class="fw-semibold text-neutral-100">{{ rdv.motif|default('Consultation') }}</div>
                                                    <div class="text-muted small">
                                                        {% if rdv.animal %}
                                                            {{ rdv.animal.nom }}
                                                        {% else %}
                                                            Patient non renseigne
                                                        {% endif %}
                                                    </div>
                                                    <div class="text-muted small">{{ rdv.dateHeure|date('d M Y') }}</div>
                                                </div>
                                                {% if rdv.animal and rdv.animal.slug %}
                                                    <a href="{{ path('app_vet_patients_show', {slug: rdv.animal.slug}) }}" class="btn btn-sm btn-light">Voir</a>
                                                {% else %}
                                                    <span class="text-muted small">Voir</span>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="h6 fw-bold d-flex align-items-center gap-2 mb-3 text-neutral-100">
                                    <i class="bi bi-graph-down text-primary"></i>
                                    Taux d'annulation (30j)
                                </h3>
                                <div class="d-flex align-items-baseline gap-2">
                                    <div class="display-6 fw-bold text-neutral-100">{{ cancellationRate }}%</div>
                                    <div class="text-muted small">{{ cancelledRecent }}/{{ totalRecent }} RDV</div>
                                </div>
                                <div class="text-muted small mt-2">Base: 30 derniers jours</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-3 p-lg-4">
                        <h2 class="h5 fw-bold d-flex align-items-center gap-2 mb-3 text-neutral-100">
                            <i class="bi bi-clipboard-check text-primary"></i>
                            Resume rapide
                        </h2>
                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Prochain RDV</span>
                                <span class="fw-semibold text-neutral-100">
                                    {% if nextAppointments[0] is defined %}
                                        {{ nextAppointments[0].dateHeure|date('d M Y') }}
                                    {% else %}
                                        Aucun
                                    {% endif %}
                                </span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">RDV à venir</span>
                                <span class="fw-semibold text-neutral-100">{{ nextAppointments|length }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mt-3">
                    <div class="card-body p-3 p-lg-4">
                        <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-3 text-neutral-100">
                            <i class="bi bi-people text-primary"></i>
                            Equipe cabinet
                        </h2>
                        {% if cabinetUsers is empty %}
                            <div class="text-muted">Aucun membre associe.</div>
                        {% else %}
                            <div class="d-flex flex-column gap-2">
                                {% for member in cabinetUsers %}
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-neutral-100">{{ member.user.nom|default('') }} {{ member.user.prenom|default('') }}</span>
                                        {% if member.roleInCabinet == 'VETERINAIRE' %}
                                            <span class="badge rounded-pill px-3 py-2 bg-primary-bg text-primary">Veterinaire</span>
                                        {% elseif member.roleInCabinet == 'SECRETAIRE' %}
                                            <span class="badge rounded-pill px-3 py-2 bg-secondary-bg text-secondary">Secretaire</span>
                                        {% else %}
                                            <span class="badge rounded-pill px-3 py-2 bg-info-bg text-info">{{ member.roleInCabinet|lower }}</span>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
