{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - MrVeto{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('carnet_sante') }}
{% endblock %}

{% block body %}
    <div class="carnet-sante-page p-3 p-lg-4">
        <div class="container-fluid p-0">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
                <div>
                    <h1 class="fw-black text-dark mb-1" style="font-weight: 900;">Tableau de bord</h1>
                    <p class="text-muted mb-0">Toutes les metriques du carnet de sante, en un coup d'oeil</p>
                </div>
            </div>

            {% if animals is empty %}
                <div class="card border-0 shadow-sm">
                    <div class="card-body py-5 text-center">
                        <twig:ux:icon name="lucide:paw-print" class="display-5 text-primary mb-3"/>
                        <h2 class="h4 text-neutral-90 fw-bold mb-2">Aucun animal trouve</h2>
                        <p class="text-muted mb-0">Ajoutez un animal pour creer votre tableau de bord.</p>
                        <button
                            type="button"
                            class="btn btn-primary rounded-pill px-4 mt-4"
                            data-bs-toggle="modal"
                            data-bs-target="#carnetAnimalModal"
                        >
                            <i class="bi bi-plus-lg"></i>
                            Ajouter un animal
                        </button>
                    </div>
                </div>
            {% else %}
                <div class="cs-animal-tabs mb-4 d-flex align-items-center gap-2 overflow-auto hidden-scrollbar">
                    {% for animal in animals %}
                        {% set isActive = selectedAnimal and selectedAnimal.id == animal.id %}
                        <a
                            href="{{ animal.slug ? path('app_dashboard_animal', {slug: animal.slug}) : path('app_dashboard') }}"
                            class="btn btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 {{ isActive ? 'btn-light border border-primary-subtle text-neutral-100 fw-semibold' : 'btn-white border text-muted' }}"
                        >
                            {% if isActive %}
                                <span class="cs-online-dot"></span>
                            {% endif %}
                            {{ animal.nom }}
                            <span class="text-muted">({{ animal.espece|default('Animal') }})</span>
                        </a>
                    {% endfor %}
                    <button
                        type="button"
                        class="btn btn-sm btn-light rounded-circle border text-primary fw-bold"
                        aria-label="Ajouter un animal"
                        title="Ajouter un animal"
                        data-bs-toggle="modal"
                        data-bs-target="#carnetAnimalModal"
                    >+</button>
                </div>

                <div class="row g-4 align-items-start">
                    <div class="col-12">
                        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-3">
                            <div>
                                <div class="text-muted small">Bonjour,</div>
                                <h1 class="h3 fw-bold text-neutral-100 mb-1">
                                    {{ app.user.prenom|default(app.user.nom|default('')) }} !
                                </h1>
                                <div class="text-muted small">Voici les dernieres nouvelles concernant {{ selectedAnimal.nom }}.</div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="{{ path('app_search_vet') }}" class="btn btn-primary text-white rounded-pill px-4">Contacter le veterinaire</a>
                                <a href="{{ path('app_rendezvous') }}" class="btn btn-primary text-white rounded-pill px-4">Prendre rendez-vous</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-7">
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-body p-3 p-lg-4">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <img
                                            src="https://ui-avatars.com/api/?name={{ selectedAnimal.nom|url_encode }}&background=EBF4FC&color=36BDAF&bold=true&size=128"
                                            alt="{{ selectedAnimal.nom }}"
                                            class="rounded-circle border border-2 border-white shadow-sm"
                                            width="72"
                                            height="72"
                                        >
                                        <div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <h2 class="h5 fw-bold mb-0 text-neutral-100">{{ selectedAnimal.nom }}</h2>
                                                <span class="badge rounded-pill text-bg-primary bg-primary-bg text-primary fw-medium">
                                                    {{ selectedAnimal.race|default(selectedAnimal.espece|default('Animal de compagnie'))|upper }}
                                                </span>
                                            </div>
                                            <div class="mt-2 d-flex flex-wrap gap-3 text-muted small">
                                                <span class="d-inline-flex align-items-center gap-1">
                                                    <twig:ux:icon name="lucide:calendar" class="text-primary"/>
                                                    {{ selectedAnimal.age|default('Age inconnu') }}
                                                </span>
                                                <span class="d-inline-flex align-items-center gap-1">
                                                    <twig:ux:icon name="lucide:fingerprint" class="text-primary"/>
                                                    Puce : {{ ('2502687' ~ selectedAnimal.id ~ '345678')|slice(0, 15) }}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-center text-lg-start p-3 rounded-3 bg-neutral-20">
                                        <div class="text-uppercase small fw-bold text-muted mb-1">Derniere visite</div>
                                        {% if lastVisit %}
                                            <div class="fw-semibold text-neutral-90">{{ lastVisit.dateHeure|date('d M Y') }}</div>
                                        {% else %}
                                            <div class="fw-semibold text-neutral-90">Aucune</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-lg-6">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <twig:ux:icon name="lucide:calendar-check" class="text-primary"/>
                                            <div class="fw-semibold">Prochain rendez-vous</div>
                                        </div>
                                        {% if nextVisit %}
                                            <div class="text-muted small mb-1">Date & heure</div>
                                            <div class="fw-semibold text-neutral-100">{{ nextVisit.dateHeure|date('d M Y') }} a {{ nextVisit.dateHeure|date('H:i') }}</div>
                                            {% if nextVisit.veterinaire %}
                                                <div class="text-muted small mt-2">Veterinaire</div>
                                                <div class="fw-semibold text-neutral-90">Dr. {{ nextVisit.veterinaire.nom|default('') }}</div>
                                            {% endif %}
                                            <div class="text-muted small mt-2">Statut</div>
                                            <span class="badge rounded-pill text-bg-warning bg-warning-bg text-warning">{{ nextVisit.statut|replace({'_': ' '})|upper }}</span>
                                        {% else %}
                                            <div class="text-muted">Aucun rendez-vous a venir.</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <twig:ux:icon name="lucide:paw-print" class="text-primary"/>
                                            <div class="fw-semibold">Fiche animal</div>
                                        </div>
                                        <div class="text-muted small">Poids</div>
                                        <div class="fw-semibold text-neutral-100 mb-2">
                                            {{ selectedAnimal.poids|default('Non renseigne') }}{% if selectedAnimal.poids %} kg{% endif %}
                                        </div>
                                        <div class="text-muted small">Vaccination</div>
                                        <div class="fw-semibold {{ selectedAnimal.vaccinAJour ? 'text-success' : 'text-warning' }}">
                                            {{ selectedAnimal.vaccinAJour ? 'A jour' : 'A verifier' }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <twig:ux:icon name="lucide:file-text" class="text-primary"/>
                                            <div class="fw-semibold">Fiche d'identite</div>
                                        </div>
                                        <div class="row g-3">
                                            <div class="col-6 col-md-3">
                                                <div class="text-muted small">Age</div>
                                                <div class="fw-semibold text-neutral-100">{{ selectedAnimal.age|default('Non renseigne') }}</div>
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <div class="text-muted small">Espece</div>
                                                <div class="fw-semibold text-neutral-100">{{ selectedAnimal.espece|default('Non renseigne') }}</div>
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <div class="text-muted small">Race</div>
                                                <div class="fw-semibold text-neutral-100">{{ selectedAnimal.race|default('Non renseigne') }}</div>
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <div class="text-muted small">Puce</div>
                                                <div class="fw-semibold text-neutral-100">{{ ('2502687' ~ selectedAnimal.id ~ '345678')|slice(0, 15) }}</div>
                                            </div>
                                        </div>
                                        {% if lastVisit and lastVisit.remarque %}
                                            <div class="mt-3 text-muted small">Note recente: {{ lastVisit.remarque|slice(0, 120) }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-5">
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-body p-3 p-lg-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-0 text-neutral-100">
                                        <twig:ux:icon name="lucide:shield-check" class="text-primary"/>
                                        Suivi de prevention
                                    </h2>
                                    <span class="badge rounded-pill text-bg-light text-muted">Mis a jour: aujourd'hui</span>
                                </div>
                                <div class="mb-3">
                                    <div class="text-muted small">Prochain rappel global</div>
                                    <div class="fw-semibold text-neutral-100">
                                        {% if selectedAnimal.prochainVaccin %}
                                            {{ selectedAnimal.prochainVaccin|date('d/m/Y') }}
                                        {% else %}
                                            Non planifie
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted">Vaccinations</span>
                                    <span class="fw-semibold {{ selectedAnimal.vaccinAJour ? 'text-success' : 'text-warning' }}">
                                        {{ selectedAnimal.vaccinAJour ? 'A jour' : 'A verifier' }}
                                    </span>
                                </div>
                                <div class="small text-muted mb-3">
                                    {% if selectedAnimal.prochainVaccin %}
                                        Prochain rappel: {{ selectedAnimal.prochainVaccin|date('d M Y') }}
                                    {% else %}
                                        Aucun rappel planifie
                                    {% endif %}
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted">Consultations</span>
                                    <span class="fw-semibold text-neutral-100">{{ visitTotal }}</span>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-3 p-lg-4">
                                <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-3 text-neutral-100">
                                    <twig:ux:icon name="lucide:user-round" class="text-primary"/>
                                    Derniers veterinaires consultes
                                </h2>
                                {% if lastVets is empty %}
                                    <div class="text-muted">Aucun veterinaire recent.</div>
                                {% else %}
                                    <div class="d-flex flex-column gap-2">
                                        {% for vet in lastVets %}
                                            <div class="d-flex align-items-center justify-content-between">
                                                <span class="fw-semibold text-neutral-100">Dr. {{ vet.nom|default('') }}</span>
                                                <span class="text-muted small">{{ vet.prenom|default('') }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                    </div>

                </div>

                <div class="row g-4 mt-1">
                    <div class="col-12 col-xl-7">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-3 p-lg-4">
                                <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-3 text-neutral-100">
                                    <twig:ux:icon name="lucide:folder-open" class="text-primary"/>
                                    Mes documents & sante
                                </h2>
                                {% if recentVisits is empty %}
                                    <div class="text-muted">Aucun document disponible pour le moment.</div>
                                {% else %}
                                    <div class="d-flex flex-column gap-2">
                                        {% for visit in recentVisits %}
                                            <div class="d-flex align-items-center justify-content-between p-2 rounded bg-neutral-20">
                                                <div>
                                                    <div class="fw-semibold text-neutral-100">Compte-rendu de consultation</div>
                                                    <div class="text-muted small">{{ visit.dateHeure|date('d/m/Y') }}{% if visit.veterinaire %} - Dr. {{ visit.veterinaire.nom|default('') }}{% endif %}</div>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-light">Voir</button>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-5">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-3 p-lg-4">
                                <h2 class="h6 fw-bold d-flex align-items-center gap-2 mb-2 text-neutral-100">
                                    <twig:ux:icon name="lucide:book-open" class="text-primary"/>
                                    Bibliotheque de sante
                                </h2>
                                <p class="text-muted small mb-3">Accedez a tous vos documents medicaux et conseils personnalises.</p>
                                <a href="{{ path('app_carnet_sante') }}" class="btn btn-light rounded-pill">Voir la bibliotheque</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="modal fade" id="carnetAnimalModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content rounded-4 border-0 shadow-lg">
                    <div class="modal-header border-0 pb-0 px-4 pt-4">
                        <h2 class="h5 fw-bold mb-0 text-info-pressed">Ajouter un animal</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>

                    <div class="modal-body p-4 pt-3">
                        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                            <h3 class="h5 fw-bold mb-4 text-info-pressed">Completer la fiche animal</h3>

                            <form method="POST" action="{{ path('app_carnet_sante_save_animal') }}">
                                <input type="hidden" name="_returnSlug" value="{{ selectedAnimal and selectedAnimal.slug ? selectedAnimal.slug : '' }}">

                                <div class="row g-4 mb-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium text-primary">Nom de l'animal
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input
                                            type="text"
                                            name="animalNom"
                                            class="form-control rounded-pill border-light-subtle shadow-sm px-3"
                                            placeholder="Saisir le nom de l'animal"
                                            required
                                        >
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium text-primary">Espece
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input
                                            type="text"
                                            name="animalEspece"
                                            class="form-control rounded-pill border-light-subtle shadow-sm px-3"
                                            placeholder="Saisir le nom de l'espece"
                                            required
                                        >
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium text-primary">Age
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input
                                            type="text"
                                            name="animalAge"
                                            class="form-control rounded-pill border-light-subtle shadow-sm px-3"
                                            placeholder="(ex: 10 ans)"
                                            required
                                        >
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-medium text-primary d-block">Vaccin a jour</label>
                                        <div class="d-flex gap-4 mt-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="vaccin" value="oui" id="vaccinOuiDashboard">
                                                <label class="form-check-label text-neutral-60" for="vaccinOuiDashboard">Oui</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="vaccin" value="non" id="vaccinNonDashboard" checked>
                                                <label class="form-check-label text-neutral-60" for="vaccinNonDashboard">Non</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-medium text-primary">Race (optionnel)</label>
                                        <input
                                            type="text"
                                            name="animalRace"
                                            class="form-control rounded-pill border-light-subtle shadow-sm px-3"
                                            placeholder="Entrer race"
                                        >
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium text-primary">Poids (optionnel)</label>
                                        <input
                                            type="text"
                                            name="animalPoids"
                                            class="form-control rounded-pill border-light-subtle shadow-sm px-3"
                                            placeholder="(ex: 12 kg)"
                                        >
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap align-items-center gap-3">
                                    <button type="submit" class="btn btn-primary text-white rounded-pill px-4 py-2 fw-bold shadow-sm fs-6 border-0">Creer l'animal</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
