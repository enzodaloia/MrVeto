<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            {# <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script> #}
        {% endblock %}
    </head>
	<body>
        <nav class="navbar navbar-expand-lg navbar-light bg-warning-bg py-4 shadow-sm">
            <div class="container-fluid px-5">
                <a class="navbar-brand fw-bold text-dark" href="{{ path('app_home') }}"><img src="{{ asset('assets/img/MrVeto.png') }}" alt="Logo MrVeto" class="img-fluid" width="100"></a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-center" id="navbarContent">
                    <div class="bg-white rounded-pill px-4 py-2 shadow-sm d-flex gap-4 align-items-center">
                        <a class="nav-link text-muted hover-text-primary" href="{{ path('app_home') }}">Accueil</a>
                        <a class="nav-link text-muted hover-text-primary" href="{{path('app_search_vet')}}">Rechercher un vétérinaire</a>
                        <a class="nav-link text-muted hover-text-primary" href="#">Mes rendez-vous</a>
                        {% if app.user == null %}
                            <div class="dropdown">
                                <button class="btn dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                    S'inscrire
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                    <li><a class="dropdown-item" href="{{ path('app_register', {'type': 'veterinaire'}) }}">Vétérinaire</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_register', {'type': 'utilisateur'}) }}">Utilisateur</a></li>
                                </ul>
                            </div>
                            <a class="nav-link text-muted hover-text-primary" href="{{ path('app_login') }}">Me connecter</a>
                        {% endif %}
                        {% if app.user %}
                            <a class="nav-link text-muted hover-text-primary" href="#">Mes animaux</a>
                        {% endif %}
                    </div>
                </div>

                {% if app.user %}
                    <div class="d-flex align-items-center gap-4">
                        <a class="nav-link text-info fw-bold d-flex align-items-center gap-2" href="#">
                            Notifications
                        </a>
                        <i class="bi bi-bell"></i>


                        <div class="text-end lh-1">
                            <small class="text-primary d-block mb-1">Bonjour,</small>
                            <span class="fw-bold text-dark">{{ app.user.prenom }} {{ app.user.nom }}</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle overflow-hidden shadow-sm" style="width: 45px; height: 45px;">
                                <img src="https://ui-avatars.com/api/?name={{ app.user.prenom }}+{{ app.user.nom }}&background=random" class="w-100 h-100 object-fit-cover" alt="Avatar">
                            </div>
                            <a href="#" class="text-decoration-none text-dark dropdown-toggle"></a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </nav>
		{% block body %}{% endblock %}
	</body>
</html>
