{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
<div class="container-fluid d-flex flex-column p-0" style="background-color: #fff9f0;">

    <main class="d-flex justify-content-center align-items-center mt-5 pb-5" style="min-height: 85vh;">
        {{ form_start(registrationForm, {'attr': {'class': 'w-100', 'style': 'max-width: 800px;'}}) }}

            {% if type == 'veterinaire' %}
                <h1 class="mb-4" style="color: #36BDAF;">Créer un compte professionnel</h1>
                <h4 class="mb-4" style="color: #3688BD;">Informations personnelles</h4>
            {% else %}
                <h2 class="mb-4" style="color: #36BDAF;">Créer un compte</h2>
                <h4 class="mb-4" style="color: #3688BD;">Informations personnelles</h4>
            {% endif %}

            {{ form_errors(registrationForm) }}

            <div class="row">
                <!-- Nom -->
                <div class="col-md-6 mb-3 form-floating">
                    {{ form_widget(registrationForm.nom, {
                        'attr': {'class': 'form-control ps-4 pe-4', 'placeholder': 'Nom'}
                    }) }}
                    {{ form_label(registrationForm.nom, 'Nom', {
                        'label_attr': {'class': 'ps-4'}
                    }) }}
                </div>

                <!-- Prénom -->
                <div class="col-md-6 mb-3 form-floating">
                    {{ form_widget(registrationForm.prenom, {
                        'attr': {'class': 'form-control ps-4 pe-4', 'placeholder': 'Prénom'}
                    }) }}
                    {{ form_label(registrationForm.prenom, 'Prénom', {
                        'label_attr': {'class': 'ps-4'}
                    }) }}
                </div>
            </div>

            <div class="row">
                <!-- adresse -->
                <div class="col-md-4 mb-3 form-floating">
                    {{ form_widget(registrationForm.adresse, {
                        'attr': {'class': 'form-control ps-4 pe-4', 'placeholder': 'Adresse'}
                    }) }}
                    {{ form_label(registrationForm.adresse, 'Adresse', {
                        'label_attr': {'class': 'ps-4'}
                    }) }}
                </div>

                <!-- ville -->
                <div class="col-md-4 mb-3 form-floating">
                    {{ form_widget(registrationForm.ville, {
                        'attr': {'class': 'form-control ps-4 pe-4', 'placeholder': 'Ville'}
                    }) }}
                    {{ form_label(registrationForm.ville, 'Ville', {
                        'label_attr': {'class': 'ps-4'}
                    }) }}
                </div>

                <!-- code postal -->
                <div class="col-md-4 mb-3 form-floating">
                    {{ form_widget(registrationForm.codepostal, {
                        'attr': {'class': 'form-control ps-4 pe-4', 'placeholder': 'Code postal'}
                    }) }}
                    {{ form_label(registrationForm.codepostal, 'Code postal', {
                        'label_attr': {'class': 'ps-4'}
                    }) }}
                </div>
            </div>

            {% if type == 'veterinaire' %}
                <div class="row">
                    <!-- Email -->
                    <div class="col-md-6 mb-3 form-floating">
                        {{ form_widget(registrationForm.email, {
                            'attr': {'class': 'form-control ps-4 pe-4', 'placeholder': 'Adresse email'}
                        }) }}
                        {{ form_label(registrationForm.email, 'Adresse email', {
                            'label_attr': {'class': 'ps-4'}
                        }) }}
                    </div>

                    <!-- Téléphone -->
                    <div class="col-md-6 mb-3 form-floating">
                        {{ form_widget(registrationForm.telephone, {
                            'attr': {'class': 'form-control ps-4 pe-4', 'placeholder': 'Téléphone'}
                        }) }}
                        {{ form_label(registrationForm.telephone, 'Téléphone', {
                            'label_attr': {'class': 'ps-4'}
                        }) }}
                    </div>
                </div>
            {% else %}
                <div class="row">
                    <!-- Date de naissance -->
                    <div class="col-md-6 mb-3 form-floating">
                        {{ form_widget(registrationForm.datenaissance, {
                            'attr': {'class': 'form-control ps-4 pe-4', 'placeholder': 'Date de naissance'}
                        }) }}
                        {{ form_label(registrationForm.datenaissance, 'Date de naissance', {
                            'label_attr': {'class': 'ps-4'}
                        }) }}
                    </div>

                    <!-- Téléphone -->
                    <div class="col-md-6 mb-3 form-floating">
                        {{ form_widget(registrationForm.telephone, {
                            'attr': {'class': 'form-control ps-4 pe-4', 'placeholder': 'Téléphone'}
                        }) }}
                        {{ form_label(registrationForm.telephone, 'Téléphone', {
                            'label_attr': {'class': 'ps-4'}
                        }) }}
                    </div>
                </div>

                <!-- Email -->
                <div class="mb-3 form-floating">
                    {{ form_widget(registrationForm.email, {
                        'attr': {'class': 'form-control ps-4 pe-4', 'placeholder': 'Adresse email'}
                    }) }}
                    {{ form_label(registrationForm.email, 'Adresse email') }}
                </div>
            {% endif %}

            {% if type == 'veterinaire' %}
                <hr class="my-5">

                <h4 class="mb-4" style="color: #3688BD;">Informations professionnelles</h4>

                <!-- SIRET -->
                <div class="mb-3 form-floating">
                    {{ form_widget(registrationForm.siret, {
                        'attr': {'class': 'form-control ps-4 pe-4', 'placeholder': 'N° de Siret'}
                    }) }}
                    {{ form_label(registrationForm.siret, 'N° de Siret') }}
                </div>

                <!-- Adresse cabinet -->
                <div class="mb-3 form-floating">
                    {{ form_widget(registrationForm.adressecabinet, {
                        'attr': {'class': 'form-control ps-4 pe-4', 'placeholder': 'Adresse du cabinet'}
                    }) }}
                    {{ form_label(registrationForm.adressecabinet, 'Adresse du cabinet') }}
                </div>
            {% endif %}

            <!-- Mot de passe -->
            <div class="row mt-4">

                <div class="col-md-6 mb-3 form-floating">
                    {{ form_widget(registrationForm.plainPassword.first, {
                        'attr': {
                            'class': 'form-control ps-4 pe-4 ' ~ (registrationForm.plainPassword.first.vars.errors|length > 0 ? 'is-invalid' : ''),
                            'placeholder': 'Mot de passe'
                        }
                    }) }}
                    {{ form_label(registrationForm.plainPassword.first, 'Mot de passe', {
                        'label_attr': {'class': 'ps-4'}
                    }) }}

                    {% for error in registrationForm.plainPassword.first.vars.errors %}
                        <div class="invalid-feedback d-block">
                            {{ error.message }}
                        </div>
                    {% endfor %}
                </div>

                <div class="col-md-6 mb-3 form-floating">
                    {{ form_widget(registrationForm.plainPassword.second, {
                        'attr': {
                            'class': 'form-control ps-4 pe-4 ' ~ (registrationForm.plainPassword.second.vars.errors|length > 0 ? 'is-invalid' : ''),
                            'placeholder': 'Confirmation mot de passe'
                        }
                    }) }}
                    {{ form_label(registrationForm.plainPassword.second, 'Confirmation de mot de passe', {
                        'label_attr': {'class': 'ps-4'}
                    }) }}

                    {% for error in registrationForm.plainPassword.second.vars.errors %}
                        <div class="invalid-feedback d-block">
                            {{ error.message }}
                        </div>
                    {% endfor %}
                </div>

            </div>

            <!-- Conditions -->
            <div class="form-check mb-4">
                {{ form_widget(registrationForm.agreeTerms, {
                    'attr': {'class': 'form-check-input'}
                }) }}
                {{ form_label(registrationForm.agreeTerms, null, {
                    'label_attr': {'class': 'form-check-label'}
                }) }}
            </div>

            {{ form_rest(registrationForm) }}

            <!-- Boutons -->
            <div class="d-flex justify-content-center gap-4 mt-4">
                <a href="{{ path('app_login') }}" class="btn px-4" style="background-color:#C53B45; color:white; border-radius:30px;">
                    Annuler
                </a>
                <button type="submit" class="btn px-4" style="background-color:#36BDAF; color:white; border-radius:30px;">
                    Créer le compte
                </button>
            </div>

        {{ form_end(registrationForm) }}
    </main>
</div>
{% endblock %}
