 <script>
		function modalShowForm(role) {
			document.getElementById('modal-step-1').style.display = 'none';
			document.getElementById('modal-step-2').style.display = 'block';
			document.getElementById('modal-selected-role').value = role;
			document.querySelector('#createUserModal .modal-dialog').classList.add('modal-lg');

			const titles = {
				'ROLE_VETO': 'Créer un compte vétérinaire',
				'ROLE_ADMIN': 'Créer un compte administrateur',
				'ROLE_SECRETARY': 'Créer un compte secrétaire',
				'ROLE_USER': 'Créer un compte utilisateur'
			};
			document.getElementById('modal-title').textContent = titles[role] || 'Créer un compte';
			document.getElementById('modal-fields-veto').style.display = role === 'ROLE_VETO' ? 'block' : 'none';

			const rolesSelect = document.getElementById('modal-roles-select');
			Array.from(rolesSelect.options).forEach(opt => {
				opt.selected = opt.value === role;
			});

			const isAdminValidatedWrapper = document.getElementById('modal-is-admin-validated-wrapper');
const isAdminValidatedCheckbox = document.getElementById('modal-is-admin-validated');

// afficher uniquement pour veto
if (role === 'ROLE_VETO') {
    isAdminValidatedWrapper.style.display = 'block';
    isAdminValidatedCheckbox.checked = true;
} else {
    isAdminValidatedWrapper.style.display = 'none';
    isAdminValidatedCheckbox.checked = false;
}
		}

		function modalShowStep1() {
			document.getElementById('modal-step-1').style.display = 'block';
			document.getElementById('modal-step-2').style.display = 'none';
			document.getElementById('modal-title').textContent = 'Créer un compte';
			document.querySelector('#createUserModal .modal-dialog').classList.remove('modal-lg');
		}
	</script>

	 <script>
					document.addEventListener('DOMContentLoaded', function () {
						const searchDesktop = document.getElementById('search-input');
						const searchMobile = document.getElementById('search-input-mobile');
						const emptyTableRow = document.getElementById('empty-table-row');
						const emptyMobileRow = document.getElementById('empty-mobile-row');
			
						let activeRole = '';
						let activeStatus = '';
						let activeDate = '';
			
						function getSearchValue() {
							return (searchDesktop?.value || searchMobile?.value || '').toLowerCase();
						}
			
						function syncSearchInputs(source) {
							if (searchDesktop && source !== searchDesktop) {
								searchDesktop.value = source.value;
							}
							if (searchMobile && source !== searchMobile) {
								searchMobile.value = source.value;
							}
						}
			
						function getRows(selector) {
							return Array.from(document.querySelectorAll(selector));
						}
			
						function updateEmptyStates() {
							const desktopRows = getRows('#users-table-body .user-row');
							const mobileRows = getRows('#users-mobile-list .user-row');
			
							const visibleDesktop = desktopRows.filter(row => row.style.display !== 'none');
							const visibleMobile = mobileRows.filter(row => row.style.display !== 'none');
			
							if (emptyTableRow) {
								emptyTableRow.style.display = visibleDesktop.length === 0 ? '' : 'none';
							}
							if (emptyMobileRow) {
								emptyMobileRow.style.display = visibleMobile.length === 0 ? '' : 'none';
							}
						}
			
						function sortContainerRows(containerSelector) {
							if (!activeDate) return;
			
							const container = document.querySelector(containerSelector);
							if (!container) return;
			
							const rows = Array.from(container.querySelectorAll('.user-row'));
			
							rows.sort(function (a, b) {
								const dateA = new Date(a.dataset.date || '1900-01-01');
								const dateB = new Date(b.dataset.date || '1900-01-01');
								return activeDate === 'asc' ? dateA - dateB : dateB - dateA;
							});
			
							rows.forEach(row => container.appendChild(row));
						}
			
						function filterRows() {
							const search = getSearchValue();
			
							document.querySelectorAll('.user-row').forEach(function (row) {
								const matchSearch = ((row.dataset.nom || '') + ' ' + (row.dataset.email || '')).includes(search);
								const matchRole = !activeRole || (row.dataset.role && row.dataset.role.trim().includes(activeRole));
								const matchStatus =
		activeStatus === '' ||
		row.dataset.verified.trim() === activeStatus ||
		(activeStatus === '1' && row.dataset.verified === 'active');
			
								row.style.display = matchSearch && matchRole && matchStatus ? '' : 'none';
							});
			
							updateEmptyStates();
						}
			
						searchDesktop?.addEventListener('input', function () {
							syncSearchInputs(this);
							filterRows();
						});
			
						searchMobile?.addEventListener('input', function () {
							syncSearchInputs(this);
							filterRows();
						});
			
						document.querySelectorAll('.filter-role-item').forEach(function (item) {
							item.addEventListener('click', function (e) {
								e.preventDefault();
								activeRole = this.dataset.value;
								filterRows();
							});
						});
			
						document.querySelectorAll('.filter-status-item').forEach(function (item) {
							item.addEventListener('click', function (e) {
								e.preventDefault();
								activeStatus = this.dataset.value;
								filterRows();
							});
						});
			
						document.querySelectorAll('.filter-date-item').forEach(function (item) {
							item.addEventListener('click', function (e) {
								e.preventDefault();
								activeDate = this.dataset.value;
			
								if (activeDate) {
									sortContainerRows('#users-table-body');
									sortContainerRows('#users-mobile-list');
								}
			
								filterRows();
							});
						});
			
						filterRows();
					});
				</script>

	 <script>
					function bindUserShowButtons() {
						document.querySelectorAll('.btn-show-user').forEach(function (btn) {
							if (btn.dataset.showBound === '1') {
								return;
							}
							btn.dataset.showBound = '1';
							btn.addEventListener('click', function () {
								const url = this.getAttribute('data-url');
								const modalContent = document.getElementById('userModalContent');
			
								modalContent.innerHTML = `
									<div class="text-center py-5 text-muted">
										Chargement...
									</div>
								`;
			
								fetch(url)
									.then(response => response.text())
									.then(html => {
										const parser = new DOMParser();
										const doc = parser.parseFromString(html, 'text/html');
			
										const content = doc.querySelector('#user-show-content') || doc.querySelector('main .container-fluid') || doc.querySelector('.container-fluid');
										modalContent.innerHTML = content ? content.outerHTML : html;
			
										if (window.lucide) {
											lucide.createIcons({ icons: lucide.icons });
										}
									})
									.catch(() => {
										modalContent.innerHTML = `
											<div class="text-center py-5 text-danger">
												Erreur de chargement
											</div>
										`;
									});
							});
						});
					}

					document.addEventListener('DOMContentLoaded', bindUserShowButtons);
					document.addEventListener('turbo:load', bindUserShowButtons);
				</script>
{% endblock %}
