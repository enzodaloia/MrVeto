									<li>
										<a class="dropdown-item filter-role-item" href="#" data-value="role_user">Utilisateur</a>
									</li>
								</ul>
							</div>
						</div>

						<div class="col-12 col-md-4">
							<div class="dropdown">
								<button class="btn btn-outline-info rounded-pill px-3 d-inline-flex align-items-center justify-content-center gap-2 bg-white dropdown-toggle w-100" data-bs-toggle="dropdown">
									<i data-lucide="award" style="width:14px;height:14px;"></i>
									Status
								</button>
								<ul class="dropdown-menu w-100">
									<li>
										<a class="dropdown-item filter-status-item" href="#" data-value="">Tous</a>
