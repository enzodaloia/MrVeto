{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - MrVeto{% endblock %}

{% block body %}
	<style>
		.action-btn {
			color: var(--bs-primary);
			text-decoration: none;
		}
		.action-btn svg {
			width: 16px;
			height: 16px;
		}
		#search-input::placeholder,
		#search-input-mobile::placeholder {
			color: var(--bs-info);
			opacity: 1;
		}
			.user-name {
				min-width: 0;
			}
			.user-name-text {
				display: inline-block;
				max-width: 180px;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				vertical-align: bottom;
			}
			.filter-chip {
				background: #f6f8fb;
				border: 1px solid rgba(2, 62, 138, 0.12);
				color: #1f2a44;
				border-radius: 999px;
				padding: 0.25rem 0.6rem 0.25rem 0.75rem;
				font-weight: 600;
				font-size: 0.82rem;
				transition: all 0.15s ease-in-out;
			}
			.filter-chip:hover {
				background: #eef2f8;
			}
			.filter-chip i {
				margin-left: 0.4rem;
			}
			.filter-chip-clear {
				border-radius: 999px;
				padding: 0.2rem 0.65rem;
			}
	</style>

	<div class="container-fluid py-4 px-4 min-vh-100">
		<div class="mx-auto" style="max-width: 1200px;">
			<h1 class="visually-hidden">Gestion des utilisateurs</h1>

			{% for message in app.flashes('success') %}
				<div class="alert alert-success rounded-3 border-0 shadow-sm mb-3">{{ message }}</div>
			{% endfor %}

			<div class="d-none d-lg-block">
				<div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
					<div class="input-group rounded-pill overflow-hidden border border-info bg-white" style="max-width:320px;">
						<span class="input-group-text bg-white border-0">
							<i data-lucide="search" style="width:15px;height:15px;" class="text-info" aria-hidden="true"></i>
						</span>
						<label for="search-input" class="visually-hidden">Rechercher par mail ou nom</label>
						<input type="text" id="search-input" class="form-control border-0 shadow-none text-info" placeholder="Rechercher par mail/ nom">
					</div>

					<div class="dropdown">
						<button class="btn btn-outline-info rounded-pill px-3 d-inline-flex align-items-center gap-2 bg-white dropdown-toggle" data-bs-toggle="dropdown">
							<i data-lucide="user" style="width:14px;height:14px;"></i>
							Rôle
						</button>
						<ul class="dropdown-menu">
							<li>
								<a class="dropdown-item filter-role-item" href="#" data-value="">Tous</a>
							</li>
							<li>
								<a class="dropdown-item filter-role-item" href="#" data-value="role_admin">Admin</a>
							</li>
							<li>
								<a class="dropdown-item filter-role-item" href="#" data-value="role_secretary">Secrétaire</a>
							</li>
							<li>
								<a class="dropdown-item filter-role-item" href="#" data-value="role_veto">Vétérinaire</a>
							</li>
							<li>
								<a class="dropdown-item filter-role-item" href="#" data-value="role_user">Utilisateur</a>
							</li>
						</ul>
					</div>

					<div class="dropdown">
						<button class="btn btn-outline-info rounded-pill px-3 d-inline-flex align-items-center gap-2 bg-white dropdown-toggle" data-bs-toggle="dropdown">
							<i data-lucide="award" style="width:14px;height:14px;"></i>
							Status
						</button>
						<ul class="dropdown-menu">
							<li>
								<a class="dropdown-item filter-status-item" href="#" data-value="">Tous</a>
							</li>
							<li>
								<a class="dropdown-item filter-status-item" href="#" data-value="active">Actif</a>
							</li>
							<li>
								<a class="dropdown-item filter-status-item" href="#" data-value="1">Validé admin</a>
							</li>
							<li>
								<a class="dropdown-item filter-status-item" href="#" data-value="0">En attente admin</a>
							</li>
						</ul>
					</div>

					<div class="dropdown">
						<button class="btn btn-outline-info rounded-pill px-3 d-inline-flex align-items-center gap-2 bg-white dropdown-toggle" data-bs-toggle="dropdown">
							<i data-lucide="calendar" style="width:14px;height:14px;"></i>
							Date d'inscription
						</button>
						<ul class="dropdown-menu">
							<li>
								<a class="dropdown-item filter-date-item" href="#" data-value="">Tous</a>
							</li>
							<li>
								<a class="dropdown-item filter-date-item" href="#" data-value="asc">Plus ancien</a>
							</li>
							<li>
								<a class="dropdown-item filter-date-item" href="#" data-value="desc">Plus récent</a>
							</li>
						</ul>
					</div>

					<button type="button" class="btn btn-primary text-white rounded-pill px-4 fw-semibold ms-auto d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createUserModal">
						<i data-lucide="plus" style="width:15px;height:15px;"></i>
						Créer un utilisateur
					</button>
				</div>

				<div id="active-filters" class="d-flex align-items-center flex-wrap gap-2 mb-3"></div>

				<div class="bg-white rounded-4 shadow-sm overflow-hidden">
					<table class="table align-middle mb-0" style="--bs-table-bg: transparent;">
						<thead class="border-bottom">
							<tr class="text-primary fw-bold small">

								<th class="py-3" style="width:250px">Nom
								</th>
								<th class="py-3">Adresse email
								</th>
								<th class="py-3">Status
								</th>
								<th class="py-3">Role
								</th>
								<th class="py-3">Date inscription
								</th>
								<th class="py-3 text-center pe-4">Actions
								</th>
							</tr>
						</thead>
						<tbody id="users-table-body">
							{% for user in users %}
								<tr class="user-row border-bottom" data-nom="{{ user.nom|lower }} {{ user.prenom|lower }}" data-email="{{ user.email|lower }}" data-role="{% if 'ROLE_ADMIN' in user.roles %}role_admin{% elseif 'ROLE_SECRETARY' in user.roles or 'ROLE_SECRETAIRE' in user.roles %}role_secretary{% elseif 'ROLE_VETO' in user.roles %}role_veto{% else %}role_user{% endif %}" data-verified="
																																																																								{% if 'ROLE_VETO' in user.roles %}
																																																																									{{ user.isVerified ? '1' : '0' }}
																																																																								{% else %}
																																																																									active
																																																																								{% endif %}
																																																				" data-date="{{ user.createdAt ? user.createdAt|date('Y-m-d') : '' }}">


									<td>
										{% set colors = [
    'bg-primary',
    'bg-success',
    'bg-danger',
    'bg-warning',
    'bg-info',
    'bg-secondary'
] %}

										{% set color = colors[user.id % colors|length] %}

										<div class="d-flex align-items-center gap-2 user-name">
											<div class="d-flex align-items-center justify-content-center rounded-circle {{ color }} text-white" style="width:24px;height:24px;font-size:0.6rem;font-weight:700;flex-shrink:0;">
												{{ user.prenom|first|upper }}{{ user.nom|first|upper }}
											</div>

											<span class="fw-medium fs-6 user-name-text" title="{{ user.prenom }} {{ user.nom }}">
												{{ user.prenom }}
												{{ user.nom }}
											</span>
										</div>
									</td>

									<td class="text-muted">{{ user.email }}</td>

									<td>
										{% if 'ROLE_VETO' in user.roles %}
											{% if user.isVerified %}
												<span class="badge rounded-pill px-3 py-2 bg-primary text-white" style="font-size:0.72rem;">Validé admin</span>
											{% else %}
												<span class="badge rounded-pill px-3 py-2 bg-warning text-white" style="font-size:0.72rem;">En attente admin</span>
											{% endif %}
										{% else %}
											<span class="badge rounded-pill px-3 py-2 bg-info text-white" style="font-size:0.72rem;">Actif</span>
										{% endif %}
									</td>

									<td>
										{% if 'ROLE_ADMIN' in user.roles %}
											<span class="badge rounded-pill px-3 py-2 bg-danger-bg text-danger">Admin</span>

										{% elseif 'ROLE_VETO' in user.roles %}
											<span class="badge rounded-pill px-3 py-2 bg-primary-bg text-primary ">Vétérinaire</span>
										{% elseif 'ROLE_SECRETARY' in user.roles or 'ROLE_SECRETAIRE' in user.roles %}
											<span class="badge rounded-pill px-3 py-2 bg-secondary-bg text-secondary ">Secrétaire</span>

										{% else %}
											<span class="badge rounded-pill px-3 py-2 bg-info-bg text-info">
												Utilisateur
											</span>
										{% endif %}
									</td>

									<td class="text-muted">
										{{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}
									</td>

									<td class="text-end pe-4">
										<div class="d-flex align-items-center justify-content-end gap-3 flex-nowrap">
											<button type="button" class="action-btn btn btn-link p-0 btn-show-user" style="cursor:pointer;" data-bs-toggle="modal" data-bs-target="#userModal" data-url="{{ path('app_user_admin_show', {'slug': user.slug}) }}" aria-label="Voir l'utilisateur">
												<i data-lucide="eye" aria-hidden="true"></i>
											</button>
											<a href="{{ path('app_user_admin_edit', {'slug': user.slug}) }}" class="action-btn btn btn-link p-0 text-info" style="cursor:pointer;" data-turbo="false" aria-label="Modifier l'utilisateur">
												<i data-lucide="pencil" aria-hidden="true"></i>
											</a>

											{{ include('user_admin/_delete_form.html.twig', { prefix: 'desktop' }) }}
									</td>
								</tr>
							{% else %}
								<tr id="empty-table-row">
									<td colspan="7" class="text-center text-muted py-5">Aucun utilisateur trouvé</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>

			<div class="d-lg-none">
				<div class="d-flex flex-column gap-2 mb-4">
					<div class="input-group rounded-pill overflow-hidden border border-info bg-white">
						<span class="input-group-text bg-white border-0">
							<i data-lucide="search" style="width:15px;height:15px;" class="text-info" aria-hidden="true"></i>
						</span>
						<label for="search-input-mobile" class="visually-hidden">Rechercher par mail ou nom (mobile)</label>
