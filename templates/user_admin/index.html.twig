										<a class="dropdown-item filter-status-item" href="#" data-value="0">En attente admin</a>
									</li>
								</ul>
							</div>
						</div>

						<div class="col-12 col-md-4">
							<div class="dropdown">
								<button class="btn btn-outline-info rounded-pill px-3 d-inline-flex align-items-center justify-content-center gap-2 bg-white dropdown-toggle w-100" data-bs-toggle="dropdown">
									<i data-lucide="calendar" style="width:14px;height:14px;"></i>
									Date d'inscription
								</button>
								<ul class="dropdown-menu w-100">
									<li>
										<a class="dropdown-item filter-date-item" href="#" data-value="">Tous</a>
									</li>
									<li>
										<a class="dropdown-item filter-date-item" href="#" data-value="asc">Plus ancien</a>
									</li>
									<li>
										<a class="dropdown-item filter-date-item" href="#" data-value="desc">Plus récent</a>
									</li>
								</ul>
							</div>
						</div>
					</div>

					<button type="button" class="btn btn-primary text-white rounded-pill px-4 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 w-100" data-bs-toggle="modal" data-bs-target="#createUserModal">
						<i data-lucide="plus" style="width:15px;height:15px;"></i>
						Créer un utilisateur
					</button>
				</div>

				<div id="active-filters-mobile" class="d-flex align-items-center flex-wrap gap-2 mb-3"></div>

				<div id="users-mobile-list">
					{% for user in users %}
						<div class="user-row bg-white rounded-4 shadow-sm p-3 mb-3" data-nom="{{ user.nom|lower }} {{ user.prenom|lower }}" data-email="{{ user.email|lower }}" data-role="{% if 'ROLE_ADMIN' in user.roles %}role_admin{% elseif 'ROLE_SECRETARY' in user.roles or 'ROLE_SECRETAIRE' in user.roles %}role_secretary{% elseif 'ROLE_VETO' in user.roles %}role_veto{% else %}role_user{% endif %}" data-verified="
