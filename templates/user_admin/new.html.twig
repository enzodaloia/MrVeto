<style>
	#modal-step-1 .btn-outline-primary:hover {
		background-color: var(--bs-primary-hover);
		border-color: var(--bs-primary-hover);
		color: white;
	}
	#modal-step-1 .btn-outline-primary:focus {
		background-color: var(--bs-primary-focus);
		border-color: var(--bs-primary-focus);
		color: white;
		box-shadow: 0 0 0 0.25rem var(--bs-primary-focus);
	}
	#modal-step-1 .btn-outline-primary:active {
		background-color: var(--bs-primary-pressed);
		border-color: var(--bs-primary-pressed);
		color: white;
	}
</style>
<div class="modal fade" id="createUserModal" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content rounded-4 border-0 shadow-sm overflow-hidden">
			<div class="modal-header border-0 px-4 pt-4 pb-2 position-relative">

				<h5 class="modal-title fw-semibold text-primary position-absolute start-50 translate-middle-x mb-0" id="modal-title">
					Créer un compte
				</h5>

				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>

			</div>
			<div
				class="modal-body px-4 pb-4 pt-2">

				{# Étape 1 #}
				<div id="modal-step-1">
					<p class=" small text-muted mb-4 text-center">Quel type de compte souhaitez-vous créer ?</p>
					<div class="row g-3">
						<div class="col-12 col-sm-6">
							<button type="button" class="btn btn-outline-primary rounded-3 p-3 text-start w-100 h-100" onclick="modalShowForm('ROLE_VETO')">
								<span class="d-flex align-items-start gap-3">
									<i class="bi bi-heart-pulse fs-5"></i>
									<span>
										<span class="d-block fw-semibold">Vétérinaire</span>
										<span class="d-block small text-muted">Compte professionnel du cabinet</span>
									</span>
								</span>
							</button>
						</div>
						<div class="col-12 col-sm-6">
							<button type="button" class="btn btn-outline-primary rounded-3 p-3 text-start w-100 h-100" onclick="modalShowForm('ROLE_ADMIN')">
								<span class="d-flex align-items-start gap-3">
									<i class="bi bi-shield-lock fs-5"></i>
									<span>
										<span class="d-block fw-semibold">Administrateur</span>
										<span class="d-block small text-muted">Accès à la gestion admin</span>
									</span>
								</span>
							</button>
						</div>
						<div class="col-12 col-sm-6">
							<button type="button" class="btn btn-outline-primary rounded-3 p-3 text-start w-100 h-100" onclick="modalShowForm('ROLE_SECRETARY')">
								<span class="d-flex align-items-start gap-3">
									<i class="bi bi-calendar-check fs-5"></i>
									<span>
										<span class="d-block fw-semibold">Secrétaire</span>
										<span class="d-block small text-muted">Gestion des horaires du cabinet</span>
									</span>
								</span>
							</button>
						</div>
						<div class="col-12 col-sm-6">
							<button type="button" class="btn btn-outline-primary rounded-3 p-3 text-start w-100 h-100" onclick="modalShowForm('ROLE_USER')">
								<span class="d-flex align-items-start gap-3">
									<i class="bi bi-person fs-5"></i>
									<span>
										<span class="d-block fw-semibold">Utilisateur</span>
										<span class="d-block small text-muted">Compte client standard</span>
									</span>
								</span>
							</button>
						</div>
					</div>
				</div>

				{# Étape 2 #}
				<div id="modal-step-2" style="display:none;">
					<button type="button" class="btn btn-link text-muted text-decoration-none p-0 mb-3 d-inline-flex align-items-center gap-2" onclick="modalShowStep1()">
						<i class="bi bi-arrow-left"></i>
						Retour
					</button>

					{{ form_start(form, {'action': path('app_user_admin_new'), 'attr': {'data-turbo': 'false'}}) }}
					<input type="hidden" name="selected_role" id="modal-selected-role">

					<div class="mb-4">
						<h6 class="fw-semibold text-primary mb-1">Informations du compte</h6>
						<p class="text-muted small mb-0">Renseignez les informations nécessaires à la création du compte.</p>
					</div>

					<div class="bg-info-bg border rounded-3 p-3 mb-3">
						<h6 class="fw-semibold text-primary mb-3">Informations personnelles</h6>
						<div class="row g-3">
							<div class="col-md-6">
								<label class="form-label text-muted small fw-semibold">Nom</label>
								<input type="text" name="user_admin[nom]" class="form-control rounded-3" required>
							</div>
							<div class="col-md-6">
								<label class="form-label text-muted small fw-semibold">Prénom</label>
								<input type="text" name="user_admin[prenom]" class="form-control rounded-3" required>
							</div>
							<div class="col-md-6">
								<label class="form-label text-muted small fw-semibold">Date de naissance</label>
								<input type="date" name="user_admin[datenaissance]" class="form-control rounded-3" required max="{{ '-18 years'|date('Y-m-d') }}">
							</div>
						</div>
					</div>

					<div class="bg-info-bg border rounded-3 p-3 mb-3">
						<h6 class="fw-semibold text-primary mb-3">Coordonnées</h6>
						<div class="row g-3">
							<div class="col-12">
								<label class="form-label text-muted small fw-semibold">Adresse email</label>
								<input type="email" name="user_admin[email]" class="form-control rounded-3" placeholder="john.doe@gmail.com" required>
							</div>
							<div class="col-md-6">
								<label class="form-label text-muted small fw-semibold">Téléphone</label>
								<input type="text" name="user_admin[telephone]" class="form-control rounded-3" data-controller="phone-input" data-action="input->phone-input#format">
							</div>
							<div class="col-md-6">
								<label class="form-label text-muted small fw-semibold">Ville</label>
								<input type="text" name="user_admin[ville]" class="form-control rounded-3">
							</div>
							<div class="col-12">
								<label class="form-label text-muted small fw-semibold">Adresse postale</label>
								<input type="text" name="user_admin[adresse]" class="form-control rounded-3">
							</div>
						</div>
					</div>

					<div id="modal-fields-veto" style="display:none;">
						<div class="bg-info-bg border rounded-3 p-3 mb-3">
							<h6 class="fw-semibold text-primary mb-3">Informations professionnelles</h6>
							<div class="row g-3">
								<div class="col-12">
									<label class="form-label text-muted small fw-semibold">N° de Siret</label>
									<input type="text" name="user_admin[siret]" id="modal-siret" class="form-control rounded-3">
								</div>
								<div class="col-12" data-controller="autocomplete-address" data-autocomplete-address-theme-value="form">
									<div class="row g-3">
										<div class="col-12">
											<label class="form-label text-muted small fw-semibold">Adresse cabinet</label>
											<div class="position-relative">
												<input type="text" name="user_admin[adressecabinet]" id="modal-adressecabinet" class="form-control rounded-3" data-autocomplete-address-target="input" data-action="input->autocomplete-address#search" autocomplete="off">
												<div data-autocomplete-address-target="results" class="position-absolute start-0 end-0 top-100 z-3"></div>
											</div>
										</div>
										<div class="col-md-6">
											<label class="form-label text-muted small fw-semibold">Code postal</label>
											<input type="text" name="user_admin[codepostal]" id="modal-codepostal" class="form-control rounded-3" data-autocomplete-address-target="postcode" readonly>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="bg-info-bg border rounded-3 p-3 mb-3">
						<h6 class="fw-semibold text-primary mb-3">Accès</h6>
						<div class="row g-3">
							<div class="col-12">
								<div class="small text-muted">Un email d’invitation sera envoyé pour permettre à l’utilisateur de définir son mot de passe.</div>
							</div>
							<div class="col-12" id="modal-is-verified-wrapper" style="display:none;">
								<div class="form-check">
									<input type="checkbox" name="user_admin[isVerified]" id="modal-is-verified" class="form-check-input" value="1">
									<label class="form-check-label text-muted small fw-semibold">Compte vétérinaire validé par l’admin</label>
								</div>
							</div>
						</div>
					</div>

					<select name="user_admin[roles]" id="modal-roles-select" class="d-none">
						<option value="ROLE_USER">Utilisateur</option>
						<option value="ROLE_SECRETARY">Secrétaire</option>
						<option value="ROLE_VETO">Vétérinaire</option>
						<option value="ROLE_ADMIN">Admin</option>
					</select>

					<div class="d-flex justify-content-end gap-2 mt-4">
						<button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
							Annuler
						</button>
						<button type="submit" class="btn btn-primary px-4 text-white">
							Créer le compte
						</button>
					</div>
					{{ form_widget(form._token) }}
					{{ form_end(form, { render_rest: false }) }}
				</div>

			</div>
		</div>
	</div>
</div>
