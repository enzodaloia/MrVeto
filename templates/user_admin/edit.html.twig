{% extends 'base_dashboard.html.twig' %}

{% block title %}Modifier {{ user.prenom }} {{ user.nom }}{% endblock %}

{% block dashboard_body %}
<div class="container-fluid py-4 px-4 bg-primary-bg min-vh-100">
    <div class="mx-auto" style="max-width: 900px;">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Modifier l'utilisateur</h1>
                <p class="text-muted mb-0">{{ user.prenom }} {{ user.nom }} — ID: #MV-{{ user.id }}</p>
            </div>
            <a href="{{ path('app_user_admin_index') }}" class="btn btn-light rounded-3 px-4 fw-semibold">
                Retour à la liste
            </a>
        </div>

        <div class="row g-4">

            {# Colonne actions statut #}
            <div class="col-lg-4">
                <div class="bg-white rounded-4 shadow-sm p-4">
                    <div class="text-center mb-4">
                        <div class="mx-auto mb-3" style="width:72px;height:72px;border-radius:50%;background:var(--bs-primary-bg,#e6f7f5);color:var(--bs-primary);font-weight:700;font-size:1.3rem;display:flex;align-items:center;justify-content:center;">
                            {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
                        </div>
                        <div class="fw-bold">{{ user.prenom }} {{ user.nom }}</div>
                        <div class="text-muted small">{{ user.email }}</div>
                        <div class="mt-2">
                            {% if user.isVerified %}
                                <span class="badge" style="background:#e4f9f0;color:#16a34a;">Compte vérifié</span>
                            {% else %}
                                <span class="badge" style="background:#fde8e8;color:#dc2626;">Non vérifié</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-2">
                    {#}
                        <form method="post" action="{{ path('app_user_admin_verify', {'id': user.id, 'value': 1}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('verify' ~ user.id) }}">
                            <button class="btn w-100 rounded-3 fw-semibold" style="background:#e4f9f0;color:#16a34a;">
                                <i data-lucide="check-circle" style="width:15px;height:15px;"></i>
                                Accepter
                            </button>
                        </form>

                        <form method="post" action="{{ path('app_user_admin_verify', {'id': user.id, 'value': 0}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('verify' ~ user.id) }}">
                            <button class="btn w-100 rounded-3 fw-semibold" style="background:#fde8e8;color:#dc2626;">
                                <i data-lucide="x-circle" style="width:15px;height:15px;"></i>
                                Refuser
                            </button>
                        </form>
                        #}

                        <button class="btn w-100 rounded-3 fw-semibold" style="background:#f0f0f0;color:#666;">
                            <i data-lucide="archive" style="width:15px;height:15px;"></i>
                            Archiver
                        </button>
                    </div>

                    <div class="mt-4 pt-4 border-top">
                        {{ include('user_admin/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>

            {# Colonne formulaire #}
            <div class="col-lg-8">
                <div class="bg-white rounded-4 shadow-sm p-4 p-lg-5">
                    {{ include('user_admin/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://unpkg.com/lucide@latest"></script>
<script>if (window.lucide) lucide.createIcons();</script>
{% endblock %}