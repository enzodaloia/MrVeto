{% extends 'base.html.twig' %}

{% block title %}Modifier
	{{ user.prenom }}
	{{ user.nom }}
{% endblock %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block body %}

	<style>
		.btn-retour:hover {
			color: var(--bs-info) !important;
		}
		.invalid-feedback {
			display: block !important;
		}
	</style>

	<div class="container-fluid py-3 py-md-4 px-3 px-md-4 bg-warning-bg min-vh-100">
		<div class="mx-auto" style="max-width: 900px;">

			<div class="d-flex justify-content-between align-items-center mb-4">

				<div class="d-flex align-items-center gap-3">
					<div class="rounded-circle d-flex align-items-center justify-content-center" style="width:44px; height:44px; background:#FFF4CC;">
						<i class="bi bi-person" style="font-size:18px; color:#E6B800;"></i>
					</div>

					<div class="text-muted">
						Modifier l'utilisateur
					</div>
				</div>

				<a href="{{ path('app_user_admin_index') }}" class="text-decoration-none text-muted fw-semibold" data-turbo="false">
					← Retour à la liste
				</a>

			</div>

			<div class="row g-3 g-lg-4">

				<div class="col-12 col-lg-4 order-1">
					<div class="bg-white rounded-4 p-3 p-md-4">
						<div class="text-center mb-4">
							<div class="mx-auto mb-3" style="width:72px;height:72px;border-radius:50%;background:var(--bs-primary-bg,#e6f7f5);color:var(--bs-primary);font-weight:700;font-size:1.3rem;display:flex;align-items:center;justify-content:center;">
								{{ user.prenom|default('')|first|upper }}{{ user.nom|default('')|first|upper }}
							</div>

							<div class="fw-bold text-break">{{ user.prenom }}
								{{ user.nom }}</div>
							<div class="text-muted small text-break">{{ user.email }}</div>

							<div class="mt-2">
								{% if 'ROLE_VETO' in user.roles %}
									{% if user.isVerified %}
										<span class="badge rounded-pill px-3 py-2" style="background:#e4f9f0;color:#16a34a;">Validé admin</span>
									{% else %}
										<span class="badge rounded-pill px-3 py-2" style="background:#fde8e8;color:#dc2626;">En attente admin</span>
									{% endif %}
								{% else %}
									<span class="badge rounded-pill px-3 py-2" style="background:#dcfce7;color:#166534;">Actif</span>
								{% endif %}
							</div>
						</div>

						{% if 'ROLE_VETO' in user.roles %}
							<form method="post" action="{{ path('app_user_admin_verify', {'slug': user.slug, 'value': user.isVerified ? 0 : 1}) }}">
								<input type="hidden" name="_token" value="{{ csrf_token('verify' ~ user.id) }}">
								<div class="d-flex align-items-center justify-content-between gap-3 bg-light rounded-3 px-3 py-2">
									<label class="form-check-label small fw-semibold mb-0" for="verify-switch-{{ user.id }}">
										Validation du compte vétérinaire
									</label>
									<div class="d-flex align-items-center gap-2">
										{% if user.isVerified %}
											<span class="small fw-semibold text-success">Validé</span>
										{% endif %}
										<div class="form-check form-switch m-0">
											<input class="form-check-input" type="checkbox" role="switch" id="verify-switch-{{ user.id }}" {{ user.isVerified ? 'checked' : '' }} onchange="this.form.submit()">
										</div>
									</div>
								</div>
							</form>
						{% endif %}

						{% if 'ROLE_VETO' in user.roles %}
							<div class="mt-3">
								{{ include('user_admin/_siret_verification.html.twig') }}
							</div>
						{% endif %}

						<div class="mt-4 pt-4 border-top d-flex justify-content-center align-items-center gap-2 ">
							{{ include('user_admin/_delete_form.html.twig') }}

							<span class="text-danger" style="cursor:pointer;" onclick="document.getElementById('delete-user-form-{{ user.id }}').submit();">
								Supprimer
							</span>
						</div>
					</div>
				</div>

				<div class="col-12 col-lg-8 order-2">
					<div class="bg-white rounded-4 p-3 p-md-4 p-lg-5">

						{% set isAdmin = 'ROLE_ADMIN' in user.roles %}
						{% set isVeto = 'ROLE_VETO' in user.roles %}
						{% set isUser = not isAdmin and not isVeto %}

						{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

						{{ form_errors(form) }}

						<div class="row g-3">
							<div class="col-12 col-md-6">
								{{ form_label(form.prenom) }}
								{{ form_widget(form.prenom, {
		attr: {
			class: 'form-control' ~ (form.prenom.vars.errors|length ? ' is-invalid' : '')
		}
	}) }}

								{% if form.prenom.vars.errors|length > 0 %}
									<div class="invalid-feedback d-block">
										{% for error in form.prenom.vars.errors %}
											<div>{{ error.message }}</div>
										{% endfor %}
									</div>
								{% endif %}
							</div>

							<div class="col-12 col-md-6">
								{{ form_label(form.nom) }}
								{{ form_widget(form.nom, {
		attr: {
			class: 'form-control' ~ (form.nom.vars.errors|length ? ' is-invalid' : '')
		}
	}) }}

								{% if form.nom.vars.errors|length > 0 %}
									<div class="invalid-feedback d-block">
										{% for error in form.nom.vars.errors %}
											<div>{{ error.message }}</div>
										{% endfor %}
									</div>
								{% endif %}
							</div>

							<div class="col-12">
								{{ form_row(form.email) }}
							</div>

							{% if form.roles is defined %}
								<div class="col-12">
									{{ form_row(form.roles) }}
								</div>
							{% endif %}

							{% if isUser %}
								{% if form.telephone is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.telephone, {'attr': {'data-controller': 'phone-input', 'data-action': 'input->phone-input#format'}}) }}
									</div>
								{% endif %}

								{% if form.datenaissance is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.datenaissance) }}
									</div>
								{% endif %}

								{% if form.adresse is defined %}
									<div class="col-12">
										{{ form_row(form.adresse) }}
									</div>
								{% endif %}

								{% if form.ville is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.ville) }}
									</div>
								{% endif %}

								{% if form.codepostal is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.codepostal) }}
									</div>
								{% endif %}
							{% endif %}

							{% if isVeto %}
								{% if form.telephone is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.telephone, {'attr': {'data-controller': 'phone-input', 'data-action': 'input->phone-input#format'}}) }}
									</div>
								{% endif %}

								{% if form.datenaissance is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.datenaissance) }}
									</div>
								{% endif %}

								{% if form.adresse is defined %}
									<div class="col-12">
										{{ form_row(form.adresse) }}
									</div>
								{% endif %}

								{% if form.ville is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.ville) }}
									</div>
								{% endif %}

								{% if form.codepostal is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.codepostal) }}
									</div>
								{% endif %}

								{% if form.siret is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.siret) }}
									</div>
								{% endif %}

								{% if form.adressecabinet is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.adressecabinet) }}
									</div>
								{% endif %}

							{% endif %}
						</div>

						{% if form._token is defined %}
							{{ form_widget(form._token) }}
						{% endif %}

						<div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-3 border-top">
							<a href="{{ path('app_user_admin_index') }}" class="btn bg-secondary-bg btn-outline-secondary rounded-3 px-4 fw-semibold">
								Annuler
							</a>

							<button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 text-white text-nowrap">
								<i data-lucide="save" style="width:18px;height:18px;"></i>
								Enregistrer
							</button>
						</div>


						{{ form_end(form, {'render_rest': false}) }}
					</div>
				</div>

			</div>
		</div>
	</div>

	 <script src="https://unpkg.com/lucide@latest"></script>
	 <script>
								if (window.lucide) lucide.createIcons();
							</script>
{% endblock %}
