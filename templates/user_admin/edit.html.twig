{% extends 'base.html.twig' %}

{% block title %}Modifier
	{{ user.prenom }}
	{{ user.nom }}
{% endblock %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block body %}

	<style>
		.btn-retour:hover {
			color: var(--bs-info) !important;
		}
		.invalid-feedback {
			display: block !important;
		}
	</style>

	<div class="container-fluid py-3 py-md-4 px-3 px-md-4 bg-warning-bg min-vh-100">
		<div class="mx-auto" style="max-width: 900px;">

			<div class="d-flex justify-content-between align-items-center gap-3 mb-4 flex-nowrap">
				<div>
					<h1 class="h3 fw-bold text-dark mb-1 text-nowrap">Modifier l'utilisateur</h1>
					<p class="text-muted mb-0">{{ user.prenom }}
						{{ user.nom }}</p>
				</div>

				<a href="{{ path('app_user_admin_index') }}" class="btn text-neutral-90 border-0 rounded-3 px-4 fw-semibold text-nowrap d-inline-flex align-items-center gap-2 btn-retour" data-turbo="false">
					<i data-lucide="arrow-left" style="width:16px;height:16px;"></i>
					Retour à la liste
				</a>
			</div>

			<div class="row g-3 g-lg-4">

				<div class="col-12 col-lg-4 order-1">
					<div class="bg-white rounded-4 p-3 p-md-4">
						<div class="text-center mb-4">
							<div class="mx-auto mb-3" style="width:72px;height:72px;border-radius:50%;background:var(--bs-primary-bg,#e6f7f5);color:var(--bs-primary);font-weight:700;font-size:1.3rem;display:flex;align-items:center;justify-content:center;">
								{{ user.prenom|default('')|first|upper }}{{ user.nom|default('')|first|upper }}
							</div>

							<div class="fw-bold text-break">{{ user.prenom }}
								{{ user.nom }}</div>
							<div class="text-muted small text-break">{{ user.email }}</div>

							<div class="mt-2">
								{% if 'ROLE_VETO' in user.roles %}
									{% if user.isVerified %}
										<span class="badge rounded-pill px-3 py-2" style="background:#e4f9f0;color:#16a34a;">Compte vérifié</span>
									{% else %}
										<span class="badge rounded-pill px-3 py-2" style="background:#fde8e8;color:#dc2626;">Non vérifié</span>
									{% endif %}
								{% else %}
									<span class="badge rounded-pill px-3 py-2" style="background:#dcfce7;color:#166534;">Actif</span>
								{% endif %}
							</div>
						</div>

						{% if 'ROLE_VETO' in user.roles %}
							<div class="d-flex flex-column gap-2">
								{% if not user.isVerified %}
									<form method="post" action="{{ path('app_user_admin_verify', {'id': user.id, 'value': 1}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('verify' ~ user.id) }}">
										<button type="submit" class="btn w-100 rounded-3 fw-semibold d-inline-flex align-items-center justify-content-center gap-2" style="background:#e4f9f0;color:#16a34a;">
											<i data-lucide="check-circle" style="width:15px;height:15px;"></i>
											Valider le compte
										</button>
									</form>
								{% else %}
									<form method="post" action="{{ path('app_user_admin_verify', {'id': user.id, 'value': 0}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('verify' ~ user.id) }}">
										<button type="submit" class="btn w-100 rounded-3 fw-semibold d-inline-flex align-items-center justify-content-center gap-2" style="background:#fde8e8;color:#dc2626;">
											<i data-lucide="x-circle" style="width:15px;height:15px;"></i>
											Retirer la validation
										</button>
									</form>
								{% endif %}
							</div>
						{% endif %}

						<div class="mt-4 pt-4 border-top d-flex justify-content-center align-items-center gap-2">
							{{ include('user_admin/_delete_form.html.twig') }}

							<span class="text-danger" style="cursor:pointer;" onclick="document.getElementById('delete-user-form-{{ user.id }}').submit();">
								Supprimer
							</span>
						</div>
					</div>
				</div>

				<div class="col-12 col-lg-8 order-2">
					<div class="bg-white rounded-4 p-3 p-md-4 p-lg-5">

						{% set isAdmin = 'ROLE_ADMIN' in user.roles %}
						{% set isVeto = 'ROLE_VETO' in user.roles %}
						{% set isUser = not isAdmin and not isVeto %}

						{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

						{{ form_errors(form) }}

						<div class="row g-3">
							<div class="col-12 col-md-6">
								{{ form_label(form.prenom) }}
								{{ form_widget(form.prenom, {
		attr: {
			class: 'form-control' ~ (form.prenom.vars.errors|length ? ' is-invalid' : '')
		}
	}) }}

								{% if form.prenom.vars.errors|length > 0 %}
									<div class="invalid-feedback d-block">
										{% for error in form.prenom.vars.errors %}
											<div>{{ error.message }}</div>
										{% endfor %}
									</div>
								{% endif %}
							</div>

							<div class="col-12 col-md-6">
								{{ form_label(form.nom) }}
								{{ form_widget(form.nom, {
		attr: {
			class: 'form-control' ~ (form.nom.vars.errors|length ? ' is-invalid' : '')
		}
	}) }}

								{% if form.nom.vars.errors|length > 0 %}
									<div class="invalid-feedback d-block">
										{% for error in form.nom.vars.errors %}
											<div>{{ error.message }}</div>
										{% endfor %}
									</div>
								{% endif %}
							</div>

							<div class="col-12">
								{{ form_row(form.email) }}
							</div>

							{% if form.roles is defined %}
								<div class="col-12">
									{{ form_row(form.roles) }}
								</div>
							{% endif %}

							{% if isUser %}
								{% if form.telephone is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.telephone) }}
									</div>
								{% endif %}

								{% if form.datenaissance is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.datenaissance) }}
									</div>
								{% endif %}

								{% if form.adresse is defined %}
									<div class="col-12">
										{{ form_row(form.adresse) }}
									</div>
								{% endif %}

								{% if form.ville is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.ville) }}
									</div>
								{% endif %}

								{% if form.codepostal is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.codepostal) }}
									</div>
								{% endif %}
							{% endif %}

							{% if isVeto %}
								{% if form.telephone is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.telephone) }}
									</div>
								{% endif %}

								{% if form.datenaissance is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.datenaissance) }}
									</div>
								{% endif %}

								{% if form.adresse is defined %}
									<div class="col-12">
										{{ form_row(form.adresse) }}
									</div>
								{% endif %}

								{% if form.ville is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.ville) }}
									</div>
								{% endif %}

								{% if form.codepostal is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.codepostal) }}
									</div>
								{% endif %}

								{% if form.siret is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.siret) }}
									</div>
								{% endif %}

								{% if form.adressecabinet is defined %}
									<div class="col-12 col-md-6">
										{{ form_row(form.adressecabinet) }}
									</div>
								{% endif %}
							{% endif %}

							{% if isAdmin %}
								{% if form.isVerified is defined %}
									<div class="col-12">
										{{ form_row(form.isVerified) }}
									</div>
								{% endif %}
							{% endif %}


						</div>

						{% if form._token is defined %}
							{{ form_widget(form._token) }}
						{% endif %}

						<div class="d-flex flex-column-reverse flex-md-row justify-content-end gap-2 gap-md-3 mt-4 pt-3 border-top">
							<a href="{{ path('app_user_admin_index') }}" class="btn btn-light rounded-3 px-4 fw-semibold w-100 w-md-auto">
								Annuler
							</a>

							<button type="submit" class="btn btn-primary rounded-3 px-5 py-3 fw-semibold w-100 w-md-auto d-inline-flex align-items-center justify-content-center gap-2 text-white" style="white-space: nowrap;">
								<i data-lucide="save" style="width:18px;height:18px;"></i>
								Enregistrer les modifications
							</button>
						</div>


						{{ form_end(form, {'render_rest': false}) }}
					</div>
				</div>

			</div>
		</div>
	</div>

	 <script src="https://unpkg.com/lucide@latest"></script>
	 <script>
							if (window.lucide) lucide.createIcons();
						</script>
{% endblock %}
