{% extends 'base.html.twig' %}

{% block title %}Mon Planning – MrVeto{% endblock %}

{% block stylesheets %}
{{ parent() }}
{{ encore_entry_link_tags('planning') }}
{% endblock %}

{% block body %}
<div class="planning-root">

    {# ===== LEFT SIDEBAR ===== #}
    <div class="planning-left">

        {# Mini calendar #}
        <div class="mini-cal" id="mini-cal"></div>

        {# Today's RDV #}
        <div>
            <div class="sidebar-section-title">Aujourd'hui</div>
            <div id="today-events-list">
                <div class="text-muted" style="font-size:0.78rem; padding: 4px 8px;">Chargement…</div>
            </div>
        </div>

        {# Legend #}
        <div>
            <div class="sidebar-section-title">Légende</div>
            <div class="d-flex flex-column gap-1">
                <div class="legend-row"><span class="legend-dot" style="background:#FFCF00;"></span>En attente</div>
                <div class="legend-row"><span class="legend-dot" style="background:#1a73e8;"></span>Confirmé</div>
                <div class="legend-row"><span class="legend-dot" style="background:#36BDAF;"></span>Terminé</div>
                <div class="legend-row"><span class="legend-dot" style="background:#fd7e14;"></span>Déplacé</div>
                <div class="legend-row"><span class="legend-dot" style="background:#9e9e9e;"></span>Annulé</div>
            </div>
        </div>

    </div>

    {# ===== MAIN AREA ===== #}
    <div class="planning-main">

        {# Custom toolbar (replaces FullCalendar native toolbar) #}
        <div class="planning-toolbar">
            <button class="toolbar-today-btn" id="btn-today">Aujourd'hui</button>
            <button class="toolbar-nav-btn" id="btn-prev" aria-label="Semaine précédente">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="toolbar-nav-btn" id="btn-next" aria-label="Semaine suivante">
                <i class="bi bi-chevron-right"></i>
            </button>
            <span class="toolbar-title" id="toolbar-title"></span>
            <div class="toolbar-view-switcher">
                <button class="toolbar-view-btn" data-view="timeGridDay">Jour</button>
                <button class="toolbar-view-btn active" data-view="timeGridWeek">Semaine</button>
                <button class="toolbar-view-btn" data-view="dayGridMonth">Mois</button>
            </div>
        </div>

        {# Calendar #}
        <div class="planning-calendar-wrap">
            <div
                id="planning-calendar"
                data-events-url="{{ path('app_vet_planning_events') }}"
                data-gestion-rdv-url="{{ path('app_gestion_rdv') }}"
                data-gestion-rdv-prefix="/gestion-rdv"
                data-business-hours="{{ businessHours|json_encode }}">
            </div>
        </div>
    </div>

</div>

{# ===== POPOVER ===== #}
<div id="planning-popover" class="d-none" role="dialog" aria-label="Détails du rendez-vous">
    <div class="pop-header">
        <div>
            <div class="pop-title" id="pop-title">–</div>
            <div id="pop-statut-wrap" class="mt-1"></div>
        </div>
        <button type="button" id="pop-close" class="btn-close btn-sm" aria-label="Fermer"></button>
    </div>
    <div class="pop-body">
        <div class="pop-row">
            <i class="bi bi-clock"></i>
            <span id="pop-start">–</span>
        </div>
        <div class="pop-row">
            <i class="bi bi-person"></i>
            <span id="pop-client">–</span>
        </div>
        <div class="pop-row">
            <i class="bi bi-heart-pulse"></i>
            <span id="pop-animal">–</span>
        </div>
        <div class="pop-row" id="pop-motif-row">
            <i class="bi bi-chat-left-text"></i>
            <span id="pop-motif">–</span>
        </div>
    </div>
    <div class="pop-footer">
        <button id="pop-btn-confirm" class="btn btn-sm btn-success text-white rounded-pill px-3 fw-semibold d-none">
            <i class="bi bi-check-lg me-1"></i>Confirmer
        </button>
        <button id="pop-btn-cancel" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold d-none">
            <i class="bi bi-x-lg me-1"></i>Annuler
        </button>
        <a id="pop-link" href="#" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold text-primary ms-auto" data-turbo="false">
            <i class="bi bi-journal-text me-1"></i>Détails
        </a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{{ encore_entry_script_tags('planning') }}
{% endblock %}
