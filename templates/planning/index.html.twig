{% extends 'base.html.twig' %}

{% block title %}Mon Planning - MrVeto{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('planning') }}
	<style>
		/* FullCalendar theme overrides */
		.fc .fc-button-primary {
			background-color: var(--bs-primary);
			border-color: var(--bs-primary);
			color: #fff;
			font-weight: 600;
			border-radius: 0.5rem;
		}
		.fc .fc-button-primary:not(:disabled):hover,
		.fc .fc-button-primary:not(:disabled).fc-button-active {
			background-color: #2aa89b;
			border-color: #2aa89b;
		}
		.fc .fc-button-primary:disabled {
			background-color: var(--bs-primary);
			border-color: var(--bs-primary);
			opacity: 0.65;
		}
		.fc .fc-toolbar-title {
			font-weight: 800;
			font-size: 1.15rem;
			color: #1a1a2e;
		}
		.fc .fc-col-header-cell {
			background-color: #f8fffe;
			font-weight: 700;
			color: #36BDAF;
			text-transform: uppercase;
			font-size: 0.75rem;
			letter-spacing: 0.04em;
		}
		.fc .fc-timegrid-slot-label {
			font-size: 0.75rem;
			color: #9e9e9e;
		}
		.fc .fc-non-business {
			background-color: rgba(0, 0, 0, 0.03);
		}
		.fc .fc-event {
			border-radius: 6px;
			font-size: 0.78rem;
			font-weight: 600;
			cursor: pointer;
			border-width: 2px;
		}
		.fc .fc-event .fc-event-title {
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.fc .fc-now-indicator-line {
			border-color: #e53935;
		}
		.fc .fc-now-indicator-arrow {
			border-top-color: #e53935;
		}
		.fc-daygrid-event-dot {
			border-color: var(--bs-primary) !important;
		}
		.fc-theme-standard td, .fc-theme-standard th {
			border-color: #f0f0f0;
		}
		.fc-theme-standard .fc-scrollgrid {
			border-color: #e8e8e8;
		}

		/* Popover */
		#planning-popover {
			position: absolute;
			z-index: 1080;
			min-width: 280px;
			max-width: 320px;
			background: #fff;
			border-radius: 12px;
			box-shadow: 0 8px 32px rgba(0,0,0,0.15);
			border: 1px solid #e8e8e8;
			padding: 0;
			overflow: hidden;
		}
		#planning-popover .pop-header {
			background: var(--bs-primary);
			color: #fff;
			padding: 0.75rem 1rem;
			font-weight: 700;
			font-size: 0.9rem;
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: 0.5rem;
		}
		#planning-popover .pop-body {
			padding: 0.9rem 1rem;
		}
		#planning-popover .pop-row {
			display: flex;
			align-items: flex-start;
			gap: 0.5rem;
			margin-bottom: 0.45rem;
			font-size: 0.84rem;
		}
		#planning-popover .pop-row i {
			color: var(--bs-primary);
			flex-shrink: 0;
			margin-top: 1px;
		}
		#planning-popover .pop-footer {
			border-top: 1px solid #f0f0f0;
			padding: 0.6rem 1rem;
			background: #fafafa;
		}

		/* Legend */
		.legend-dot {
			width: 12px;
			height: 12px;
			border-radius: 3px;
			display: inline-block;
			flex-shrink: 0;
		}

		@media (max-width: 767.98px) {
			.fc .fc-toolbar {
				flex-direction: column;
				gap: 0.5rem;
			}
			.fc .fc-toolbar-chunk {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.4rem;
			}
		}
	</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-3 py-md-4 px-3 px-md-4">

	{# Title #}
	<div class="mb-4">
		<h1 class="h2 fw-black text-dark mb-1">
			<i class="bi bi-calendar-week text-primary me-2"></i>Mon Planning
		</h1>
		<p class="text-muted mb-0">Vue calendrier de vos rendez-vous</p>
	</div>

	{# Legend #}
	<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
		<span class="d-flex align-items-center gap-2 small fw-semibold text-muted">
			<span class="legend-dot" style="background:#FFCF00; border:2px solid #e6bb00;"></span>En attente
		</span>
		<span class="d-flex align-items-center gap-2 small fw-semibold text-muted">
			<span class="legend-dot" style="background:#36BDAF; border:2px solid #2da89b;"></span>Terminé
		</span>
		<span class="d-flex align-items-center gap-2 small fw-semibold text-muted">
			<span class="legend-dot" style="background:#fd7e14; border:2px solid #e0710f;"></span>Déplacé
		</span>
		<span class="d-flex align-items-center gap-2 small fw-semibold text-muted">
			<span class="legend-dot" style="background:#9e9e9e; border:2px solid #757575;"></span>Annulé
		</span>
	</div>

	{# Calendar #}
	<div class="bg-white rounded-4 shadow-sm p-3 p-md-4" style="position: relative;">
		<div
			id="planning-calendar"
			data-events-url="{{ path('app_vet_planning_events') }}"
			data-gestion-rdv-url="{{ path('app_gestion_rdv') }}"
			data-business-hours="{{ businessHours|json_encode }}">
		</div>
	</div>

</div>

{# Popover #}
<div id="planning-popover" class="d-none" role="tooltip" aria-live="polite">
	<div class="pop-header">
		<span id="pop-title" class="lh-sm">–</span>
		<button type="button" id="pop-close" class="btn-close btn-close-white btn-sm ms-2 flex-shrink-0" aria-label="Fermer"></button>
	</div>
	<div class="pop-body">
		<div class="pop-row">
			<i class="bi bi-clock"></i>
			<span id="pop-start">–</span>
		</div>
		<div class="pop-row">
			<i class="bi bi-person"></i>
			<span id="pop-client">–</span>
		</div>
		<div class="pop-row">
			<i class="bi bi-heart-pulse"></i>
			<span id="pop-animal">–</span>
		</div>
		<div class="pop-row">
			<i class="bi bi-chat-left-text"></i>
			<span id="pop-motif">–</span>
		</div>
		<div class="pop-row align-items-center">
			<i class="bi bi-circle-fill" style="font-size:0.6rem;"></i>
			<span id="pop-statut" class="badge">–</span>
		</div>
	</div>
	<div class="pop-footer">
		<a id="pop-link" href="#" class="btn btn-sm btn-primary text-white w-100 fw-semibold rounded-3">
			<i class="bi bi-journal-text me-1"></i>Voir dans Gestion des RDV
		</a>
	</div>
</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('planning') }}
{% endblock %}
