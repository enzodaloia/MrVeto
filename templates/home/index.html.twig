{% extends 'base.html.twig' %}

{% block title %}MrVeto
{% endblock %}

{% block body %}
	<style>
		@media(min-width: 768px) {
			.step-2-offset {
				margin-top: 200px;
			}
			.step-3-offset {
				margin-top: 400px;
			}
		}
	</style>

	<div class="container-fluid bg-warning-bg py-5">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-12 col-md-6">
					<div class="p-3">
						<img src="{{ asset('images/home/hero_homepage.png') }}" alt="Illustration d’un rendez-vous chez un vétérinaire" class="img-fluid">
					</div>
				</div>

				<div class="col-12 col-md-6">
					<div class="p-3">
						<h1 class="text-primary">Prendre rendez-vous chez un vétérinaire</h1>
						<p class="text-info">Trouvez rapidement un vétérinaire disponible près de chez vous.</p>
					</div>
					<div class="p-3">
						<form action="{{ path('app_search_vet') }}" method="get">
							<div class="input-group mb-3 bg-neutral-20" style="position: relative;">
								<span class="input-group-text" style="border: none; background: #FAFAFA;">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="#E57020" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="11" cy="11" r="8"/>
										<line x1="21" y1="21" x2="16.65" y2="16.65"/>
									</svg>
								</span>
                                <label for="searchInput" class="form-label visually-hidden">
    Adresse
</label>
								<input type="text" class="form-control" id="searchInput" name="location" placeholder="Ville ou code postal" style="border: none; box-shadow: none; outline: none;" autocomplete="off">
								<input type="hidden" id="searchLat" name="lat">
								<input type="hidden" id="searchLon" name="lon">
								<input type="hidden" name="distance" value="20">
								<button type="submit" class="btn btn-secondary text-info px-4 fw-bold">Rechercher</button>
								<ul id="suggestions" class="list-group" style="position: absolute; top: 100%; left: 0; right: 0; z-index: 999; display: none; max-height: 200px; overflow-y: auto;"></ul>
							</div>
							<div id="addressError" class="text-danger mt-1" style="display: none;">
								Veuillez renseigner une adresse ou utiliser "Autour de moi".
							</div>

							<div class="form-check">
								<input class="form-check-input" type="checkbox" id="autourDeMoi">
								<label class="form-check-label text-warning" for="autourDeMoi">
									Autour de moi
								</label>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>

		<div class="container-fluid mt-4">
			<div class="row justify-content-center">
				<div class="col-12 col-md-8 col-lg-6">
					<div class="p-3 text-center">
						<h1 class="text-info">Comment ça marche ?</h1>
						<p class="text-info">MrVeto simplifie la prise de rendez-vous chez le vétérinaire, en quelques étapes. Plus de panique, contactez rapidement les véto les plus proches de vous en cas d'urgence avec MrVeto.</p>
					</div>
				</div>
			</div>
		</div>

		<div class="container-fluid mt-5 py-5">
			<img src="{{ asset('images/home/paw_secondary_homepage.svg') }}" alt="" class="d-none d-md-block" style="position: absolute; top: 509px; right: 0; width: 100px; z-index: 0;">
			<img src="{{ asset('images/home/paw_primary_homepage.svg') }}" alt="" class="d-none d-md-block" style="position: absolute; top: 1331px; left: 92px; width: 90px; z-index: 0;">
			<img src="{{ asset('images/home/paw_primary.png') }}" alt="" class="d-none d-md-block" style="position: absolute; bottom: 15%; left: 10%; opacity: 0.3; width: 90px; z-index: 0;">

			<div class="row justify-content-evenly">
				<div class="col-12 col-md-4 mb-2" style="max-width: 330px;">
					<div class="text-center">
						<div class="mb-3">
							<img src="{{ asset('images/home/paw_homepage.svg') }}" alt="Recherche">
						</div>
						<h3 class="text-primary">1. Rechercher un vétérinaire</h3>
						<p class="text-info">Entrez votre ville ou code postal pour trouver les vétérinaires disponibles près de chez vous, qu'il s'agisse d'une consultation classique ou d'une urgence.</p>
					</div>
				</div>

				<div class="col-12 col-md-4 mb-2 step-2-offset" style="max-width: 330px">
					<div class="text-center">
						<div class="mb-3">
							<img src="{{ asset('images/home/calendar_homepage.svg') }}" alt="Calendrier">
						</div>
						<h3 class="text-primary">2. Choisir un créneau</h3>
						<p class="text-info">Consultez les disponibilités en temps réel et réservez le créneau qui vous convient, directement en ligne, sans attente téléphonique.</p>
					</div>
				</div>

				<div class="col-12 col-md-4 mb-2 step-3-offset" style="max-width: 330px">
					<div class="text-center">
						<div class="mb-3">
							<img src="{{ asset('images/home/bandage_homepage.svg') }}" alt="Vétérinaire">
						</div>
						<h3 class="text-primary">3. Consulter votre vétérinaire</h3>
						<p class="text-info">Rendez-vous à votre cabinet au jour et à l'heure choisis. Votre vétérinaire vous attend, prêt à prendre soin de votre animal.</p>
					</div>
				</div>
			</div>
		</div>
	</div>

	 <script>
/**
 * Force reload when navigating back (fix browser cache issues)
 */
window.addEventListener('pageshow', function (event) {
    const navigationEntries = performance.getEntriesByType('navigation');

    if (
        event.persisted ||
        (navigationEntries.length > 0 && navigationEntries[0].type === 'back_forward')
    ) {
        window.location.reload();
    }
});

document.addEventListener('DOMContentLoaded', function () {
    const input       = document.getElementById('searchInput');
    const suggestions = document.getElementById('suggestions');
    const checkbox    = document.getElementById('autourDeMoi');
    const form        = document.querySelector('form');
    const error       = document.getElementById('addressError');

    const latInput = document.getElementById('searchLat');
    const lonInput = document.getElementById('searchLon');

    /**
     * Reset geolocation when user types manually
     */
    input.addEventListener('keydown', function () {
        checkbox.checked = false;

        if (latInput) latInput.value = '';
        if (lonInput) lonInput.value = '';
    });

    /**
     * Form validation (address or geolocation required)
     */
    form.addEventListener('submit', function (e) {
        const hasAddress = input.value.trim() !== '';
        const isGeo = checkbox.checked;

        if (!hasAddress && !isGeo) {
            e.preventDefault();
            error.style.display = 'block';
        } else {
            error.style.display = 'none';
        }
    });

    /**
     * Hide error on user input
     */
    input.addEventListener('input', function () {
        if (this.value.trim() !== '') {
            error.style.display = 'none';
        }
    });

    /**
     * Hide error when geolocation is selected
     */
    checkbox.addEventListener('change', function () {
        if (this.checked) {
            error.style.display = 'none';
        }
    });

    /**
     * Autocomplete cache and request controller
     */
    const cache = {};
    let controller = null;

    /**
     * Fetch address suggestions
     */
    input.addEventListener('input', async function () {
        const query = this.value.trim();

        if (query.length < 1) {
            suggestions.style.display = 'none';
            suggestions.innerHTML = '';
            return;
        }

        if (cache[query]) {
            renderSuggestions(cache[query]);
            return;
        }

        if (controller) controller.abort();
        controller = new AbortController();

        try {
            const response = await fetch(
                `https://api-adresse.data.gouv.fr/search/?q=${encodeURIComponent(query)}&type=municipality&limit=10&autocomplete=1`,
                { signal: controller.signal }
            );

            const data = await response.json();
            cache[query] = data.features;

            renderSuggestions(data.features);

        } catch (e) {
            if (e.name !== 'AbortError') {
                console.error('Address API error:', e);
            }
        }
    });

    /**
     * Render autocomplete suggestions
     */
    function renderSuggestions(features) {
        suggestions.innerHTML = '';

        if (!features || features.length === 0) {
            suggestions.style.display = 'none';
            return;
        }

        features.forEach(feature => {
            const city     = feature.properties.city;
            const postcode = feature.properties.postcode;

            const li = document.createElement('li');
            li.classList.add('list-group-item', 'list-group-item-action');
            li.style.cursor = 'pointer';
            li.textContent = `${city} (${postcode})`;

            li.addEventListener('click', () => {
                input.value = `${city} (${postcode})`;

                if (latInput) latInput.value = feature.geometry.coordinates[1];
                if (lonInput) lonInput.value = feature.geometry.coordinates[0];

                suggestions.style.display = 'none';
                suggestions.innerHTML = '';
            });

            suggestions.appendChild(li);
        });

        suggestions.style.display = 'block';
    }

    /**
     * Close suggestions when clicking outside
     */
    document.addEventListener('click', function (e) {
        if (!input.contains(e.target) && !suggestions.contains(e.target)) {
            suggestions.style.display = 'none';
        }
    });

    /**
     * Handle geolocation lookup
     */
    checkbox.addEventListener('change', function () {
        if (!this.checked) {
            input.value = '';
            return;
        }

        if (!navigator.geolocation) {
            alert('Geolocation is not supported by your browser.');
            this.checked = false;
            return;
        }

        navigator.geolocation.getCurrentPosition(
            async function (position) {
                const lat = position.coords.latitude;
                const lon = position.coords.longitude;

                try {
                    const response = await fetch(`https://api-adresse.data.gouv.fr/reverse/?lon=${lon}&lat=${lat}`);
                    const data = await response.json();

                    if (data.features.length > 0) {
                        const city     = data.features[0].properties.city;
                        const postcode = data.features[0].properties.postcode;

                        input.value = `${city} (${postcode})`;

                        if (latInput) latInput.value = lat;
                        if (lonInput) lonInput.value = lon;

                    } else {
                        alert('Unable to determine your location.');
                        checkbox.checked = false;
                    }

                } catch (error) {
                    console.error('Geolocation error:', error);
                    checkbox.checked = false;
                }
            },
            function () {
                alert('Location permission denied.');
                checkbox.checked = false;
            }
        );
    });
});
</script>
{% endblock %}
