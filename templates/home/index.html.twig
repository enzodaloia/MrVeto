{% extends 'base.html.twig' %}

{% block title %}Accueil - MrVeto{% endblock %}

{% block body %}
	<style>
		@media(min-width: 768px) {
			.step-2-offset {
				margin-top: 200px;
			}
			.step-3-offset {
				margin-top: 400px;
			}
		}
	</style>

	<div class="container-fluid bg-warning-bg py-5">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-12 col-md-6">
					<div class="p-3">
						<img src="{{ asset('images/home/hero_homepage.png') }}" alt="Illustration d’un rendez-vous chez un vétérinaire" class="img-fluid">
					</div>
				</div>

				<div class="col-12 col-md-6">
					<div class="p-3">
						<h1 class="text-primary">Prendre rendez-vous chez un vétérinaire</h1>
						<p class="text-info">Trouvez rapidement un vétérinaire disponible près de chez vous.</p>
					</div>
					<div class="p-3">
						<form action="{{ path('app_search_vet') }}" method="get" data-controller="autocomplete-address" data-autocomplete-address-theme-value="search" data-action="submit->autocomplete-address#onSubmit">
							<div class="input-group mb-3 bg-neutral-20" style="position: relative;">
								<span class="input-group-text" style="border: none; background: #FAFAFA;">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="#E57020" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="11" cy="11" r="8"/>
										<line x1="21" y1="21" x2="16.65" y2="16.65"/>
									</svg>
								</span>
								<label for="searchInput" class="form-label visually-hidden">
									Adresse
								</label>
								<input type="text" class="form-control rounded-pill rounded-end-0 border-0 ps-3 pe-3 shadow-none focus-ring-none" id="searchInput" name="location" placeholder="Ville ou code postal" style="outline: none;" autocomplete="off" data-autocomplete-address-target="input" data-action="input->autocomplete-address#search">
								<input type="hidden" name="lat" data-autocomplete-address-target="lat">
								<input type="hidden" name="lon" data-autocomplete-address-target="lon">
								<input type="hidden" name="distance" value="20">
								<button type="submit" class="btn btn-secondary text-info px-4 fw-bold rounded-pill rounded-start-0" style="z-index: 4;">Rechercher</button>
								<div data-autocomplete-address-target="results" class="position-absolute start-0 end-0 top-100 z-3"></div>
							</div>

							<div class="form-check">
								<input class="form-check-input" type="checkbox" id="autourDeMoi" data-action="change->autocomplete-address#locate">
								<label class="form-check-label text-warning" for="autourDeMoi">
									Autour de moi
								</label>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>

		<div class="container-fluid mt-4">
			<div class="row justify-content-center">
				<div class="col-12 col-md-8 col-lg-6">
					<div class="p-3 text-center">
						<h1 class="text-info">Comment ça marche ?</h1>
						<p class="text-info">MrVeto simplifie la prise de rendez-vous chez le vétérinaire, en quelques étapes. Plus de panique, contactez rapidement les véto les plus proches de vous en cas d'urgence avec MrVeto.</p>
					</div>
				</div>
			</div>
		</div>

		<div class="container-fluid mt-5 py-5">
			<img src="{{ asset('images/home/paw_secondary_homepage.svg') }}" alt="" class="d-none d-md-block" style="position: absolute; top: 509px; right: 0; width: 100px; z-index: 0;">
			<img src="{{ asset('images/home/paw_primary_homepage.svg') }}" alt="" class="d-none d-md-block" style="position: absolute; top: 1331px; left: 92px; width: 90px; z-index: -1;">
			<img src="{{ asset('images/home/paw_primary_homepage.svg') }}" alt="" class="d-none d-md-block" style="position: absolute; bottom: 15%; left: 10%; opacity: 0.3; width: 90px; z-index: 0;">

			<div class="row justify-content-evenly">
				<div class="col-12 col-md-4 mb-2" style="max-width: 330px;">
					<div class="text-center">
						<div class="mb-3">
							<img src="{{ asset('images/home/paw_homepage.svg') }}" alt="Recherche">
						</div>
						<h3 class="text-primary">1. Rechercher un vétérinaire</h3>
						<p class="text-info">Entrez votre ville ou code postal pour trouver les vétérinaires disponibles près de chez vous, qu'il s'agisse d'une consultation classique ou d'une urgence.</p>
					</div>
				</div>

				<div class="col-12 col-md-4 mb-2 step-2-offset" style="max-width: 330px">
					<div class="text-center">
						<div class="mb-3">
							<img src="{{ asset('images/home/calendar_homepage.svg') }}" alt="Calendrier">
						</div>
						<h3 class="text-primary">2. Choisir un créneau</h3>
						<p class="text-info">Consultez les disponibilités en temps réel et réservez le créneau qui vous convient, directement en ligne, sans attente téléphonique.</p>
					</div>
				</div>

				<div class="col-12 col-md-4 mb-2 step-3-offset" style="max-width: 330px">
					<div class="text-center">
						<div class="mb-3">
							<img src="{{ asset('images/home/bandage_homepage.svg') }}" alt="Vétérinaire">
						</div>
						<h3 class="text-primary">3. Consulter votre vétérinaire</h3>
						<p class="text-info">Rendez-vous à votre cabinet au jour et à l'heure choisis. Votre vétérinaire vous attend, prêt à prendre soin de votre animal.</p>
					</div>
				</div>
			</div>
		</div>
	</div>

	 <script>

window.addEventListener('pageshow', function (event) {
    const isBackForward =
        event.persisted ||
        (performance.getEntriesByType('navigation')[0]?.type === 'back_forward');

    if (isBackForward && !sessionStorage.getItem('homeReloaded')) {
        sessionStorage.setItem('homeReloaded', 'true');
        window.location.reload();
    } else {
        sessionStorage.removeItem('homeReloaded');
    }
});

</script>
{% endblock %}
