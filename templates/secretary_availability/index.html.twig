{% extends 'base.html.twig' %}

{% block title %}Horaires vétérinaire
{% endblock %}

{% block body %}
	<div class="container py-4" data-controller="secretary-availability">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div>
				<h1 class="h3 mb-1">Horaires de Dr.
					{{ vet.prenom }}
					{{ vet.nom }}</h1>
				<p class="text-muted mb-0">{{ vet.email }}</p>
			</div>

			<button type="submit" form="secretary-availability-form" class="btn btn-primary px-4">
				Enregistrer
			</button>
		</div>

		<div class="card border-0 shadow-sm rounded-4 ">
			{{ form_start(form, {
            attr: {
                id: 'secretary-availability-form',
                novalidate: 'novalidate'
            }
        }) }}

			<div class="table-responsive">
				<table class="table custom-table align-middle mb-0">
					<thead>
						<tr>
							<th>Jour</th>
							<th>Ouvert</th>
							<th>Matin</th>
							<th>Après-midi</th>
							<th class="text-end">Actions</th>
						</tr>
					</thead>

					<tbody>
						{% for horaire in form.horaires %}
							{% set data = horaire.vars.data %}
							{% set day = data.dayOfWork %}
							{% set hasAfternoon = horaire.afternoonStart.vars.value and horaire.afternoonEnd.vars.value %}

							<tr data-secretary-availability-target="row" data-afternoon-visible="{{ hasAfternoon ? '1' : '0' }}" class="{{ day.isWorking ? '' : 'table-light' }}">
								<td class="fw-semibold">
									{{ day.jour.libelle }}
									{{ form_widget(horaire.dayOfWork, { attr: { class: 'd-none' } }) }}
								</td>

								<td>
									<div class="form-check form-switch">
										<input class="form-check-input" type="checkbox" name="working_days[]" value="{{ day.id }}" {{ day.isWorking ? 'checked' : '' }} data-secretary-availability-target="workingCheckbox" data-action="change->secretary-availability#toggleDay">
									</div>
								</td>

								<td>
									<div class="d-flex align-items-center gap-2" data-secretary-availability-target="morningFields">
										{{ form_widget(horaire.morningStart, { attr: { class: 'form-control form-control-sm' } }) }}
										<span class="text-muted">à</span>
										{{ form_widget(horaire.morningEnd, { attr: { class: 'form-control form-control-sm' } }) }}
									</div>
									{{ form_errors(horaire.morningEnd) }}
								</td>

								<td>
									<div class="d-flex align-items-center gap-2 {{ hasAfternoon ? '' : 'd-none' }}" data-secretary-availability-target="afternoonFields">
										{{ form_widget(horaire.afternoonStart, { attr: { class: 'form-control form-control-sm' } }) }}
										<span class="text-muted">à</span>
										{{ form_widget(horaire.afternoonEnd, { attr: { class: 'form-control form-control-sm' } }) }}
									</div>
									{{ form_errors(horaire.afternoonEnd) }}
								</td>

								<td class="text-end">
									<button type="button" class="btn btn-sm btn-outline-primary" data-secretary-availability-target="addAfternoonButton" data-action="secretary-availability#addAfternoon">
										<i class="bi bi-plus-lg"></i>
									</button>

									<button type="button" class="btn btn-sm btn-outline-danger" data-secretary-availability-target="removeButton" data-action="secretary-availability#removeSlot">
										<i class="bi bi-x-lg"></i>
									</button>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			<div class="card-body border-top d-flex justify-content-end gap-2 ">
				<a href="{{ path('app_vet_cabinet_index') }}" class="btn btn-outline-secondary">
					Annuler
				</a>

				<button type="submit" class="btn btn-primary">
					Enregistrer les horaires
				</button>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
