{% extends 'base_dashboard.html.twig' %}

{% block dashboard_body %}
	<style>
		.fc-toolbar-title {
			font-size: 1.25rem !important;
			font-weight: 500 !important;
			color: var(--bs-info) !important;
		}

		.slot-btn {
			width: 42px;
			height: 42px;
			flex-shrink: 0;
		}

		.afternoon-row {
			display: none;
		}

		.closed-text {
			display: none;
			font-size: 0.9rem;
		}

		.day-row.day-closed td {
			background-color: var(--bs-neutral-20, #EEEEEE);
			height: 73px;
		}

		.day-row.day-closed td:first-child {
			color: var(--bs-neutral-50);
		}

		.status-label {
			white-space: nowrap;
			min-width: 52px;
			font-size: 0.85rem;
		}

		.note-importante-box {
			border: 2px dashed var(--bs-info) !important;
			background: transparent;
		}

		.tw {
			position: relative;
			display: inline-flex;
			align-items: center;
			width: 140px;
			max-width: 100%;
		}

		.tw input {
			padding-right: 36px;
			width: 100%;
			height: 38px;
			background-color: transparent !important;
		}

		input[type="time"]::-webkit-calendar-picker-indicator {
			opacity: 0;
			position: absolute;
			right: 8px;
			width: 16px;
			height: 16px;
			cursor: pointer;
		}

		.tw .ampm-badge {
			position: absolute;
			left: 68px;
			font-size: 0.72rem;
			color: #6c757d;
			pointer-events: none;
			margin-left: 4px;
		}

		.tw .time-icon {
			position: absolute;
			right: 8px;
			color: #6c757d;
			pointer-events: none;
		}

		.tw.is-invalid input {
			border-color: var(--bs-danger) !important;
		}

		.add-afternoon-btn svg {
			width: 20px !important;
			height: 20px !important;
			stroke: var(--bs-primary);
			flex-shrink: 0;
		}

		.form-check-input {
			margin-top: 0 !important;
		}

		.open-fields {
			display: none;
		}

		.availability-table tbody td {
			vertical-align: top;
			padding-top: 1.25rem;
			padding-bottom: 1.25rem;
		}

		@media(max-width: 991.98px) {
			.fc .fc-toolbar {
				flex-direction: column;
				align-items: stretch;
				gap: 0.75rem;
			}

			.fc .fc-toolbar-chunk {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.fc .fc-button-group {
				display: flex;
				flex-wrap: wrap;
			}

			.availability-table,
			.availability-table thead,
			.availability-table tbody,
			.availability-table th,
			.availability-table td,
			.availability-table tr {
				display: block;
				width: 100%;
			}

			.availability-table thead {
				display: none;
			}

			.availability-table tbody tr {
				background: #fff;
				border: 1px solid var(--bs-border-color);
				border-radius: 1rem;
				padding: 1rem;
				margin-bottom: 1rem;
				box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, .075);
			}

			.availability-table tbody td {
				padding: 0 !important;
				border: 0 !important;
				height: auto !important;
				background: transparent !important;
			}

			.availability-table tbody td + td {
				margin-top: 0.9rem;
			}

			.mobile-label {
				display: block !important;
				font-size: 0.75rem;
				text-transform: uppercase;
				color: var(--bs-secondary-color);
				margin-bottom: 0.35rem;
				font-weight: 600;
			}

			.day-name-cell {
				font-size: 1rem;
				font-weight: 700;
				color: var(--bs-primary);
			}

			.actions-cell {
				text-align: left !important;
			}

			.open-fields > div,
			.afternoon-row {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem;
			}

			.tw {
				width: 100%;
				max-width: 180px;
			}

			.day-row.day-closed {
				background-color: var(--bs-neutral-20, #EEEEEE);
			}
		}

		@media(max-width: 575.98px) {
			.container-fluid {
				padding-left: 1rem !important;
				padding-right: 1rem !important;
			}

			.tw {
				max-width: 100%;
				width: 100%;
			}

			.slot-btn {
				width: 38px;
				height: 38px;
			}

			.fc-toolbar-title {
				font-size: 1rem !important;
				text-align: center;
			}
		}
	</style>

	<div class="container-fluid py-3 py-md-4 px-3 px-md-4">
		{% for message in app.flashes('success') %}
			<div class="alert alert-success rounded-3 border-0 shadow-sm">{{ message }}</div>
		{% endfor %}

		<div id="calendar-view">
			<h1 class="h4 fw-bold text-primary my-3">Mes disponibilités</h1>

			<div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2 mb-4 p-3 rounded-3 bg-primary-bg">
				<label for="calendar-date-picker" class="visually-hidden">Choisir une date dans le calendrier</label>

				<button
					class="btn btn-sm rounded-pill px-3 bg-white text-info w-100 w-md-auto"
					type="button"
					aria-label="Choisir une date dans le calendrier"
					title="Choisir une date"
					onclick="document.getElementById('calendar-date-picker').showPicker()">
					<i class="bi bi-calendar3 me-1" aria-hidden="true"></i>
					Date
					<i class="bi bi-chevron-down ms-1" aria-hidden="true"></i>
				</button>

				<input
					type="date"
					id="calendar-date-picker"
					aria-label="Choisir une date dans le calendrier"
					style="position:absolute; opacity:0; pointer-events:none; width:0; height:0;"
				>

				<button
					type="button"
					id="btn-show-form"
					class="btn btn-sm rounded-pill px-3 bg-white text-info w-100 w-md-auto ms-md-auto"
					aria-controls="form-view"
					aria-label="Ouvrir le formulaire de modification des horaires">
					<i class="bi bi-pencil me-1" aria-hidden="true"></i>
					Modifier mes horaires
				</button>
			</div>

			<div class="mx-auto w-100" style="max-width:1106px;">
				<div id="calendar"></div>
			</div>
		</div>

		<div id="form-view" style="display:none;">
			<div class="d-flex flex-column flex-xl-row justify-content-between align-items-stretch align-items-xl-start gap-3 mb-4 mx-auto w-100" style="max-width:1106px;">
				<div class="flex-grow-1">
					<h2 class="h3 fw-bold text-primary mb-1">Gestion des disponibilités</h2>
					<p class="text-muted mb-0">Configurez vos horaires hebdomadaires et vos plages de consultation.</p>
				</div>

				<div class="d-grid d-sm-flex gap-2 align-items-stretch flex-shrink-0">
					<button
						type="button"
						id="btn-apply-week"
						class="btn bg-white border rounded-4 px-4 fw-semibold text-primary"
						aria-label="Appliquer les horaires du premier jour à toute la semaine">
						<i class="bi bi-copy me-2" aria-hidden="true"></i>Appliquer à toute la semaine
					</button>

					<button
						type="submit"
						form="disponibilite-form"
						class="btn btn-primary text-white rounded-4 px-4 fw-semibold"
						aria-label="Enregistrer les disponibilités">
						<i class="bi bi-save me-2" aria-hidden="true"></i>Enregistrer
					</button>
				</div>
			</div>

			<div class=" rounded-4 mx-auto w-100 overflow-hidden" style="max-width:1106px;">
				{{ form_start(form, { attr: { novalidate: 'novalidate', id: 'disponibilite-form' } }) }}

				<div class="table-responsive">
					<table class="table align-middle availability-table mb-0" style="--bs-table-bg: transparent;">
						<thead class="border-bottom">
							<tr class="text-uppercase small text-muted text-neutral-80">
								<th class="fw-semibold ps-4 py-3 text-nowrap" style="width:240px;">Jour de la semaine</th>
								<th class="fw-semibold py-3" style="width:200px;">Statut</th>
								<th class="fw-semibold py-3">Plages horaires</th>
								<th class="fw-semibold py-3 pe-4 text-center" style="width:72px;">Actions</th>
							</tr>
						</thead>

						<tbody>
							{% for horaire in form.horaires %}
								{% set data = horaire.vars.data %}
								{% set hasAfternoon = horaire.afternoonStart.vars.value and horaire.afternoonStart.vars.value != '00:00' %}
								{% set errorId = 'errors-' ~ data.dayOfWork.id %}
								{% set statusId = 'status-' ~ data.dayOfWork.id %}
								{% set morningStartId = 'morning-start-' ~ data.dayOfWork.id %}
								{% set morningEndId = 'morning-end-' ~ data.dayOfWork.id %}
								{% set afternoonStartId = 'afternoon-start-' ~ data.dayOfWork.id %}
								{% set afternoonEndId = 'afternoon-end-' ~ data.dayOfWork.id %}

								<tr class="day-row {{ data.dayOfWork.isWorking ? '' : 'day-closed' }}" data-day-id="{{ data.dayOfWork.id }}" data-afternoon-visible="{{ hasAfternoon ? '1' : '0' }}">
									<td class="fw-semibold ps-lg-4 day-name-cell">
										<span class="mobile-label d-none">Jour</span>
										{{ data.dayOfWork.jour.libelle }}
									</td>

									<td>
										<span class="mobile-label d-none">Statut</span>
										<div class="form-check form-switch d-flex align-items-center gap-2 mb-0">
											<input
												class="form-check-input day-checkbox"
												type="checkbox"
												name="working_days[]"
												value="{{ data.dayOfWork.id }}"
												id="day_{{ data.dayOfWork.id }}"
												data-day-id="{{ data.dayOfWork.id }}"
												role="switch"
												aria-label="Activer ou désactiver les disponibilités du {{ data.dayOfWork.jour.libelle }}"
												aria-describedby="{{ statusId }}"
												{{ data.dayOfWork.isWorking ? 'checked' : '' }}
											>
											<label class="form-check-label fw-medium mb-0 status-label" for="day_{{ data.dayOfWork.id }}" id="{{ statusId }}" aria-live="polite">
												{{ data.dayOfWork.isWorking ? 'OUVERT' : 'FERMÉ' }}
											</label>
										</div>
									</td>

									<td class="py-3">
										<span class="mobile-label d-none">Plages horaires</span>

										<div class="open-fields">
											<div class="d-flex align-items-center flex-wrap gap-2">
												<label for="{{ morningStartId }}" class="visually-hidden">Heure de début du matin pour {{ data.dayOfWork.jour.libelle }}</label>
												<div class="tw">
													{{ form_widget(horaire.morningStart, {
														attr: {
															id: morningStartId,
															class: 'form-control time-no-icon morning-start',
															'aria-label': 'Heure de début du matin pour ' ~ data.dayOfWork.jour.libelle,
															'aria-describedby': errorId
														}
													}) }}
													<span class="ampm-badge" aria-hidden="true"></span>
													<i data-lucide="clock" class="time-icon" style="width:20px;height:20px;" aria-hidden="true"></i>
												</div>

												<span class="text-neutral-60" aria-hidden="true">à</span>

												<label for="{{ morningEndId }}" class="visually-hidden">Heure de fin du matin pour {{ data.dayOfWork.jour.libelle }}</label>
												<div class="tw">
													{{ form_widget(horaire.morningEnd, {
														attr: {
															id: morningEndId,
															class: 'form-control time-no-icon morning-end',
															'aria-label': 'Heure de fin du matin pour ' ~ data.dayOfWork.jour.libelle,
															'aria-describedby': errorId
														}
													}) }}
													<span class="ampm-badge" aria-hidden="true"></span>
													<i data-lucide="clock" class="time-icon" style="width:20px;height:20px;" aria-hidden="true"></i>
												</div>

												<button
													type="button"
													class="btn btn-light rounded-circle slot-btn add-afternoon-btn d-flex align-items-center justify-content-center"
													aria-label="Ajouter un créneau l'après-midi pour {{ data.dayOfWork.jour.libelle }}"
													title="Ajouter un créneau l'après-midi">
													<i data-lucide="plus" aria-hidden="true"></i>
												</button>
											</div>

											<div class="afternoon-row mt-2 align-items-center flex-wrap gap-2">
												<label for="{{ afternoonStartId }}" class="visually-hidden">Heure de début de l'après-midi pour {{ data.dayOfWork.jour.libelle }}</label>
												<div class="tw">
													{{ form_widget(horaire.afternoonStart, {
														attr: {
															id: afternoonStartId,
															class: 'form-control time-no-icon afternoon-start',
															'aria-label': 'Heure de début de l\'après-midi pour ' ~ data.dayOfWork.jour.libelle,
															'aria-describedby': errorId
														}
													}) }}
													<span class="ampm-badge" aria-hidden="true"></span>
													<i data-lucide="clock" class="time-icon" style="width:20px;height:20px;" aria-hidden="true"></i>
												</div>

												<span class="text-neutral-60" aria-hidden="true">à</span>

												<label for="{{ afternoonEndId }}" class="visually-hidden">Heure de fin de l'après-midi pour {{ data.dayOfWork.jour.libelle }}</label>
												<div class="tw">
													{{ form_widget(horaire.afternoonEnd, {
														attr: {
															id: afternoonEndId,
															class: 'form-control time-no-icon afternoon-end',
															'aria-label': 'Heure de fin de l\'après-midi pour ' ~ data.dayOfWork.jour.libelle,
															'aria-describedby': errorId
														}
													}) }}
													<span class="ampm-badge" aria-hidden="true"></span>
													<i data-lucide="clock" class="time-icon" style="width:20px;height:20px;" aria-hidden="true"></i>
												</div>

												<button
													type="button"
													class="btn btn-light rounded-circle slot-btn remove-afternoon-btn d-flex align-items-center justify-content-center"
													aria-label="Supprimer le créneau de l'après-midi pour {{ data.dayOfWork.jour.libelle }}"
													title="Supprimer le créneau de l'après-midi">
													<i data-lucide="x" style="width:18px;height:18px;" aria-hidden="true"></i>
												</button>
											</div>
										</div>

										<p class="closed-text text-neutral-50 mb-0">Aucune plage horaire définie</p>

										<div class="d-none">
											{{ form_widget(horaire.dayOfWork) }}
										</div>

										<div class="mt-1" id="{{ errorId }}" aria-live="polite">
											{{ form_errors(horaire.morningEnd) }}
											{{ form_errors(horaire.afternoonEnd) }}
										</div>
									</td>

									<td class="text-center pe-lg-4 actions-cell">
										<span class="mobile-label d-none">Actions</span>
										<button
											type="button"
											class="btn btn-link text-neutral-50 reset-day-btn p-0"
											aria-label="Réinitialiser les horaires de {{ data.dayOfWork.jour.libelle }}"
											title="Réinitialiser la journée">
											<i data-lucide="trash-2" aria-hidden="true"></i>
										</button>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				{{ form_end(form) }}
			</div>

			<div class="mx-auto w-100" style="max-width:1106px; margin-top:1.5rem;">
				<div class="rounded-3 p-3 p-md-4 note-importante-box">
					<p class="fw-bold text-info mb-2">
						<i class="bi bi-info-circle me-1" aria-hidden="true"></i>
						Note importante
					</p>
					<p class="mb-0 text-muted">
						Les modifications apportées ici s'appliquent immédiatement à votre calendrier de prise de rendez-vous en ligne.
						Pour des exceptions ponctuelles (vacances, urgences), veuillez utiliser l'onglet "Calendrier".
					</p>
				</div>
			</div>

			<div class="d-grid d-md-flex justify-content-md-end gap-2 gap-md-3 mt-4 pb-4 mx-auto w-100" style="max-width:1106px;">
				<button
					type="button"
					id="btn-back-calendar"
					class="btn bg-light text-neutral-60 rounded-4 px-4 px-md-5 fw-semibold"
					aria-controls="calendar-view"
					aria-label="Revenir à la vue calendrier">
					ANNULER
				</button>

				<button
					type="submit"
					form="disponibilite-form"
					class="btn btn-primary text-white rounded-4 px-4 px-md-5 fw-semibold"
					aria-label="Enregistrer mes disponibilités">
					Enregistrer mes disponibilités
				</button>
			</div>
		</div>
	</div>

	<link href="https://unpkg.com/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet">
	<script src="https://unpkg.com/fullcalendar@6.1.11/index.global.min.js"></script>
	<script src="https://unpkg.com/fullcalendar@6.1.11/locales/fr.global.min.js"></script>
	<script src="https://unpkg.com/lucide@latest"></script>

	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const calendarView = document.getElementById('calendar-view');
			const formView = document.getElementById('form-view');
			const btnShowForm = document.getElementById('btn-show-form');
			const btnBackCalendar = document.getElementById('btn-back-calendar');
			const btnApplyWeek = document.getElementById('btn-apply-week');
			const datePicker = document.getElementById('calendar-date-picker');
			const formEl = document.getElementById('disponibilite-form');

			function updateAmPm(row) {
				row.querySelectorAll('.ampm-badge').forEach(function (badge, i) {
					const inputs = row.querySelectorAll('input[type="time"]');
					const input = inputs[i];
					if (!input) return;
					const val = input.value;
					badge.textContent =
						!val || val === '00:00'
							? ''
							: parseInt(val.split(':')[0], 10) < 12
								? 'AM'
								: 'PM';
				});
			}

			const calendar = new FullCalendar.Calendar(
				document.getElementById('calendar'),
				{
					locale: 'fr',
					initialView: window.innerWidth < 768 ? 'timeGridDay' : 'timeGridWeek',
					headerToolbar: {
						left: 'prev,next today',
						center: 'title',
						right: 'timeGridWeek,timeGridDay',
					},
					slotMinTime: '07:00:00',
					slotMaxTime: '23:59:00',
					slotDuration: '00:30:00',
					allDaySlot: false,
					nowIndicator: true,
					height: 'auto',
					eventSources: [{ url: '{{ path("api_availability") }}' }],
					buttonText: {
						today: "Aujourd'hui",
						week: 'Semaine',
						day: 'Jour',
					},
				}
			);

			calendar.render();

			datePicker?.addEventListener('change', function () {
				if (this.value) {
					calendar.gotoDate(this.value);
					this.value = '';
				}
			});

			btnShowForm?.addEventListener('click', function () {
				calendarView.style.display = 'none';
				formView.style.display = 'block';
			});

			btnBackCalendar?.addEventListener('click', function () {
				formView.style.display = 'none';
				calendarView.style.display = 'block';
			});

			function updateRow(row) {
				const checkbox = row.querySelector('.day-checkbox');
				const status = row.querySelector('.status-label');
				const openFields = row.querySelector('.open-fields');
				const closedText = row.querySelector('.closed-text');
				const afternoon = row.querySelector('.afternoon-row');
				const isOpen = checkbox.checked;
				const hasAfternoon = row.dataset.afternoonVisible === '1';

				status.textContent = isOpen ? 'OUVERT' : 'FERMÉ';
				status.classList.toggle('text-primary', isOpen);
				status.classList.toggle('text-neutral-50', !isOpen);

				if (hasAfternoon) {
					afternoon.classList.remove('d-none');
				} else {
					afternoon.classList.add('d-none');
				}

				if (isOpen) {
					row.classList.remove('day-closed');
					openFields.style.display = 'block';
					closedText.style.display = 'none';
					afternoon.style.display = hasAfternoon ? 'flex' : 'none';
				} else {
					row.classList.add('day-closed');
					openFields.style.display = 'none';
					closedText.style.display = 'block';
					afternoon.style.display = 'none';
				}
			}

			document.querySelectorAll('.day-row').forEach(function (row) {
				const checkbox = row.querySelector('.day-checkbox');
				const addBtn = row.querySelector('.add-afternoon-btn');
				const removeBtn = row.querySelector('.remove-afternoon-btn');
				const resetBtn = row.querySelector('.reset-day-btn');
				const afternoonStart = row.querySelector('.afternoon-start');
				const afternoonEnd = row.querySelector('.afternoon-end');
				const morningStart = row.querySelector('.morning-start');
				const morningEnd = row.querySelector('.morning-end');

				updateRow(row);
				updateAmPm(row);

				checkbox.addEventListener('change', () => {
					updateRow(row);
					updateAmPm(row);
				});

				addBtn.addEventListener('click', function () {
					checkbox.checked = true;
					row.dataset.afternoonVisible = '1';
					row.querySelector('.afternoon-row').style.display = 'flex';

					if (!afternoonStart.value || afternoonStart.value === '00:00') afternoonStart.value = '14:00';
					if (!afternoonEnd.value || afternoonEnd.value === '00:00') afternoonEnd.value = '18:00';

					updateRow(row);
					updateAmPm(row);
				});

				removeBtn.addEventListener('click', function () {
					row.dataset.afternoonVisible = '0';
					afternoonStart.value = '';
					afternoonEnd.value = '';
					row.querySelector('.afternoon-row').classList.add('d-none');
					updateRow(row);
					updateAmPm(row);
				});

				resetBtn.addEventListener('click', function () {
					checkbox.checked = false;
					row.dataset.afternoonVisible = '0';
					morningStart.value = '';
					morningEnd.value = '';
					afternoonStart.value = '';
					afternoonEnd.value = '';
					updateRow(row);
					updateAmPm(row);
				});

				row.querySelectorAll('input[type="time"]').forEach(function (input) {
					input.addEventListener('change', () => updateAmPm(row));
				});
			});

			btnApplyWeek?.addEventListener('click', function () {
				const rows = document.querySelectorAll('.day-row');
				const monday = rows[0];
				if (!monday) return;

				const srcOpen = monday.querySelector('.day-checkbox').checked;
				const srcMorningStart = monday.querySelector('.morning-start').value;
				const srcMorningEnd = monday.querySelector('.morning-end').value;
				const srcAfternoonStart = monday.querySelector('.afternoon-start').value;
				const srcAfternoonEnd = monday.querySelector('.afternoon-end').value;
				const srcAfternoon = monday.dataset.afternoonVisible;

				rows.forEach(function (row, index) {
					if (index === 0) return;
					row.querySelector('.day-checkbox').checked = srcOpen;
					row.querySelector('.morning-start').value = srcMorningStart;
					row.querySelector('.morning-end').value = srcMorningEnd;
					row.querySelector('.afternoon-start').value = srcAfternoonStart;
					row.querySelector('.afternoon-end').value = srcAfternoonEnd;
					row.dataset.afternoonVisible = srcAfternoon;
					updateRow(row);
					updateAmPm(row);
				});
			});

			formEl?.addEventListener('submit', function (e) {
				e.preventDefault();

				let hasError = false;

				document.querySelectorAll('.day-row').forEach(function (row) {
					const checkbox = row.querySelector('.day-checkbox');

					if (!checkbox.checked) {
						row.querySelector('.morning-start').value = '';
						row.querySelector('.morning-end').value = '';
						row.querySelector('.afternoon-start').value = '';
						row.querySelector('.afternoon-end').value = '';
						return;
					}

					const morningEnd = row.querySelector('.morning-end').value;
					const afternoonStart = row.querySelector('.afternoon-start').value;

					if (row.dataset.afternoonVisible === '1' && morningEnd && afternoonStart) {
						if (afternoonStart <= morningEnd) {
							hasError = true;
							row.querySelector('.morning-end').closest('.tw').classList.add('is-invalid');
							row.querySelector('.afternoon-start').closest('.tw').classList.add('is-invalid');
						} else {
							row.querySelector('.morning-end').closest('.tw').classList.remove('is-invalid');
							row.querySelector('.afternoon-start').closest('.tw').classList.remove('is-invalid');
						}
					}
				});

				if (hasError) {
					alert("Les plages horaires se chevauchent. L'heure de début de l'après-midi doit être après la fin du matin.");
					return;
				}

				fetch(window.location.href, {
					method: 'POST',
					body: new FormData(formEl),
					headers: { 'X-Requested-With': 'XMLHttpRequest' },
				})
					.then((res) => res.json())
					.then((data) => {
						if (data.success) {
							formView.style.display = 'none';
							calendarView.style.display = 'block';
							calendar.refetchEvents();
						}
					})
					.catch(() => alert('Une erreur est survenue.'));
			});

			if (window.lucide) lucide.createIcons();
		});
	</script>
{% endblock %}