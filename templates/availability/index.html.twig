{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('availability') }}
{% endblock %}

{% block body %}
	<div class="container-fluid py-3 py-md-4 px-3 px-md-4">
		<div id="calendar-view">
			<div class="d-flex flex-column flex-lg-row justify-content-between align-items-stretch align-items-lg-center gap-3 my-3 mx-auto w-100" style="max-width:1106px;">
				<div>
					<h1 class="h4 fw-bold text-primary mb-1">Mes disponibilités</h1>
					<p class="text-muted small mb-0">Consultez votre planning récurrent et ajustez vos horaires.</p>
				</div>

				<div class="calendar-actions-bar d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 px-2 py-2 border-0">
					<label for="calendar-date-picker" class="visually-hidden">Choisir une date dans le calendrier</label>

					<button class="btn btn-light border rounded-pill px-3 py-2 text-info w-100 w-sm-auto" type="button" onclick="document.getElementById('calendar-date-picker').showPicker()">
						<i class="bi bi-calendar3 me-1"></i>
						Date
						<i class="bi bi-chevron-down ms-1"></i>
					</button>

					<button type="button" id="btn-show-form" class="btn btn-primary rounded-pill px-3 py-2 text-white w-100 w-sm-auto text-nowrap">
						<i class="bi bi-pencil me-1"></i>
						Modifier mes horaires
					</button>

					<input type="date" id="calendar-date-picker" aria-label="Choisir une date dans le calendrier" style="position:absolute; opacity:0; pointer-events:none; width:0; height:0;">
				</div>
			</div>

			<div class="mx-auto w-100" style="max-width:1106px;">
				<div id="calendar"></div>
			</div>
		</div>

		{% include 'availability/_form_view.html.twig' %}
	</div>

	{% include 'availability/_scripts.html.twig' %}
{% endblock %}
