{% extends 'base_dashboard.html.twig' %}

{% block dashboard_body %}
	<style>

		.fc-toolbar-title {
			font-size: 1.25rem !important;
			font-weight: 500 !important;
			color: var(--bs-info) !important;
		}

		.slot-btn {
			width: 42px;
			height: 42px;
			flex-shrink: 0;
		}
		.slot-line {
			min-height: 42px;
		}
		.afternoon-row {
			display: none;
		}
		.closed-text {
			display: none;
		}
		.day-row.day-closed td {
			background-color: var(--bs-neutral-20, #EEEEEE);
			height: 73px;

		}

		.day-row.day-closed td:first-child {
			color: var(--bs-neutral-50);
		}

		.status-label {
			white-space: nowrap;
			min-width: 52px;
			font-size: 0.85rem;

		}
		.note-importante-box {
			border: 2px dashed var(--bs-info) !important;
			background: transparent;
		}
		.tw {
			position: relative;
			display: inline-flex;
			align-items: center;
		}
		.tw input {
			padding-right: 36px;
			width: 140px;
			height: 38px;
			background-color: transparent !important;

		}
		input[type="time"]::-webkit-calendar-picker-indicator {
			opacity: 0;
			position: absolute;
			right: 8px;
			width: 16px;
			height: 16px;
			cursor: pointer;
		}
		.tw .ampm-badge {
			position: absolute;
			left: 68px;
			font-size: 0.72rem;
			color: #6c757d;
			pointer-events: none;
			margin-left: 4px;
		}
		.tw .time-icon {
			position: absolute;
			right: 8px;
			color: #6c757d;
			pointer-events: none;
		}
		.tw.is-invalid input {
			border-color: var(--bs-danger) !important;
		}
		.add-afternoon-btn svg {
			width: 20px !important;
			height: 20px !important;
			stroke: var(--bs-primary);
			flex-shrink: 0;
		}
		.form-check-input {
			margin-top: 0 !important;
		}
		.open-fields {
			display: none;
		}
		.closed-text {
			display: none;
			font-size: 0.9rem;

		}

		.availability-table tbody td {
			vertical-align: top;
			padding-top: 1.25rem;
		}
	</style>

	<div class="container-fluid py-4 px-4">


		{% for message in app.flashes('success') %}
			<div class="alert alert-success rounded-3 border-0 shadow-sm">{{ message }}</div>
		{% endfor %}

		<div id="calendar-view">
			<h1 class="h4 fw-bold text-primary my-3">Mes disponibilités</h1>
			<div class="d-flex align-items-center gap-2 mb-4 p-3 rounded-3 bg-primary-bg">
				<button class="btn btn-sm rounded-pill px-3 bg-white text-info" type="button" onclick="document.getElementById('calendar-date-picker').showPicker()">
					<i class="bi bi-calendar3 me-1"></i>
					Date
					<i class="bi bi-chevron-down ms-1"></i>
				</button>
				<input type="date" id="calendar-date-picker" style="position:absolute; opacity:0; pointer-events:none; width:0; height:0;">
				<button type="button" id="btn-show-form" class="btn btn-sm rounded-pill px-3 bg-white text-info ms-auto">
					<i class="bi bi-pencil me-1"></i>
					Modifier mes horaires
				</button>
			</div>
			<div style="max-width:1106px; margin:0 auto; width:100%;">
				<div id="calendar"></div>
			</div>
		</div>

		<div id="form-view" style="display:none;">

			<div class="d-flex justify-content-between align-items-start mb-4" style="max-width:1106px; margin:0 auto; width:100%;">
				<div>
					<h2 class="h3 fw-bold text-primary mb-1">Gestion des disponibilités</h2>
					<p class="text-muted mb-0">Configurez vos horaires hebdomadaires et vos plages de consultation.</p>
				</div>
				<div class="d-flex gap-2 align-items-center flex-shrink-0 ms-4">
					<button type="button" id="btn-apply-week" class="btn bg-white border rounded-4 px-4 fw-semibold text-primary" style="height:58px;">
						<i class="bi bi-copy me-2"></i>Appliquer à toute la semaine
					</button>

					<button type="submit" form="disponibilite-form" class="btn btn-primary text-white rounded-4 px-4 fw-semibold" style="height:58px;">
						<i class="bi bi-save me-2"></i>Enregistrer
					</button>
				</div>
			</div>

			<div class="bg-white rounded-4 shadow-sm " style="max-width:1106px; margin:0 auto; width:100%;">

				{{ form_start(form, { attr: { novalidate: 'novalidate', id: 'disponibilite-form' } }) }}

				<div class="table-responsive">
					<table class="table align-middle availability-table mb-0" style="--bs-table-bg: transparent;">
						<thead class="border-bottom">
							<tr class="text-uppercase small text-muted text-neutral-80">
								<th class="fw-semibold ps-4 py-3 text-nowrap" style="width:240px;">Jour de la semaine</th>
								<th class="fw-semibold py-3" style="width:200px;">Statut</th>
								<th class="fw-semibold py-3">Plages horaires</th>
								<th class="fw-semibold py-3 pe-4 text-center" style="width:72px;">Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for horaire in form.horaires %}
								{% set data = horaire.vars.data %}
								{% set hasAfternoon = horaire.afternoonStart.vars.value and horaire.afternoonStart.vars.value != '00:00' %}
								<tr class="day-row {{ data.dayOfWork.isWorking ? '' : 'day-closed' }}" data-day-id="{{ data.dayOfWork.id }}" data-afternoon-visible="{{ hasAfternoon ? '1' : '0' }}">
									<td class="fw-semibold ps-4 ">{{ data.dayOfWork.jour.libelle }}</td>


									<td>
										<div class="form-check form-switch d-flex align-items-center gap-2 mb-0">
											<input class="form-check-input day-checkbox" type="checkbox" name="working_days[]" value="{{ data.dayOfWork.id }}" id="day_{{ data.dayOfWork.id }}" data-day-id="{{ data.dayOfWork.id }}" {{ data.dayOfWork.isWorking ? 'checked' : '' }}>
											<label class="form-check-label fw-medium mb-0 status-label" for="day_{{ data.dayOfWork.id }}">
												{{ data.dayOfWork.isWorking ? 'OUVERT' : 'FERMÉ' }}
											</label>
										</div>
									</td>

									<td class="py-3">
										<div class="open-fields">
											<div class="d-flex align-items-center flex-wrap gap-2">
												<div class="tw">{{ form_widget(horaire.morningStart, { attr: { class: 'form-control time-no-icon morning-start' } }) }}<span class="ampm-badge"></span>
													<i data-lucide="clock" class="time-icon" style="width:20px;height:20px;"></i>

												</div>
												<span class="text-neutral-60">à</span>
												<div class="tw">{{ form_widget(horaire.morningEnd, { attr: { class: 'form-control time-no-icon morning-end' } }) }}<span class="ampm-badge"></span>
													<i data-lucide="clock" class="time-icon" style="width:20px;height:20px;"></i>

												</div>
												<button type="button" class="btn btn-light rounded-circle slot-btn add-afternoon-btn d-flex align-items-center justify-content-center">
													<i data-lucide="plus"></i>
												</button>
											</div>

											<div class="afternoon-row mt-2 align-items-center flex-wrap gap-2">
												<div class="tw">{{ form_widget(horaire.afternoonStart, { attr: { class: 'form-control time-no-icon afternoon-start' } }) }}<span class="ampm-badge"></span>
													<i data-lucide="clock" class="time-icon" style="width:20px;height:20px;"></i>

												</div>
												<span class="text-neutral-60">à</span>
												<div class="tw">{{ form_widget(horaire.afternoonEnd, { attr: { class: 'form-control time-no-icon afternoon-end' } }) }}<span class="ampm-badge"></span>
													<i data-lucide="clock" class="time-icon" style="width:20px;height:20px;"></i>

												</div>
												<button type="button" class="btn btn-light rounded-circle slot-btn remove-afternoon-btn d-flex align-items-center justify-content-center">
													<i data-lucide="x" style="width:18px;height:18px;"></i>
												</button>
											</div>
										</div>

										<p class="closed-text text-neutral-50 mb-0">Aucune plage horaire définie</p>

										<div class="d-none">
											{{ form_widget(horaire.dayOfWork) }}
										</div>

										<div class="mt-1">
											{{ form_errors(horaire.morningEnd) }}
											{{ form_errors(horaire.afternoonEnd) }}
										</div>
									</td>

									<td class="text-center pe-4">
										<button type="button" class="btn btn-link text-neutral-50 reset-day-btn p-0">
											<i data-lucide="trash-2"></i>
										</button>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				{{ form_end(form) }}
			</div>

			<div style="max-width:1106px; margin:1.5rem auto 0; width:100%;">
				<div class="rounded-3 p-4 note-importante-box">
					<p class="fw-bold text-info mb-2">
						<i class="bi bi-info-circle me-1"></i>
						Note importante
					</p>
					<p class="mb-0 text-muted">
						Les modifications apportées ici s'appliquent immédiatement à votre calendrier de prise de rendez-vous en ligne.
																																																																																																																																																																		Pour des exceptions ponctuelles (vacances, urgences), veuillez utiliser l'onglet "Calendrier".
					</p>
				</div>
			</div>

			<div class="d-flex justify-content-end gap-3 mt-4 pb-4" style="max-width:1106px; margin-left:auto; margin-right:auto; width:100%;">
				<button type="button" id="btn-back-calendar" class="btn bg-light text-neutral-60 rounded-4 px-5 fw-semibold" style="height:58px;">
					ANNULER
				</button>

				<button type="submit" form="disponibilite-form" class="btn btn-primary text-white rounded-4 px-5 fw-semibold" style="height:58px;">
					Enregistrer mes disponibilités</button>
			</div>

		</div>
	</div>

	<link href="https://unpkg.com/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet">
 <script src="https://unpkg.com/fullcalendar@6.1.11/index.global.min.js"></script>
	 <script src="https://unpkg.com/fullcalendar@6.1.11/locales/fr.global.min.js"></script>
	 <script src="https://unpkg.com/lucide@latest"></script>

	 <script>
																				document.addEventListener('DOMContentLoaded', function () {
																    const calendarView    = document.getElementById('calendar-view');
																    const formView        = document.getElementById('form-view');
																    const btnShowForm     = document.getElementById('btn-show-form');
																    const btnBackCalendar = document.getElementById('btn-back-calendar');
																    const btnApplyWeek    = document.getElementById('btn-apply-week');
																    const datePicker      = document.getElementById('calendar-date-picker');
																    const formEl          = document.getElementById('disponibilite-form');
																
																    // ── AM/PM ─────────────────────────────────────────────────────────────
																    function updateAmPm(row) {
																        row.querySelectorAll('.ampm-badge').forEach(function (badge, i) {
																            const inputs = row.querySelectorAll('input[type="time"]');
																            const input  = inputs[i];
																            if (!input) return;
																            const val = input.value;
																            badge.textContent = (!val || val === '00:00') ? '' : (parseInt(val.split(':')[0], 10) < 12 ? 'AM' : 'PM');
																        });
																    }
																
																    // ── Calendrier ────────────────────────────────────────────────────────
																    const calendar = new FullCalendar.Calendar(document.getElementById('calendar'), {
																        locale: 'fr',
																        initialView: 'timeGridWeek',
																        headerToolbar: {
																            left:   'prev,next today',
																            center: 'title',
																            right:  'timeGridWeek,timeGridDay'
																        },
																        slotMinTime:  '07:00:00',
																        slotMaxTime:  '23:59:00',
																        slotDuration: '00:30:00',
																        allDaySlot:   false,
																        nowIndicator: true,
																        height: 'auto',
																        eventSources: [{ url: '{{ path("api_availability") }}' }],
																        buttonText: {
																            today: "Aujourd'hui",
																            week:  'Semaine',
																            day:   'Jour'
																        }
																    });
																
																    calendar.render();
																
																    datePicker?.addEventListener('change', function () {
																        if (this.value) {
																            calendar.gotoDate(this.value);
																            this.value = '';
																        }
																    });
																
																    btnShowForm?.addEventListener('click', function () {
																        calendarView.style.display = 'none';
																        formView.style.display = 'block';
																    });
																
																    btnBackCalendar?.addEventListener('click', function () {
																        formView.style.display = 'none';
																        calendarView.style.display = 'block';
																    });
																
																    // ── Mise à jour visuelle d'une ligne ──────────────────────────────────
																    function updateRow(row) {
																        const checkbox       = row.querySelector('.day-checkbox');
																        const status         = row.querySelector('.status-label');
																        const openFields     = row.querySelector('.open-fields');
																        const closedText     = row.querySelector('.closed-text');
																        const afternoon      = row.querySelector('.afternoon-row');
																        const isOpen         = checkbox.checked;
																        const hasAfternoon   = row.dataset.afternoonVisible === '1';
																
																        status.textContent = isOpen ? 'OUVERT' : 'FERMÉ';
																		status.classList.toggle('text-primary', isOpen);
																		status.classList.toggle('text-neutral-50', !isOpen);
																		if (hasAfternoon) {
							    afternoon.classList.remove('d-none');
							} else {
							    afternoon.classList.add('d-none');
							}
																
																        if (isOpen) {
																            row.classList.remove('day-closed');
																            openFields.style.display = 'block';
																            closedText.style.display = 'none';
																            afternoon.style.display  = hasAfternoon ? 'flex' : 'none';
																        } else {
																            row.classList.add('day-closed');
																            openFields.style.display = 'none';
																            closedText.style.display = 'block';
																            afternoon.style.display  = 'none';
																        }
																    }
																
																    // ── Listeners par ligne ───────────────────────────────────────────────
																    document.querySelectorAll('.day-row').forEach(function (row) {
																        const checkbox       = row.querySelector('.day-checkbox');
																        const addBtn         = row.querySelector('.add-afternoon-btn');
																        const removeBtn      = row.querySelector('.remove-afternoon-btn');
																        const resetBtn       = row.querySelector('.reset-day-btn');
																        const afternoonStart = row.querySelector('.afternoon-start');
																        const afternoonEnd   = row.querySelector('.afternoon-end');
																        const morningStart   = row.querySelector('.morning-start');
																        const morningEnd     = row.querySelector('.morning-end');
																
																        updateRow(row);
																        updateAmPm(row);
																
																        checkbox.addEventListener('change', () => { updateRow(row); updateAmPm(row); });
																
																        addBtn.addEventListener('click', function () {
																            checkbox.checked = true;
																            row.dataset.afternoonVisible = '1';
																			row.querySelector('.afternoon-row').style.display = 'flex';
																            if (!afternoonStart.value || afternoonStart.value === '00:00') afternoonStart.value = '14:00';
																            if (!afternoonEnd.value   || afternoonEnd.value   === '00:00') afternoonEnd.value   = '18:00';
																            updateRow(row);
																            updateAmPm(row);
																        });
																
																        removeBtn.addEventListener('click', function () {
																			row.dataset.afternoonVisible = '0';
																			afternoonStart.value = '';
																			afternoonEnd.value   = '';
							    row.querySelector('.afternoon-row').classList.add('d-none');
																			updateRow(row);
																			updateAmPm(row);
																		});
																
																        resetBtn.addEventListener('click', function () {
																            checkbox.checked             = false;
																            row.dataset.afternoonVisible = '0';
																            morningStart.value           = '';
																            morningEnd.value             = '';
																            afternoonStart.value         = '';
																            afternoonEnd.value           = '';
																            updateRow(row);
																            updateAmPm(row);
																        });
																
																        row.querySelectorAll('input[type="time"]').forEach(function (input) {
																            input.addEventListener('change', () => updateAmPm(row));
																        });
																    });
																
																    // ── Appliquer à toute la semaine ──────────────────────────────────────
																    btnApplyWeek?.addEventListener('click', function () {
																        const rows   = document.querySelectorAll('.day-row');
																        const monday = rows[0];
																        if (!monday) return;
																
																        const srcOpen           = monday.querySelector('.day-checkbox').checked;
																        const srcMorningStart   = monday.querySelector('.morning-start').value;
																        const srcMorningEnd     = monday.querySelector('.morning-end').value;
																        const srcAfternoonStart = monday.querySelector('.afternoon-start').value;
																        const srcAfternoonEnd   = monday.querySelector('.afternoon-end').value;
																        const srcAfternoon      = monday.dataset.afternoonVisible;
																
																        rows.forEach(function (row, index) {
																            if (index === 0) return;
																            row.querySelector('.day-checkbox').checked      = srcOpen;
																            row.querySelector('.morning-start').value       = srcMorningStart;
																            row.querySelector('.morning-end').value         = srcMorningEnd;
																            row.querySelector('.afternoon-start').value     = srcAfternoonStart;
																            row.querySelector('.afternoon-end').value       = srcAfternoonEnd;
																            row.dataset.afternoonVisible                    = srcAfternoon;
																            updateRow(row);
																            updateAmPm(row);
																        });
																    });
																
																    // ── Soumission AJAX ───────────────────────────────────────────────────
																    formEl?.addEventListener('submit', function (e) {
			    e.preventDefault();
			
			    let hasError = false;
			
			    document.querySelectorAll('.day-row').forEach(function (row) {
			        const checkbox = row.querySelector('.day-checkbox');
			        if (!checkbox.checked) {
			            row.querySelector('.morning-start').value   = '';
			            row.querySelector('.morning-end').value     = '';
			            row.querySelector('.afternoon-start').value = '';
			            row.querySelector('.afternoon-end').value   = '';
			            return;
			        }
			
			        const morningEnd     = row.querySelector('.morning-end').value;
			        const afternoonStart = row.querySelector('.afternoon-start').value;
			
			        if (row.dataset.afternoonVisible === '1' && morningEnd && afternoonStart) {
			            if (afternoonStart <= morningEnd) {
			                hasError = true;
			                row.querySelector('.morning-end').closest('.tw').classList.add('is-invalid');
		row.querySelector('.afternoon-start').closest('.tw').classList.add('is-invalid');
			            } else {
			                row.querySelector('.morning-end').closest('.tw').classList.remove('is-invalid');
		row.querySelector('.afternoon-start').closest('.tw').classList.remove('is-invalid');
			            }
			        }
			    });
			
			    if (hasError) {
			        alert('Les plages horaires se chevauchent. L\'heure de début de l\'après-midi doit être après la fin du matin.');
			        return;
			    }
			
			    fetch(window.location.href, {
			        method:  'POST',
			        body:    new FormData(formEl),
			        headers: { 'X-Requested-With': 'XMLHttpRequest' }
			    })
			    .then(res => res.json())
			    .then(data => {
			        if (data.success) {
			            formView.style.display     = 'none';
			            calendarView.style.display = 'block';
			            calendar.refetchEvents();
			        }
			    })
			    .catch(() => alert('Une erreur est survenue.'));
			});
																
																    if (window.lucide) lucide.createIcons();
																});
																											</script>
{% endblock %}
