{% extends 'base.html.twig' %}

{% block body %}
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Mes disponibilités</h1>
    <a class="btn btn-primary" href="{{ path('app_availability_horaire_new') }}">Ajouter un créneau</a>
  </div>

  {% for day in daysOfWork %}
    <div class="card mb-3">
      <div class="card-body">
        <div class="fw-bold mb-2">Jour : {{ day.jour.libelle }}</div>

        {% if day.horaires|length == 0 %}
          <div class="text-muted">Aucun créneau</div>
        {% else %}
          <ul class="mb-0">
            {% for h in day.horaires %}
              <li>{{ h.startTime|date('H:i') }} - {{ h.endTime|date('H:i') }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
{% endblock %}
