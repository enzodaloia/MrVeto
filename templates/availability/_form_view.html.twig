<div id="form-view" style="display:none;">
	<div class="d-flex flex-column flex-xl-row justify-content-between align-items-stretch align-items-xl-start gap-3 mb-4 mx-auto w-100" style="max-width:1106px;">
		<div class="flex-grow-1">
			<h2 class="h3 fw-bold text-primary mb-1">Gestion des disponibilités</h2>
			<p class="text-muted mb-0">Configurez vos horaires hebdomadaires et vos plages de consultation.</p>
		</div>

		<div class="d-grid d-sm-flex gap-2 align-items-stretch flex-shrink-0">
			<button type="submit" form="disponibilite-form" class="btn btn-primary text-white rounded-4 px-4 fw-semibold" aria-label="Enregistrer les disponibilités">
				<i class="bi bi-save me-2" aria-hidden="true"></i>Enregistrer
			</button>

			<div class="dropdown">
				<button type="button" class="btn btn-light border rounded-4 px-3 text-primary w-100 h-100" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Afficher les actions secondaires">
					<i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
				</button>
				<ul class="dropdown-menu dropdown-menu-end shadow-sm">
					<li>
						<button type="button" id="btn-apply-week-menu" class="dropdown-item">
							Appliquer lundi à tous les jours
						</button>
					</li>
					<li>
						<button type="button" id="btn-close-all" class="dropdown-item text-danger">
							Fermer tous les jours
						</button>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<div class="rounded-4 mx-auto w-100 overflow-hidden" style="max-width:1106px;">
		{{ form_start(form, { attr: { novalidate: 'novalidate', id: 'disponibilite-form' } }) }}

		<div class="table-responsive">
			<table class="table align-middle availability-table mb-0" style="--bs-table-bg: transparent;">
				<thead class="border-bottom">
					<tr class="text-uppercase small text-muted text-neutral-80">
						<th class="fw-semibold ps-4 py-3 text-nowrap" style="width:240px;">Jour de la semaine</th>
						<th class="fw-semibold py-3" style="width:200px;">Statut</th>
						<th class="fw-semibold py-3">Plages horaires</th>
						<th class="fw-semibold py-3 pe-4 text-center" style="width:72px;">Actions</th>
					</tr>
				</thead>

				<tbody>
					{% for horaire in form.horaires %}
						{% include 'availability/_day_row.html.twig' with { horaire: horaire } %}
					{% endfor %}
				</tbody>
			</table>
		</div>

		{{ form_end(form) }}
	</div>

	<div class="mx-auto w-100" style="max-width:1106px; margin-top:1.5rem;">
		<div class="rounded-3 p-3 p-md-4 note-importante-box">
			<p class="fw-bold text-info mb-2">
				<i class="bi bi-info-circle me-1" aria-hidden="true"></i>
				Note importante
			</p>
			<p class="mb-0 text-muted">
				Définissez ici vos disponibilités habituelles pour les prises de rendez-vous en ligne.
					Les modifications sont prises en compte immédiatement sur votre planning.
			</p>
		</div>
	</div>

	<div class="d-grid d-md-flex justify-content-md-end gap-2 gap-md-3 mt-4 pb-4 mx-auto w-100" style="max-width:1106px;">
		<button type="button" id="btn-back-calendar" class="btn bg-light text-neutral-60 rounded-4 px-4 px-md-5 fw-semibold" aria-controls="calendar-view" aria-label="Revenir à la vue calendrier">
			ANNULER
		</button>

		<button type="submit" form="disponibilite-form" class="btn btn-primary text-white rounded-4 px-4 px-md-5 fw-semibold" aria-label="Enregistrer mes disponibilités">
			Enregistrer mes disponibilités
		</button>
	</div>
</div>
